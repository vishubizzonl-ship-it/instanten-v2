{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Sirf contact API — Pages static site ke saath. Deploy:
  //   npx wrangler deploy --config wrangler.api.jsonc
  "name": "instanten-api",
  "main": "worker/api.mjs",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "send_email": [
    {
      "name": "EMAIL",
      // Free plan par sirf VERIFIED destination par bhej sakte hain.
      "destination_address": "vishubizz.onl@gmail.com",
      "allowed_destination_addresses": [
        "vishubizz.onl@gmail.com",
        "helloinstanten@gmail.com"
      ],
      // Sender site ke apne domain par — hello@instanten.com Email Routing par
      // onboarded hona chahiye, warna E_SENDER_NOT_VERIFIED.
      "allowed_sender_addresses": [
        "hello@instanten.com",
        "contact@instanten.com",
        "noreply@instanten.com"
      ]
    }
  ],
  "vars": {
    "CONTACT_TO": "vishubizz.onl@gmail.com",
    "CONTACT_FROM": "hello@instanten.com",
    "CONTACT_SITE": "instanten.com"
  }
}

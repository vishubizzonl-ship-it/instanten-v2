{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instanten",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "send_email": [
    {
      "name": "EMAIL",
      // Receiving mailbox — free plan par sirf VERIFIED destination par bhej
      // sakte hain. Dono Gmail verify ho to dono allowed hain (max 50 free).
      "destination_address": "helloinstanten@gmail.com",
      "allowed_destination_addresses": [
        "helloinstanten@gmail.com",
        "vishubizz.onl@gmail.com"
      ],
      "allowed_sender_addresses": ["contact@instanten.com", "noreply@instanten.com"]
    }
  ],
  "vars": {
    "CONTACT_TO": "helloinstanten@gmail.com",
    "CONTACT_FROM": "contact@instanten.com",
    "CONTACT_SITE": "instanten.com"
  }
}

---
import '../styles/app.css';
import '../styles/subpages.css';
import '../styles/responsive.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchPanel from '../components/SearchPanel.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import SeoHead, { type FaqItem, type BreadcrumbItem } from '../components/SeoHead.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
  keywords?: string;
  includeAppSchema?: boolean;
  faqs?: FaqItem[];
  breadcrumbs?: BreadcrumbItem[];
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  tags?: string[];
}

const {
  title = 'Instanten — Free Instant Online Tools, Instant Convert & Instant Help',
  description = 'Instanten offers free instant online tools, fast instant convert utilities, step-by-step guides, and instant help directly in your browser with zero sign-up.',
  canonicalURL,
  ogImage = '/og-instanten.svg',
  ogType = 'website',
  jsonLd,
  noindex = false,
  keywords = 'instanten, Instanten tool, Instanten tools, Instant help, Instant tool, Instant tools, Instant online, Instant convert',
  includeAppSchema = false,
  faqs = [],
  breadcrumbs = [],
  publishedTime,
  modifiedTime,
  section,
  tags = [],
} = Astro.props;

---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <script is:inline src="/theme-bridge.js"></script>
    <SeoHead
      title={title}
      description={description}
      keywords={keywords}
      canonicalPath={Astro.url.pathname}
      ogType={ogType}
      ogImage={ogImage || '/og-instanten.svg'}
      ogImageAlt={title}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      section={section}
      tags={tags}
      noindex={noindex}
      includeAppSchema={includeAppSchema}
      faqs={faqs}
      breadcrumbs={breadcrumbs}
      extraSchemas={jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []}
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@900&family=Montserrat:ital,wght@1,900&display=swap"
      rel="stylesheet"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved === 'dark' || saved === 'light' ? saved : (prefersDark ? 'dark' : 'light');

        const applyTheme = (mode) => {
          const isDark = mode === 'dark';
          document.documentElement.classList.toggle('dark', isDark);
          document.documentElement.setAttribute('data-theme', mode);
          document.documentElement.setAttribute('data-scheme', mode);
          if (document.body) {
            document.body.classList.toggle('dark', isDark);
            document.body.setAttribute('data-theme', mode);
            document.body.setAttribute('data-scheme', mode);
          }
        };

        applyTheme(theme);
        document.addEventListener('DOMContentLoaded', () => applyTheme(localStorage.getItem('theme') || theme));
        document.addEventListener('astro:after-swap', () => applyTheme(localStorage.getItem('theme') || 'light'));
      })();
    </script>

    <style is:global>
      /* LIGHT MODE DEFAULT — Har Jagah Logo Pure Black (#000000) */
      [data-site-logo],
      [data-site-logo] *,
      .site-brand-logo,
      .site-brand-logo * {
        color: #000000 !important;
        transition: color 0.2s ease, filter 0.2s ease, fill 0.2s ease !important;
      }

      [data-site-logo] svg,
      [data-site-logo] svg [fill]:not([fill="none"]),
      .site-brand-logo svg,
      .site-brand-logo svg [fill]:not([fill="none"]) {
        fill: #000000 !important;
      }

      [data-site-logo] img:not(.logo-dark),
      .site-brand-logo img:not(.logo-dark) {
        filter: brightness(0) !important;
        transition: filter 0.2s ease !important;
      }

      /* DARK MODE STATE — Har Jagah Logo 100% Pure Crisp White (#FFFFFF) */
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) [data-site-logo],
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) [data-site-logo] *,
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) .site-brand-logo,
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) .site-brand-logo * {
        color: #FFFFFF !important;
        -webkit-text-fill-color: #FFFFFF !important;
      }

      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) [data-site-logo] svg,
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) [data-site-logo] svg [fill]:not([fill="none"]),
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) .site-brand-logo svg,
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) .site-brand-logo svg [fill]:not([fill="none"]) {
        fill: #FFFFFF !important;
      }

      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) [data-site-logo] svg [stroke]:not([stroke="none"]),
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) .site-brand-logo svg [stroke]:not([stroke="none"]) {
        stroke: #FFFFFF !important;
      }

      /* Black PNG / WebP / SVG <img> file ko har jagah 100% Pure Crisp White (#FFFFFF) banata hai */
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) [data-site-logo] img:not(.logo-dark),
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) .site-brand-logo img:not(.logo-dark) {
        filter: brightness(0) invert(1) !important;
      }
    </style>

    <script is:inline>
      (function () {
        function syncAllSiteLogos() {
          var html = document.documentElement;
          var body = document.body;
          var isDark =
            html.classList.contains('dark') ||
            (body && body.classList.contains('dark')) ||
            html.getAttribute('data-theme') === 'dark' ||
            html.getAttribute('data-scheme') === 'dark' ||
            (body && body.getAttribute('data-theme') === 'dark') ||
            (body && body.getAttribute('data-scheme') === 'dark');

          var targetColor = isDark ? '#FFFFFF' : '#000000';
          var selector = [
            '[data-site-logo]',
            '.site-brand-logo',
            'header a[href="/"]',
            'footer a[href="/"]',
            '[class*="drawer"] a[href="/"]',
            '[class*="offcanvas"] a[href="/"]',
            '[class*="logo"]'
          ].join(', ');

          document.querySelectorAll(selector).forEach(function (rootEl) {
            var allNodes = [rootEl].concat(Array.from(rootEl.querySelectorAll('*')));
            allNodes.forEach(function (node) {
              var tag = node.tagName ? node.tagName.toUpperCase() : '';
              if (tag === 'IMG') {
                if (!node.classList.contains('logo-dark') && !node.classList.contains('logo-light')) {
                  node.style.setProperty('filter', isDark ? 'brightness(0) invert(1)' : 'brightness(0)', 'important');
                }
              } else if (tag === 'SVG' || node.ownerSVGElement) {
                node.style.setProperty('color', targetColor, 'important');
                if (node.getAttribute('fill') !== 'none') {
                  node.style.setProperty('fill', targetColor, 'important');
                }
              } else {
                node.style.setProperty('color', targetColor, 'important');
                node.style.setProperty('-webkit-text-fill-color', targetColor, 'important');
              }
            });
          });
        }

        syncAllSiteLogos();
        document.addEventListener('DOMContentLoaded', syncAllSiteLogos);
        document.addEventListener('astro:after-swap', syncAllSiteLogos);
        document.addEventListener('astro:page-load', syncAllSiteLogos);

        var obs = new MutationObserver(syncAllSiteLogos);
        obs.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class', 'data-theme', 'data-scheme']
        });
        document.addEventListener('DOMContentLoaded', function () {
          if (document.body) {
            obs.observe(document.body, {
              attributes: true,
              attributeFilter: ['class', 'data-theme', 'data-scheme']
            });
          }
        });
      })();
    </script>

  </head>
  <body class="min-h-screen bg-canvas font-body text-ink antialiased">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <MobileDrawer />
    <SearchPanel />
    <main class="w-full flex-1" id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ScrollToTop />
  </body>
</html>

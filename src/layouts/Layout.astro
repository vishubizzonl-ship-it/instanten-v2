---
import '../styles/app.css';
import '../styles/subpages.css';
import '../styles/responsive.css';
import Header from '../components/Header.astro';
import InstrumentNav from '../components/instruments/InstrumentNav.astro';
import { isInstrument } from '../utils/toolPaths';
import Footer from '../components/Footer.astro';
import SearchPanel from '../components/SearchPanel.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { GA_MEASUREMENT_ID, analyticsEnabled } from '../config/analytics';
import SeoHead, { type FaqItem, type BreadcrumbItem } from '../components/SeoHead.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { LangCode } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
  keywords?: string;
  includeAppSchema?: boolean;
  faqs?: FaqItem[];
  breadcrumbs?: BreadcrumbItem[];
  publishedTime?: string;
  modifiedTime?: string;
  authorName?: string;
  authorUrl?: string;
  ogImageAlt?: string;
  section?: string;
  tags?: string[];
  lang?: string;
  /**
   * 'site' (default) = instanten ka header.
   * 'instrument' = chaar sensor tools ke pages par compassinstant wala header
   * (logo online<tool>, language pill, dark toggle, tool pills) — wahi jo tool
   * page ka screenshot dikhata hai. Footer dono par ek hi rehta hai.
   */
  chrome?: 'site' | 'instrument';
}

const {
  title = 'Instanten — Free Online Tools Hub for Instant Work & Instant Tools',
  description = 'Instanten is a free online tools hub with 12 instant tools for instant work — no sign-up and nothing uploaded.',
  canonicalURL,
  ogImage = '/og-instanten.png',
  ogImageAlt,
  ogType = 'website',
  jsonLd,
  noindex = false,
  keywords = 'instanten, instant tool, tools hub, instant work, online tools, online tools hub, multi tool website, multi tools website, instant, free online tools website, online tools free, free online tools, web tools hub, free online tools hub, online tools list',
  includeAppSchema = false,
  faqs = [],
  breadcrumbs = [],
  publishedTime,
  modifiedTime,
  authorName,
  authorUrl,
  section,
  tags = [],
  lang,
  chrome = 'site',
} = Astro.props;

/**
 * chrome="instrument" ke liye: is page ka tool slug (`/onlineqibla/` aur
 * `/de/onlineqibla/` dono → onlineqibla), taaki header ka logo, pills aur
 * language switch usi tool ke rahen. Sensor tools root par hain.
 */
const LOCALE_SEGMENTS = ['de', 'ja', 'fr', 'es', 'ko', 'nl', 'sv', 'it', 'pt'];
const urlSegments = Astro.url.pathname.split('/').filter(Boolean);
const pathAfterLocale = LOCALE_SEGMENTS.includes(urlSegments[0] ?? '') ? urlSegments.slice(1) : urlSegments;
const instrumentSlug = isInstrument(pathAfterLocale[0] ?? '') ? pathAfterLocale[0] : 'onlinecompass';

const detectedLang: LangCode = lang ? (lang as LangCode) : getLangFromUrl(Astro.url);
const t = useTranslations(detectedLang);

/**
 * GA4 content_group — ek hi shared measurement ID, lekin har tool apni report.
 *
 *   /tools/json-formatter/      → json-formatter
 *   /de/tools/word-counter/     → word-counter   (locale prefix strip)
 *   /tools/                     → tools-hub
 *   /blog/…, /category/…, …     → blog
 *   /                           → home
 *   baaki sab                   → site
 *
 * Error pages (403/404/500/503) par analytics load hi nahi hota — unka
 * traffic report ko ganda karta hai aur wo noindex hain.
 */
const LOCALE_PREFIXES = ['de', 'ja', 'fr', 'es', 'ko', 'nl', 'sv', 'it', 'pt'];
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const cleanSegments =
  pathSegments.length > 0 && LOCALE_PREFIXES.includes(pathSegments[0]) ? pathSegments.slice(1) : pathSegments;
const cleanPath = `/${cleanSegments.join('/')}`;

const gaContentGroup = (() => {
  // Sensor tools root par: /onlineqibla/ → onlineqibla (per-tool report)
  if (isInstrument(cleanSegments[0] ?? '')) return cleanSegments[0];
  if (cleanSegments[0] === 'tools' && cleanSegments[1]) return cleanSegments[1];
  if (cleanSegments[0] === 'tools') return 'tools-hub';
  if (['blog', 'category', 'tag', 'tags', 'page'].includes(cleanSegments[0])) return 'blog';
  if (cleanSegments[0] === 'about' || cleanSegments[0] === 'contact') return 'company';
  if (cleanSegments[0] === 'privacy-policy' || cleanSegments[0] === 'terms') return 'legal';
  return cleanSegments.length === 0 ? 'home' : 'site';
})();

// Error pages + build ke waqt ID na ho to tag bilkul nahi.
const errorPage = /^\/(403|404|500|503)(\.html)?$/.test(cleanPath);
const loadAnalytics = analyticsEnabled && !noindex && !errorPage;

// GA4 bootstrap — values build ke waqt bake hoti hain (define:vars is:inline ke
// saath inline nahi hota, isliye string khud banate hain).
const gaInlineScript = `window.dataLayer = window.dataLayer || [];
function gtag() { window.dataLayer.push(arguments); }
gtag('js', new Date());
gtag('config', ${JSON.stringify(GA_MEASUREMENT_ID)}, {
  anonymize_ip: true,
  allow_google_signals: false,
  allow_ad_personalization_signals: false,
  content_group: ${JSON.stringify(gaContentGroup)}
});`;

---
<!doctype html>
<html lang={detectedLang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <script is:inline src="/theme-bridge.js"></script>
    <SeoHead
      title={title}
      description={description}
      keywords={keywords}
      {/* Error pages (noindex) apna canonical khud dete hain — /404.html — kyunki
          wo root par flat file hain. Baaki pages current URL hi rakhte hain. */}
      canonicalPath={noindex && canonicalURL ? new URL(canonicalURL).pathname : Astro.url.pathname}
      lang={detectedLang}
      ogType={ogType}
      ogImage={ogImage || '/og-instanten.png'}
      ogImageAlt={ogImageAlt || title}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      authorName={authorName}
      authorUrl={authorUrl}
      section={section}
      tags={tags}
      noindex={noindex}
      includeAppSchema={includeAppSchema}
      faqs={faqs}
      breadcrumbs={breadcrumbs}
      extraSchemas={jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []}
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@900&family=Montserrat:ital,wght@1,900&display=swap"
      rel="stylesheet"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved === 'dark' || saved === 'light' ? saved : (prefersDark ? 'dark' : 'light');

        const applyTheme = (mode) => {
          const isDark = mode === 'dark';
          document.documentElement.classList.toggle('dark', isDark);
          document.documentElement.setAttribute('data-theme', mode);
          document.documentElement.setAttribute('data-scheme', mode);
          if (document.body) {
            document.body.classList.toggle('dark', isDark);
            document.body.setAttribute('data-theme', mode);
            document.body.setAttribute('data-scheme', mode);
          }
        };

        applyTheme(theme);
        document.addEventListener('DOMContentLoaded', () => applyTheme(localStorage.getItem('theme') || theme));
        document.addEventListener('astro:after-swap', () => applyTheme(localStorage.getItem('theme') || 'light'));
      })();
    </script>

    <style is:global>
      /* LIGHT MODE DEFAULT — Har Jagah Logo Pure Black (#000000) */
      [data-site-logo],
      [data-site-logo] *,
      .site-brand-logo,
      .site-brand-logo * {
        color: #000000 !important;
        transition: color 0.2s ease, filter 0.2s ease, fill 0.2s ease !important;
      }

      [data-site-logo] svg,
      [data-site-logo] svg [fill]:not([fill="none"]),
      .site-brand-logo svg,
      .site-brand-logo svg [fill]:not([fill="none"]) {
        fill: #000000 !important;
      }

      [data-site-logo] img:not(.logo-dark),
      .site-brand-logo img:not(.logo-dark) {
        filter: brightness(0) !important;
        transition: filter 0.2s ease !important;
      }

      /* DARK MODE STATE — Har Jagah Logo 100% Pure Crisp White (#FFFFFF) */
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) [data-site-logo],
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) [data-site-logo] *,
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) .site-brand-logo,
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) .site-brand-logo * {
        color: #FFFFFF !important;
        -webkit-text-fill-color: #FFFFFF !important;
      }

      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) [data-site-logo] svg,
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) [data-site-logo] svg [fill]:not([fill="none"]),
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) .site-brand-logo svg,
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) .site-brand-logo svg [fill]:not([fill="none"]) {
        fill: #FFFFFF !important;
      }

      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) [data-site-logo] svg [stroke]:not([stroke="none"]),
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) .site-brand-logo svg [stroke]:not([stroke="none"]) {
        stroke: #FFFFFF !important;
      }

      /* Black PNG / WebP / SVG <img> file ko har jagah 100% Pure Crisp White (#FFFFFF) banata hai */
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) [data-site-logo] img:not(.logo-dark),
      :is(html.dark, body.dark, [data-theme="dark"], [data-scheme="dark"]) .site-brand-logo img:not(.logo-dark) {
        filter: brightness(0) invert(1) !important;
      }
    </style>

    <script is:inline>
      (function () {
        function syncAllSiteLogos() {
          var html = document.documentElement;
          var body = document.body;
          var isDark =
            html.classList.contains('dark') ||
            (body && body.classList.contains('dark')) ||
            html.getAttribute('data-theme') === 'dark' ||
            html.getAttribute('data-scheme') === 'dark' ||
            (body && body.getAttribute('data-theme') === 'dark') ||
            (body && body.getAttribute('data-scheme') === 'dark');

          var targetColor = isDark ? '#FFFFFF' : '#000000';
          var selector = [
            '[data-site-logo]',
            '.site-brand-logo',
            'header a[href="/"]',
            'footer a[href="/"]',
            '[class*="drawer"] a[href="/"]',
            '[class*="offcanvas"] a[href="/"]',
            '[class*="logo"]'
          ].join(', ');

          document.querySelectorAll(selector).forEach(function (rootEl) {
            var allNodes = [rootEl].concat(Array.from(rootEl.querySelectorAll('*')));
            allNodes.forEach(function (node) {
              var tag = node.tagName ? node.tagName.toUpperCase() : '';
              if (tag === 'IMG') {
                if (!node.classList.contains('logo-dark') && !node.classList.contains('logo-light')) {
                  node.style.setProperty('filter', isDark ? 'brightness(0) invert(1)' : 'brightness(0)', 'important');
                }
              } else if (tag === 'SVG' || node.ownerSVGElement) {
                node.style.setProperty('color', targetColor, 'important');
                if (node.getAttribute('fill') !== 'none') {
                  node.style.setProperty('fill', targetColor, 'important');
                }
              } else {
                node.style.setProperty('color', targetColor, 'important');
                node.style.setProperty('-webkit-text-fill-color', targetColor, 'important');
              }
            });
          });
        }

        syncAllSiteLogos();
        document.addEventListener('DOMContentLoaded', syncAllSiteLogos);
        document.addEventListener('astro:after-swap', syncAllSiteLogos);
        document.addEventListener('astro:page-load', syncAllSiteLogos);

        var obs = new MutationObserver(syncAllSiteLogos);
        obs.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class', 'data-theme', 'data-scheme']
        });
        document.addEventListener('DOMContentLoaded', function () {
          if (document.body) {
            obs.observe(document.body, {
              attributes: true,
              attributeFilter: ['class', 'data-theme', 'data-scheme']
            });
          }
        });
      })();
    </script>

    {
      /* GA4 — ek shared measurement ID, content_group se per-tool reporting.
         allow_google_signals:false => advertising personalisation off. */
      loadAnalytics && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
          />
          <script is:inline set:html={gaInlineScript} />
        </>
      )
    }
  </head>
  <body class="min-h-screen bg-canvas font-body text-ink antialiased">
    <a href="#main-content" class="skip-link">{t('skip.link')}</a>
    {
      chrome === 'instrument' ? (
        <InstrumentNav slug={instrumentSlug} />
      ) : (
        <>
          <Header />
          <MobileDrawer />
          <SearchPanel />
        </>
      )
    }
    <main class="w-full flex-1" id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ScrollToTop />
  </body>
</html>

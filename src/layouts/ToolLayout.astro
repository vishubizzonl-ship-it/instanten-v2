---
import Layout from './Layout.astro';
import ToolSubnav from '../components/tool/ToolSubnav.astro';
import { SITE, toolBySlug } from '../data/tools';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  keywords?: string;
  tool: string;
  canonicalPath: string;
  crumbs?: Crumb[];
  faqs?: { q: string; a: string }[];
  jsonLd?: object[];
  ogType?: 'website' | 'article';
}

const { title, description, keywords, tool, canonicalPath, crumbs = [], faqs = [], jsonLd = [], ogType = 'website' } = Astro.props;
const current = toolBySlug(tool);
const url = SITE.url + canonicalPath;

const breadcrumbs = [
  { name: SITE.name, item: '/' },
  { name: current?.name ?? tool, item: `/${tool}/` },
  ...crumbs.map((c) => ({ name: c.label, item: c.href ?? '' })),
].filter((b) => b.item) as { name: string; item: string }[];

const schemas: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: b.item.startsWith('http') ? b.item : SITE.url + b.item,
    })),
  },
  ...(current
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'SoftwareApplication',
          name: current.name,
          applicationCategory: 'UtilitiesApplication',
          operatingSystem: 'Any',
          url: `${SITE.url}/${current.slug}/`,
          description: current.seoDescription,
          offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        },
      ]
    : []),
  ...jsonLd,
];
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonicalURL={url}
  ogType={ogType}
  breadcrumbs={breadcrumbs}
  faqs={faqs.map((f) => ({ question: f.q, answer: f.a }))}
  jsonLd={schemas}
>
  <ToolSubnav tool={tool} />

  {
    crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="site-container max-w-[64rem] pt-6">
        <ol class="flex flex-wrap items-center gap-1.5 text-caption text-muted">
          <li><a href="/" class="hover:text-ink">{SITE.name}</a></li>
          <li class="flex items-center gap-1.5">
            <span aria-hidden="true">›</span>
            <a href={`/${tool}/`} class="hover:text-ink">{current?.name ?? tool}</a>
          </li>
          {crumbs.map((c) => (
            <li class="flex items-center gap-1.5">
              <span aria-hidden="true">›</span>
              {c.href ? <a href={c.href} class="hover:text-ink">{c.label}</a> : <span class="text-body">{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  <slot />
</Layout>

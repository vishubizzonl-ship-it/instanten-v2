---
/**
 * onlinespeedometer — 404 (Page not found).
 * URL: /onlinespeedometer/404.html  (build ke baad flat .html, dekho astro.config ka
 * 'per-tool-error-pages' hook)
 * noindex/nofollow, kisi sitemap mein nahi, aur usi tool ka chrome.
 */
import ToolErrorPage from '../../components/pages/ToolErrorPage.astro';
---

<ToolErrorPage
  slug="onlinespeedometer"
  code={404}
  heading='Page not found'
  message='This page is not part of the speedometer site. The link may be old, or the address may have a typo. The speedometer is one tap away.'
  tips={['Compare the address with the links on the tool page.', 'Open the speedometer and start again from there.', 'Old links to removed pages can be recovered from the tool or its guides.']}
/>

---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Island from '../../components/tool/CompassIsland.astro';
import Faq from '../../components/tool/Faq.astro';
import { toolBySlug } from '../../data/tools';

const tool = toolBySlug('compass')!;
const canonicalPath = '/compass/';
const faqs = tool.faqs.map((f) => ({ q: f.q, a: f.a }));

const jsonLd: object[] = [];
---

<ToolLayout
  title={tool.seoTitle}
  description={tool.seoDescription}
  keywords={tool.keywords}
  tool="compass"
  canonicalPath={canonicalPath}
  faqs={faqs}
  jsonLd={jsonLd}
>
  <section class="pb-4 pt-8">
    <div class="site-container max-w-5xl">
      <h1 class="font-display text-heading-lg font-semibold tracking-[-0.025em] text-ink">{tool.name}</h1>
      <p class="mt-3 max-w-[64ch] text-body-md leading-relaxed text-body">{tool.intro}</p>
    </div>
  </section>

  <section class="pb-10" aria-label={`${tool.name} tool`}>
    <div class="site-container max-w-5xl">
      <Island />
    </div>
  </section>

  <section class="pb-12" aria-label="Features">
    <div class="site-container max-w-[64rem]">
      <h2 class="font-display text-heading-md text-ink">What it does</h2>
      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        {tool.features.map((f) => (
          <article class="rounded-xl border border-border-hairline bg-canvas p-5">
            <h3 class="text-body-md font-semibold text-ink">{f.title}</h3>
            <p class="mt-1.5 text-body-sm leading-relaxed text-body">{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-12" aria-label="How to use">
    <div class="site-container max-w-[64rem]">
      <h2 class="font-display text-heading-md text-ink">How to use the {tool.name.toLowerCase()}</h2>
      <div class="mt-5 space-y-6">
        {tool.howTo.map((step) => (
          <article class="border-l-2 border-border-hairline pl-5">
            <h3 class="text-body-md font-semibold text-ink">{step.title}</h3>
            <p class="mt-1.5 text-body-sm leading-relaxed text-body">{step.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-12" aria-label="Device support">
    <div class="site-container max-w-[64rem]">
      <h2 class="font-display text-heading-md text-ink">Device support</h2>
      <div class="mt-5 overflow-x-auto">
        <table class="w-full border-collapse text-body-sm">
          <thead>
            <tr>
              <th class="border-b border-border-hairline bg-surface-soft px-3 py-2 text-left font-semibold text-ink">Device</th>
              <th class="border-b border-border-hairline bg-surface-soft px-3 py-2 text-left font-semibold text-ink">Works?</th>
            </tr>
          </thead>
          <tbody>
            {tool.deviceSupport.map((row) => (
              <tr>
                <td class="border-b border-border-hairline px-3 py-2 text-body">{row.device}</td>
                <td class="border-b border-border-hairline px-3 py-2 text-body">{row.works}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <Faq faqs={tool.faqs} accent={tool.accent} title={`${tool.name} — questions and answers`} />

  <section class="pb-20">
    <div class="site-container max-w-[64rem]">
      <div class="rounded-2xl border border-border-hairline bg-surface-soft p-6">
        <p class="text-body-md font-semibold text-ink">More from the {tool.name}</p>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-body-sm">
          <li><a href={`/compass/blog/`} class="text-body hover:text-ink">Guides</a></li>
          <li><a href="/compass/about/" class="text-body hover:text-ink">About this tool</a></li>
          <li><a href="/compass/contact/" class="text-body hover:text-ink">Contact</a></li>
          <li><a href="/compass/privacy/" class="text-body hover:text-ink">Privacy</a></li>
          <li><a href="/compass/terms/" class="text-body hover:text-ink">Terms</a></li>
        </ul>
      </div>
    </div>
  </section>
</ToolLayout>

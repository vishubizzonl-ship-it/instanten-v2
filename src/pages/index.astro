---
import Layout from '../layouts/Layout.astro';
import { toolPath } from '../utils/toolPaths';
import EditorialHero from '../components/EditorialHero.astro';
import LibraryFilterBar from '../components/LibraryFilterBar.astro';
import BlogPagination from '../components/BlogPagination.astro';
import HomeSeoSection, { getHomeFaqs } from '../components/HomeSeoSection.astro';
import { defaultLang } from '../i18n/ui';
import { localizePricing } from '../i18n/toolContent';
import { getAllTools } from '../utils/standaloneTools';
import { parseFilters, filterTools, sortTools, paginateTools, toolHref, type ToolData } from '../utils/filters';

const allTools = await getAllTools();

const searchParams = new URLSearchParams(Astro.url.search);
const filters = parseFilters(searchParams);

const filteredTools = filterTools(allTools, filters);
const sortedTools = sortTools(filteredTools, filters.sort || 'featured');

// Grid cards ke upar filter section hai, aur filtering saare cards par chalti
// hai — isliye poori list ek hi page par aati hai (16 tools). `?page=2` par
// static build wahi page-1 deta hai, to pagination se tools chhup jaate the.
const PER_PAGE = 50;
const totalPages = Math.ceil(sortedTools.length / PER_PAGE);
const currentPage = filters.page || 1;
const paginatedTools = paginateTools(sortedTools, currentPage, PER_PAGE);

const toolData: ToolData[] = paginatedTools.map((tool) => ({
  slug: tool.data.slug,
  name: tool.data.name,
  category: tool.data.category,
  description: tool.data.description,
  pricing: tool.data.pricing,
  image: tool.data.image,
  url: tool.data.url,
  tags: tool.data.tags,
  maker: tool.data.maker,
  addedDate: tool.data.addedDate,
  updatedDate: tool.data.updatedDate,
  featured: tool.data.featured,
}));

const queryParams: Record<string, string> = {};
if (filters.category) queryParams.category = filters.category;
if (filters.pricing) queryParams.pricing = filters.pricing;
if (filters.tags?.length) queryParams.tags = filters.tags.join(',');
if (filters.sort && filters.sort !== 'featured') queryParams.sort = filters.sort;

// On-page SEO: main keyword "instanten" + supporting set
// (instant tool, tools hub, instant work, online tools, online tools hub,
//  multi tool website, instant, free online tools website, free online tools,
//  web tools hub, free online tools hub, online tools list)
const pageTitle = currentPage === 1
  ? 'Instanten — Free Online Tools Hub for Instant Work & Instant Tools'
  : `Instanten — Page ${currentPage} of ${totalPages} — Free Online Tools Hub for Instant Work`;
const pageDescription =
  'Instanten is a free online tools hub with 12 instant tools for instant work — formatter, word counter, QR and password tools. No sign-up, nothing uploaded.';
const pageKeywords =
  'instanten, instant tool, tools hub, instant work, online tools, online tools hub, multi tool website, multi tools website, instant, free online tools website, free online tools, online tools free, web tools hub, free online tools hub, online tools list';

const canonicalURL = currentPage === 1
  ? 'https://instanten.com/'
  : `https://instanten.com/page/${currentPage}/`;
---
<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
  ogImage="/og-instanten.png"
  keywords={pageKeywords}
  includeAppSchema={true}
  faqs={getHomeFaqs(defaultLang)}
  breadcrumbs={currentPage === 1 ? [{ name: 'Home', item: '/' }] : [{ name: 'Home', item: '/' }, { name: 'Page ' + currentPage, item: '/page/' + currentPage }]}
>
  <EditorialHero />

  <section class="site-container pb-6" aria-label="Tool directory filter">
    <!-- Grid cards ke just upar: search + category group + chips + Filters + sort -->
    <LibraryFilterBar
      tools={toolData}
      baseUrl="/"
      currentCategory={filters.category}
      currentPricing={filters.pricing}
      currentTags={filters.tags}
      currentSort={filters.sort}
      query={filters.q}
      showCardSize={false}
    />
  </section>

  <section class="site-container pb-[64px] flex-1 lg:mb-[80px] md:mb-[48px] mb-[48px] flex flex-col items-center" aria-label="Tool directory">
    <div class="blog-grid" data-cards-grid data-lib-grid data-lib-fixed-grid role="list" aria-label="Featured tools">
      {toolData.map((tool) => (
        <article
          class="blog-card"
          data-tool-card
          data-slug={tool.slug}
          data-name={tool.name}
          data-category={tool.category}
          data-pricing={tool.pricing}
          data-tags={(tool.tags ?? []).join(',')}
          data-added={tool.addedDate ?? ''}
          data-updated={tool.updatedDate ?? tool.addedDate ?? ''}
          data-featured={tool.featured ? 'true' : 'false'}
          data-search={[tool.name, tool.category, tool.description, ...(tool.tags ?? [])].join(' ')}
        >
          <a href={toolPath(tool.slug)} class="blog-card__thumbnail" aria-label={`View details for ${tool.name}`}>
            <img
              src={tool.image}
              alt={`${tool.name} preview`}
              loading="lazy"
              decoding="async"
              width="400"
              height="225"
            />
            <span class="blog-card__category-pill">{tool.category}</span>
            <span class="blog-card__meta-chip">{localizePricing(defaultLang, tool.pricing)}</span>
          </a>

          <div class="blog-card__body">
            <h2 class="blog-card__title">
              <a href={toolPath(tool.slug)} class="transition-colors hover:text-accent-deep">{tool.name}</a>
            </h2>

            <p class="blog-card__excerpt">{tool.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <BlogPagination currentPage={currentPage} totalPages={totalPages} basePath="" />

  <HomeSeoSection />
</Layout>
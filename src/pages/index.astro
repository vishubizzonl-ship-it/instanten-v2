---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ToolGrid from '../components/ToolGrid.astro';
import Pagination from '../components/Pagination.astro';
import { getCollection } from 'astro:content';
import { parseFilters, filterTools, sortTools, paginateTools, getTotalPages, uniqueCategories, type ToolData } from '../utils/filters';

const allTools = await getCollection('tools');

const searchParams = new URLSearchParams(Astro.url.search);
const filters = parseFilters(searchParams);

const filteredTools = filterTools(allTools, filters);
const sortedTools = sortTools(filteredTools, filters.sort || 'featured');

const PER_PAGE = 10;
const totalPages = getTotalPages(sortedTools.length, PER_PAGE);
const currentPage = filters.page || 1;
const paginatedTools = paginateTools(sortedTools, currentPage, PER_PAGE);

const allCategories = uniqueCategories(allTools);

const toolData: ToolData[] = paginatedTools.map((tool) => ({
  slug: tool.data.slug,
  name: tool.data.name,
  category: tool.data.category,
  description: tool.data.description,
  pricing: tool.data.pricing,
  image: tool.data.image,
  url: tool.data.url,
  tags: tool.data.tags,
  maker: tool.data.maker,
  addedDate: tool.data.addedDate,
  featured: tool.data.featured,
}));

const baseUrl = '/';
const queryParams: Record<string, string> = {};
if (filters.category) queryParams.category = filters.category;
if (filters.pricing) queryParams.pricing = filters.pricing;
if (filters.tags?.length) queryParams.tags = filters.tags.join(',');
if (filters.sort && filters.sort !== 'featured') queryParams.sort = filters.sort;

const pageTitle = 'instanten — Useful SaaS Tools, Ready in an Instant';
const pageDescription = 'A curated directory of genuinely useful SaaS tools. Browse by category, compare pricing, and go straight to official sites.';
---
<Layout title={pageTitle} description={pageDescription} canonicalURL="https://instanten.com/">
  <Hero toolCount={allTools.length} categoryCount={allCategories.length} />

  <section class="site-container py-6 lg:py-8" aria-label="Browse categories">
    <h2 class="sr-only">Categories</h2>
    <div class="flex flex-wrap gap-2">
      {allCategories.map(cat => (
        <a href={`/category/${cat.toLowerCase()}/`} class="px-3.5 py-1.5 rounded-full border border-border-hairline bg-canvas text-body-sm font-medium text-ink hover:border-ink transition-colors focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2">
          {cat}
        </a>
      ))}
    </div>
  </section>

  <section class="site-container py-6 lg:py-10" aria-label="Tool directory">
    <ToolGrid tools={toolData} />

    {sortedTools.length === 0 && (
      <div class="text-center py-16">
        <p class="text-body-lg text-muted">No tools match your filters. <a href="/" class="text-ink underline underline-offset-4 hover:text-accent-deep">Clear filters</a> to see all.</p>
      </div>
    )}
  </section>

  {totalPages > 1 && (
    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      baseUrl={baseUrl}
      queryParams={queryParams}
    />
  )}
</Layout>

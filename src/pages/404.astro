---
import ErrorPage from '../components/ErrorPage.astro';

/**
 * 404 — Page Not Found.
 * Astro isse seedha dist/404.html par emit karta hai, isliye host ise bina
 * kisi config ke serve kar sakta hai. noindex/nofollow + sitemap se bahar.
 */
---

<ErrorPage
  code={404}
  heading="Page Not Found"
  message="Sorry, we couldn't find the page you're looking for. It might have been moved, renamed, or it never existed."
  tips={[
    'Check the URL for a typo — tool addresses end with a slash, like /tools/word-counter/.',
    'Open the tools hub and search by name instead of guessing the address.',
    'Old links to removed pages can be recovered by starting again from the homepage.',
  ]}
  showPopularTools
/>

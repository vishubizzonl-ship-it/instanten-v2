---
import Layout from '../layouts/Layout.astro';
import { SITE_NAME, SITE_DOMAIN, SITE_URL, LAST_UPDATED, CONTACT_EMAIL } from '../config/siteInfo';

const pageTitle = `Terms & Conditions — ${SITE_NAME}`;
const pageDescription = `Terms and Conditions for ${SITE_DOMAIN}. Read before using the Service.`;
const canonicalURL = `${SITE_URL}/terms/`;
---

<Layout title={pageTitle} description={pageDescription} canonicalURL={canonicalURL}>
  <main class="ror-main">
    <div class="ror-container">
      <div class="ror-back-row">
        <a href="/" class="ror-back-link">&larr; Back to {SITE_NAME}</a>
      </div>

      <h1 class="ror-h1">Terms &amp; Conditions</h1>
      <p class="ror-updated">Last updated: {LAST_UPDATED}</p>

      <p class="ror-intro-copy">
        Please read these Terms and Conditions ("Terms") carefully before using <a href={SITE_URL} class="ror-link">{SITE_DOMAIN}</a> ("the Service"). By accessing or using the Service, you agree to be bound by these Terms.
      </p>

      <section class="ror-section">
        <h2 class="ror-h2">1. Use of the Service</h2>
        <p class="ror-p">
          {SITE_NAME} is a free directory and utility site. You may access and use the Service at no cost and without creating an account. The Service includes curated tool listings, free online utilities (Online Ruler, Image Compressor, JSON Formatter, and others), and practical guides.
        </p>
        <p class="ror-p">You agree not to:</p>
        <ul class="ror-ul">
          <li>Use the Service for any unlawful purpose or to violate any applicable law.</li>
          <li>Attempt to interfere with, damage, or gain unauthorized access to the Service or its infrastructure.</li>
          <li>Scrape, crawl, or extract content programmatically without explicit permission.</li>
        </ul>
      </section>

      <section class="ror-section">
        <h2 class="ror-h2">2. Accuracy &amp; Usage Disclaimer</h2>
        <p class="ror-p">
          The tools, calculators, utilities, and guides provided on {SITE_DOMAIN} are for informational and practical purposes only. Outputs and recommendations may vary based on input quality, browser environment, and other external factors.
        </p>
        <ul class="ror-ul">
          <li>Results from online tools depend on the accuracy of your inputs.</li>
          <li>Guides reflect best practices at the time of publication and may not cover every scenario.</li>
          <li>We make no warranties regarding the completeness, accuracy, or suitability of any tool output or article content.</li>
          <li><strong class="ror-strong">Important:</strong> For critical business, legal, medical, or engineering decisions, always verify results independently and consult qualified professionals.</li>
        </ul>
      </section>

      <section class="ror-section">
        <h2 class="ror-h2">3. Intellectual Property</h2>
        <p class="ror-p">
          All original content on {SITE_DOMAIN} — including design, code, copy, guides, and original thumbnails — is owned by {SITE_NAME} or licensed under appropriate terms. Tool names, logos, descriptions, and external links belong to their respective owners.
        </p>
        <p class="ror-p">
          You may not reproduce, distribute, create derivative works from, or commercially exploit our original content without written permission. Fair use for personal, non-commercial reference is permitted.
        </p>
      </section>

      <section class="ror-section">
        <h2 class="ror-h2">4. Disclaimer of Warranties</h2>
        <p class="ror-p">
          THE SERVICE IS PROVIDED "AS IS" AND "AS AVAILABLE" WITHOUT WARRANTIES OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, AND NON-INFRINGEMENT. We do not warrant that the Service will be uninterrupted, error-free, or free of harmful components.
        </p>
      </section>

      <section class="ror-section">
        <h2 class="ror-h2">5. Limitation of Liability</h2>
        <p class="ror-p">
          TO THE MAXIMUM EXTENT PERMITTED BY LAW, {SITE_NAME} SHALL NOT BE LIABLE FOR ANY INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR PUNITIVE DAMAGES ARISING FROM YOUR USE OF THE SERVICE, INCLUDING LOSS OF DATA, PROFITS, OR USE.
        </p>
        <p class="ror-p">
          Our total liability for any claim related to the Service shall not exceed the amount you paid to use the Service (zero), since the Service is provided free of charge.
        </p>
      </section>

      <section class="ror-section">
        <h2 class="ror-h2">6. Third-Party Links</h2>
        <p class="ror-p">
          The Service contains links to third-party tool websites ("Tools"). These links are provided for convenience only. We do not control, endorse, or assume responsibility for any Tool's content, privacy practices, or operations. Your use of Tools is at your own risk and subject to their terms.
        </p>
      </section>

      <section class="ror-section">
        <h2 class="ror-h2">7. Changes to These Terms</h2>
        <p class="ror-p">
          We reserve the right to modify these Terms at any time. Changes are effective immediately upon posting to this page. Continued use of the Service after changes constitutes acceptance of the revised Terms.
        </p>
      </section>

      <section class="ror-section">
        <h2 class="ror-h2">8. Contact</h2>
        <p class="ror-p">
          Questions about these Terms? <a href="/contact" class="ror-link">Contact us here</a> or email <a href={`mailto:${CONTACT_EMAIL}`} class="ror-link">{CONTACT_EMAIL}</a>.
        </p>
      </section>
    </div>
  </main>
</Layout>

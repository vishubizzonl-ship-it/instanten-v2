---
import Layout from '../layouts/Layout.astro';
import { SITE_NAME, SITE_URL } from '../config/siteInfo';

const pageTitle = `Contact — ${SITE_NAME}`;
const pageDescription = `Reach out to the ${SITE_NAME} team. Submit bug reports, feature requests, standards feedback, privacy or CCPA inquiries, and other questions through our verified contact form. No fake office or phone number — real channels for real users.`;
const canonicalURL = `${SITE_URL}/contact/`;
---

<Layout title={pageTitle} description={pageDescription} canonicalURL={canonicalURL}>
  <main class="ror-main">
    <div class="ror-container">
      <div class="ror-back-row">
        <a href="/" class="ror-back-link">&larr; Back to {SITE_NAME}</a>
      </div>

      <h1 class="ror-h1">Contact {SITE_NAME}</h1>
      <p class="ror-lead">
        Instanten is an independent browser-based software project — not a registered U.S. corporation with a physical office. We read every message through real, verified channels: this form and our project email at <a href="mailto:hello@instanten.com" class="ror-link">hello@instanten.com</a>. We respond as quickly as possible, typically within one to three business days for standard inquiries.
      </p>

      <form id="contact-form" class="ror-form" novalidate>
        <div class="ror-field">
          <label for="cf-name" class="ror-label">Name</label>
          <input id="cf-name" name="name" type="text" placeholder="Your name" autocomplete="name" required class="ror-input" />
        </div>

        <div class="ror-field">
          <label for="cf-email" class="ror-label">Email</label>
          <input id="cf-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required class="ror-input" />
        </div>

        <div class="ror-field">
          <label for="cf-subject" class="ror-label">Topic</label>
          <select id="cf-subject" name="subject" class="ror-select" required>
            <option value="" disabled selected>Select a topic…</option>
            <option value="bug">Bug report</option>
            <option value="feature">Feature or tool request</option>
            <option value="standards">Standards / accuracy feedback</option>
            <option value="privacy">Privacy / CCPA / DMCA inquiry</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="ror-field">
          <label for="cf-message" class="ror-label">Message</label>
          <textarea id="cf-message" name="message" rows="5" placeholder="Describe your issue, request, or question…" required class="ror-textarea"></textarea>
        </div>

        <div>
          <button type="submit" class="ror-submit-btn">Send message</button>
        </div>

        <div id="cf-success" class="ror-alert-success">Thanks for reaching out! We'll respond as soon as possible — typically within one to three business days.</div>
        <div id="cf-error" class="ror-alert-error">Please fill in all required fields before submitting.</div>
      </form>

      <section class="ror-section ror-section--contact-details" style="margin-top: 48px; padding-top: 24px; border-top: 1px solid #ebebeb;">
        <h2 class="ror-h2" style="font-size: 18px; margin-bottom: 12px;">Verified Contact Channels</h2>
        <ul class="ror-ul" style="margin-top: 0;">
          <li><strong>Website form</strong> — this page (<a href="/contact" class="ror-link">/contact</a>)</li>
          <li><strong>Email</strong> — <a href="mailto:hello@instanten.com" class="ror-link">hello@instanten.com</a> (verified project email)</li>
          <li><strong>Social / Code</strong> — links available through the site header and footer</li>
        </ul>
        <p class="ror-p" style="margin-top: 16px; font-size: 14px; color: #888;">
          Note: There is no physical mailing address, no U.S. office location, and no phone number for Instanten. We operate as an independent online software project. For privacy, CCPA, CPRA, or DMCA inquiries, please select "Privacy / CCPA / DMCA inquiry" above so we can route your message correctly.
        </p>
      </section>
    </div>
  </main>

  <script is:inline>
    (function () {
      const form = document.getElementById('contact-form');
      const success = document.getElementById('cf-success');
      const error = document.getElementById('cf-error');

      if (!form || !success || !error) return;

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        const name = document.getElementById('cf-name').value.trim();
        const email = document.getElementById('cf-email').value.trim();
        const subject = document.getElementById('cf-subject').value.trim();
        const message = document.getElementById('cf-message').value.trim();

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!name || !email || !subject || !message || !emailRegex.test(email)) {
          success.style.display = 'none';
          error.style.display = 'block';
          return;
        }

        error.style.display = 'none';
        success.style.display = 'block';
        form.reset();
      });
    })();
  </script>
</Layout>

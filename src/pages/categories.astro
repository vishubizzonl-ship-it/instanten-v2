---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const allTools = await getCollection('tools');
const categories = [...new Set(allTools.map(t => t.data.category))].sort();
const categoryCounts = categories.map(cat => ({
  name: cat,
  count: allTools.filter(t => t.data.category === cat).length,
  slug: cat.toLowerCase(),
}));

const pageTitle = 'Categories — instanten';
const pageDescription = 'Browse tools by category. Discover developer, design, marketing, writing, productivity, and utility tools.';
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Categories' },
];
---
<Layout title={pageTitle} description={pageDescription} canonicalURL="https://instanten.com/categories/">
  <Breadcrumbs items={breadcrumbs} />
  <section class="site-container py-section">
    <header class="max-w-3xl mx-auto text-center mb-16">
      <h1 class="font-display font-semibold text-display text-ink mb-4">Categories</h1>
      <p class="text-body-lg text-muted leading-relaxed">
        Browse tools organized by category. Each category contains curated tools for specific use cases.
      </p>
    </header>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 max-w-4xl mx-auto">
      {categoryCounts.map(cat => (
        <a
          href={`/category/${cat.slug}/`}
          class="group p-6 rounded-xl border border-border-hairline bg-surface hover:border-faint hover:shadow-whisper transition-colors text-left"
        >
          <h2 class="font-display font-semibold text-xl text-ink mb-2">{cat.name}</h2>
          <p class="text-body-md text-muted mb-4">{cat.count} {cat.count === 1 ? 'tool' : 'tools'}</p>
          <span class="inline-flex items-center gap-1.5 text-caption font-medium text-accent">
            View tools
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 7h6M10 7l3-3-3-3" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const pageTitle = 'Privacy Policy — instanten';
const pageDescription = 'instanten privacy policy. We respect your privacy and collect minimal data.';
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Privacy' },
];
const currentYear = new Date().getFullYear();
---
<Layout title={pageTitle} description={pageDescription} canonicalURL="https://instanten.com/privacy/">
  <Breadcrumbs items={breadcrumbs} />
  <article class="px-gutter py-section max-w-3xl mx-auto">
    <header class="mb-12">
      <h1 class="font-display font-semibold text-display tracking-[-2.4px] text-ink mb-4">Privacy Policy</h1>
      <p class="font-body text-body-md text-muted">Last updated: {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
    </header>

    <section class="mb-10">
      <h2 class="font-display font-semibold text-xl text-ink mb-4">Overview</h2>
      <p class="font-body text-body-md text-muted leading-relaxed mb-4">
        instanten (<strong>instanten.com</strong>) is a static website that serves as a curated directory of SaaS tools.
        We are committed to protecting your privacy. This policy explains what data we collect, how we use it, 
        and your rights.
      </p>
      <p class="font-body text-body-md text-muted leading-relaxed">
        In short: <strong>We collect no personal data by default.</strong> No tracking, no analytics cookies, no user accounts.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="font-display font-semibold text-xl text-ink mb-4">Data We Collect</h2>
      <h3 class="font-display font-semibold text-body-lg text-ink mb-3">Automatically (Server Logs)</h3>
      <p class="font-body text-body-md text-muted leading-relaxed mb-4">
        Like any website, our hosting provider (or CDN) may log standard access information:
      </p>
      <ul class="space-y-2 list-disc list-inside font-body text-body-md text-muted" role="list">
        <li>IP address (anonymized where possible)</li>
        <li>Request timestamp</li>
        <li>Requested URL</li>
        <li>User agent (browser/OS info)</li>
        <li>Referrer</li>
        <li>Response status code</li>
      </ul>
      <p class="font-body text-body-md text-muted leading-relaxed mt-4">
        These logs are used solely for security, abuse prevention, and operational monitoring. 
        They are not linked to your identity and are retained for a limited period (typically 30 days or less).
      </p>

      <h3 class="font-display font-semibold text-body-lg text-ink mb-3 mt-6">Voluntarily Provided</h3>
      <p class="font-body text-body-md text-muted leading-relaxed">
        If you email us (<code class="bg-muted/50 px-1.5 py-0.5 rounded font-mono text-sm">hello@instanten.com</code> or 
        <code class="bg-muted/50 px-1.5 py-0.5 rounded font-mono text-sm">submit@instanten.com</code>), 
        we receive your email address and message content. We use this only to respond to you.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="font-display font-semibold text-xl text-ink mb-4">Cookies & Local Storage</h2>
      <p class="font-body text-body-md text-muted leading-relaxed mb-4">
        instanten uses <strong>no cookies</strong> for tracking, analytics, or advertising.
      </p>
      <p class="font-body text-body-md text-muted leading-relaxed mb-4">
        We use <code class="bg-muted/50 px-1.5 py-0.5 rounded font-mono text-sm">localStorage</code> for one purpose only:
      </p>
      <ul class="space-y-2 list-disc list-inside font-body text-body-md text-muted" role="list">
        <li><strong>Theme preference</strong> (light/dark mode) — stored locally in your browser, never sent to our servers.</li>
      </ul>
      <p class="font-body text-body-md text-muted leading-relaxed mt-4">
        You can clear this at any time via your browser settings.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="font-display font-semibold text-xl text-ink mb-4">Third-Party Links</h2>
      <p class="font-body text-body-md text-muted leading-relaxed mb-4">
        Our directory links to external tool websites. When you click "Visit Tool," you leave instanten.com.
      </p>
      <p class="font-body text-body-md text-muted leading-relaxed mb-4">
        We are not responsible for the privacy practices of those sites. We recommend reviewing their 
        privacy policies. All external links use <code class="bg-muted/50 px-1.5 py-0.5 rounded font-mono text-sm">rel="noopener noreferrer"</code> 
        for security.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="font-display font-semibold text-xl text-ink mb-4">Analytics</h2>
      <p class="font-body text-body-md text-muted leading-relaxed">
        We do <strong>not</strong> use Google Analytics, Matomo, Plausible, Fathom, or any other analytics service. 
        No tracking scripts run on this site.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="font-display font-semibold text-xl text-ink mb-4">Your Rights</h2>
      <p class="font-body text-body-md text-muted leading-relaxed mb-4">
        Since we collect no personal data, there is nothing to access, rectify, or delete. 
        If you emailed us, you can request deletion of your messages by emailing us again.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="font-display font-semibold text-xl text-ink mb-4">Children's Privacy</h2>
      <p class="font-body text-body-md text-muted leading-relaxed">
        instanten is not directed at children under 13. We do not knowingly collect data from children.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="font-display font-semibold text-xl text-ink mb-4">Changes to This Policy</h2>
      <p class="font-body text-body-md text-muted leading-relaxed">
        Updates will be posted on this page with a revised "Last updated" date. 
        Continued use of the site constitutes acceptance.
      </p>
    </section>

    <section class="pt-8 border-t border-border-hairline">
      <h2 class="font-display font-semibold text-xl text-ink mb-4">Contact</h2>
      <p class="font-body text-body-md text-muted leading-relaxed mb-4">
        Questions about this policy? Email <a href="mailto:hello@instanten.com" class="text-accent-end hover:underline">hello@instanten.com</a>.
      </p>
      <p class="font-body text-caption text-muted">
        © {currentYear} instanten. All rights reserved.
      </p>
    </section>
  </article>
</Layout>

<style is:global>
  .text-display {
    font-size: 48px;
    line-height: 1.1;
  }

  @media (max-width: 640px) {
    .text-display {
      font-size: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none !important;
    }
  }
</style>
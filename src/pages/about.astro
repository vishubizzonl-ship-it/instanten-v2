---
import Layout from '../layouts/Layout.astro';
import { SITE_NAME, SITE_DOMAIN, SITE_URL, LAST_UPDATED, KEY_FEATURES } from '../config/siteInfo';

const pageTitle = `About — ${SITE_NAME}`;
const pageDescription = `Learn about ${SITE_NAME}, the curated directory of genuinely useful SaaS tools, guides, and free online utilities.`;
const canonicalURL = `${SITE_URL}/about/`;
---

<Layout title={pageTitle} description={pageDescription} canonicalURL={canonicalURL}>
  <main class="ror-main">
    <div class="ror-container">
      <div class="ror-back-row">
        <a href="/" class="ror-back-link">&larr; Back to {SITE_NAME}</a>
      </div>

      <h1 class="ror-h1">About {SITE_NAME}</h1>
      <p class="ror-updated">Last updated: {LAST_UPDATED}</p>

      <section class="ror-section ror-section--about">
        <h2 class="ror-h2">What is {SITE_NAME}?</h2>
        <p class="ror-p">
          <a href={SITE_URL} class="ror-link">{SITE_DOMAIN}</a> is a curated directory of genuinely useful SaaS tools, free online utilities, and practical guides for developers, designers, writers, and builders. We verify every link, categorize each tool honestly, and link directly to the official site — no affiliate redirects, no interstitial pages, no tracking pixels.
        </p>
        <p class="ror-p">
          Whether you need a quick <a href="/tools/" class="ror-link">Online Ruler</a>, <a href="/tools/" class="ror-link">Image Compressor</a>, <a href="/tools/" class="ror-link">JSON Formatter</a>, or a step-by-step guide on CSS Container Queries or TypeScript patterns, everything is accessible instantly. The site works on desktop, laptop, tablet, and phone — no app to install, no account to create, no paywall to bypass.
        </p>
      </section>

      <section class="ror-section ror-section--about">
        <h2 class="ror-h2">Our Mission</h2>
        <p class="ror-p">
          We built {SITE_NAME} because finding a reliable tool shouldn't feel like a research project. The web is full of cluttered directories, slow pages, broken links, and hidden ads. Our mission is to replace that noise with a fast, accurate, clean, and free experience. Every feature on this site exists to serve one goal: get you to the right resource in the shortest time possible.
        </p>
      </section>

      <section class="ror-section ror-section--about">
        <h2 class="ror-h2">Key Features</h2>
        <ul class="ror-ul">
          {KEY_FEATURES.map((feature) => (
            <li><strong class="ror-strong">{feature}</strong></li>
          ))}
        </ul>
      </section>

      <section class="ror-section ror-section--about">
        <h2 class="ror-h2">Privacy First</h2>
        <p class="ror-p">
          {SITE_NAME} is privacy-first. We don't require accounts, logins, or personal information. Theme preferences and tool settings are stored only in your browser's local storage and never sent to our servers. For full details, read our <a href="/privacy-policy" class="ror-link">Privacy Policy</a>.
        </p>
      </section>

      <section class="ror-section">
        <h2 class="ror-h2">Contact</h2>
        <p class="ror-p">
          Have a question, found a bug, or want to suggest a feature? We'd love to hear from you. <a href="/contact" class="ror-link">Contact us here</a>.
        </p>
      </section>
    </div>
  </main>
</Layout>

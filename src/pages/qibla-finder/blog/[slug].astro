---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import SiloProse from '../../../components/tool/SiloProse.astro';
import { SITE, toolBySlug } from '../../../data/tools';
import { postsByTool } from '../../../data/blog';

const tool = toolBySlug('qibla-finder')!;

export function getStaticPaths() {
  return postsByTool('qibla-finder').map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const canonicalPath = `/qibla-finder/blog/${post.slug}/`;
const related = postsByTool('qibla-finder').filter((p) => p.slug !== post.slug).slice(0, 2);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.description,
    datePublished: post.date,
    dateModified: post.updated ?? post.date,
    inLanguage: 'en',
    mainEntityOfPage: { '@type': 'WebPage', '@id': SITE.url + canonicalPath },
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    about: { '@type': 'SoftwareApplication', name: tool.name, url: `${SITE.url}/qibla-finder/` },
  },
];
---

<ToolLayout
  title={`${post.title} | ${SITE.name}`}
  description={post.description}
  keywords={post.keywords}
  tool="qibla-finder"
  canonicalPath={canonicalPath}
  ogType="article"
  crumbs={[{ label: 'Guides', href: '/qibla-finder/blog/' }, { label: post.title }]}
  jsonLd={jsonLd}
>
  <article>
    <header class="site-container max-w-[64rem] pt-8">
      <p class="mb-3 text-eyebrow font-semibold uppercase tracking-[0.1em]" style={`color:${tool.accent}`}>
        {tool.name} · guide
      </p>
      <h1 class="font-display text-[2rem] font-bold leading-[1.05] tracking-[-0.035em] text-ink sm:text-[2.6rem]">
        {post.title}
      </h1>
      <p class="mt-3 text-body-sm text-muted">
        <time datetime={post.date}>
          {new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        {' · '}{post.minutes} min read
      </p>
    </header>

    <SiloProse html={post.body} />

    <section class="site-container max-w-[64rem] pb-20">
      <div class="rounded-2xl p-6" style={`background:${tool.accentSoft}`}>
        <p class="text-body-md font-semibold text-ink">Try it yourself</p>
        <p class="mt-1 text-body-sm text-body">{tool.tagline}</p>
        <a href="/qibla-finder/" class="mt-4 inline-flex rounded-full px-5 py-2.5 text-body-sm font-semibold text-white" style={`background:${tool.accent}`}>
          Open the {tool.name} →
        </a>
      </div>

      {related.length > 0 && (
        <div class="mt-10">
          <h2 class="mb-4 font-display text-heading-md text-ink">Keep reading</h2>
          <ul class="grid gap-4 sm:grid-cols-2">
            {related.map((p) => (
              <li class="rounded-xl border border-border-hairline p-5">
                <a href={`/qibla-finder/blog/${p.slug}/`} class="text-body-md font-semibold tracking-tight text-ink hover:underline">
                  {p.title}
                </a>
                <p class="mt-1.5 text-body-sm leading-relaxed text-body">{p.description}</p>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  </article>
</ToolLayout>

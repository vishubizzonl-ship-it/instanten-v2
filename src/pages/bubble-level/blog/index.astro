---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { SITE, toolBySlug } from '../../../data/tools';
import { postsByTool } from '../../../data/blog';

const tool = toolBySlug('bubble-level')!;
const posts = postsByTool('bubble-level');
const canonicalPath = '/bubble-level/blog/';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${tool.name} guides`,
    description: `Practical guides for the ${tool.name}.`,
    url: SITE.url + canonicalPath,
    inLanguage: 'en',
  },
];
---

<ToolLayout
  title={`${tool.name} Guides & Tutorials | ${SITE.name}`}
  description={`Practical guides for the ${tool.name}: how it works, how accurate it really is, how to fix common problems, and when to use dedicated hardware instead.`}
  tool="bubble-level"
  canonicalPath={canonicalPath}
  crumbs={[{ label: 'Guides' }]}
  jsonLd={jsonLd}
>
  <section class="site-container max-w-[64rem] pb-20 pt-8">
    <h1 class="font-display text-[2.1rem] font-bold leading-[1.05] tracking-[-0.035em] text-ink sm:text-4xl">
      {tool.name} guides
    </h1>
    <p class="mt-3 max-w-[56ch] text-body-md leading-relaxed text-body">{tool.tagline}</p>

    <ul class="mt-10 divide-y divide-border-hairline border-y border-border-hairline">
      {posts.map((post) => (
        <li class="py-6">
          <a href={`/bubble-level/blog/${post.slug}/`} class="font-display text-lg font-semibold tracking-tight text-ink hover:underline">
            {post.title}
          </a>
          <p class="mt-2 max-w-[64ch] text-body-sm leading-relaxed text-body">{post.description}</p>
          <p class="mt-2 text-caption text-muted">
            <time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
            {' · '}{post.minutes} min read
          </p>
        </li>
      ))}
    </ul>

    {posts.length === 0 && <p class="py-6 text-body-sm text-muted">Guides are on the way.</p>}

    <div class="mt-10">
      <a href="/bubble-level/" class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-body-sm font-semibold text-white" style={`background:${tool.accent}`}>
        Open the {tool.name} →
      </a>
    </div>
  </section>
</ToolLayout>

---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map(tool => ({
    params: { slug: tool.data.slug },
    props: { tool },
  }));
}

interface Props {
  tool: {
    data: {
      slug: string;
      name: string;
      category: string;
      description: string;
      longDescription?: string;
      pricing: 'Free' | 'Freemium' | 'Paid';
      pricingDetails?: string;
      image: string;
      url: string;
      tags?: string[];
      maker?: string;
      addedDate?: string;
      updatedDate?: string;
      features?: string[];
      useCases?: string[];
      featured?: boolean;
    };
  };
}

const { tool } = Astro.props;
const { name, category, description, pricing, pricingDetails, image, url, tags = [], maker, addedDate, updatedDate, features = [], useCases = [], featured = false } = tool.data;

const pricingColors = {
  Free: 'bg-emerald-100 text-emerald-700',
  Freemium: 'bg-amber-100 text-amber-700',
  Paid: 'bg-violet-100 text-violet-700',
} as const satisfies Record<'Free' | 'Freemium' | 'Paid', string>;

const allTools = await getCollection('tools');
const otherTools = allTools.filter(t => t.data.slug !== tool.data.slug);
const relatedTools = otherTools
  .filter(t => t.data.category === category || (t.data.tags || []).some(tag => tags.includes(tag)))
  .slice(0, 4);

const pageTitle = `${name} — instanten`;
const pageDescription = description;
const canonicalURL = `https://instanten.com/tools/${tool.data.slug}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: name,
  description: description,
  url: canonicalURL,
  applicationCategory: category,
  operatingSystem: 'Web',
  offers: {
    '@type': 'Offer',
    price: pricing === 'Free' ? '0' : undefined,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    description: pricingDetails,
  },
  author: maker ? { '@type': 'Organization', name: maker } : undefined,
  datePublished: addedDate,
  dateModified: updatedDate,
  featureList: features,
  screenshot: new URL(image, 'https://instanten.com').href,
};

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: category, href: `/category/${category.toLowerCase()}/` },
  { label: name },
];
---
<Layout title={pageTitle} description={pageDescription} jsonLd={jsonLd} canonicalURL={canonicalURL}>
  <Breadcrumbs items={breadcrumbs} />
  <article class="px-gutter py-section max-w-4xl mx-auto">
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="text-caption text-muted font-medium uppercase tracking-wide">{category}</span>
        <span class={`text-caption font-medium px-2 py-0.5 rounded-full ${pricingColors[pricing]}`}>{pricing}</span>
        {featured && <span class="text-caption font-medium px-2 py-0.5 rounded-full bg-accent-start/90 text-white">Featured</span>}
      </div>
      <h1 class="font-display font-semibold text-display tracking-[-2.4px] text-ink mb-4">{name}</h1>
      <p class="font-body text-body-lg text-muted leading-relaxed">{description}</p>
    </header>

    <div class="aspect-video rounded-lg overflow-hidden bg-muted/20 mb-10">
      <img
        src={image}
        alt=""
        class="w-full h-full object-cover"
        width="640"
        height="360"
      />
    </div>

    {pricingDetails && (
      <section class="mb-10 p-6 rounded-lg bg-muted/30 border border-border-hairline">
        <h2 class="font-display font-semibold text-body-lg text-ink mb-3 flex items-center gap-2">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-start" aria-hidden="true">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
          Pricing
        </h2>
        <p class="font-body text-body-md text-muted leading-relaxed">{pricingDetails}</p>
      </section>
    )}

    {features.length > 0 && (
      <section class="mb-10">
        <h2 class="font-display font-semibold text-body-lg text-ink mb-4 flex items-center gap-2">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-start" aria-hidden="true">
            <path d="M9 11l3 3L22 4"/>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
          </svg>
          Key Features
        </h2>
        <ul class="grid gap-3 sm:grid-cols-2" role="list">
          {features.map(feature => (
            <li class="flex items-start gap-3 p-4 rounded-lg bg-surface border border-border-hairline">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600 flex-shrink-0 mt-0.5" aria-hidden="true">
                <path d="M5 10l3 3 7-7"/>
              </svg>
              <span class="font-body text-body-md text-ink">{feature}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {useCases.length > 0 && (
      <section class="mb-10">
        <h2 class="font-display font-semibold text-body-lg text-ink mb-4 flex items-center gap-2">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-start" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1"/>
            <rect x="10" y="3" width="7" height="7" rx="1"/>
            <rect x="3" y="10" width="7" height="7" rx="1"/>
            <rect x="10" y="10" width="7" height="7" rx="1"/>
          </svg>
          Use Cases
        </h2>
        <ul class="flex flex-wrap gap-2" role="list">
          {useCases.map(useCase => (
            <li class="font-body text-body-md px-3 py-1.5 rounded-full border border-border-hairline bg-surface text-muted">{useCase}</li>
          ))}
        </ul>
      </section>
    )}

    {tags.length > 0 && (
      <section class="mb-10">
        <h2 class="font-display font-semibold text-body-lg text-ink mb-3 flex items-center gap-2">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-start" aria-hidden="true">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
            <line x1="7" y1="7" x2="7.01" y2="7.01"/>
          </svg>
          Tags
        </h2>
        <div class="flex flex-wrap gap-2">
          {tags.map(tag => (
            <a href={`/tag/${tag.toLowerCase()}/`} class="text-caption font-medium px-3 py-1 rounded-full border border-border-hairline bg-surface text-muted hover:text-ink hover:border-ink/50 transition-colors">{tag}</a>
          ))}
        </div>
      </section>
    )}

    {relatedTools.length > 0 && (
      <section class="mb-10">
        <h2 class="font-display font-semibold text-body-lg text-ink mb-6 flex items-center gap-2">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-start" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          Related Tools
        </h2>
        <div class="grid gap-gutter grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
          {relatedTools.map(related => (
            <article class="bg-surface border border-border-hairline rounded-lg overflow-hidden">
              <a href={`/tools/${related.data.slug}/`} class="block aspect-[16/9] overflow-hidden bg-muted/20">
                <img src={related.data.image} alt="" class="w-full h-full object-cover" loading="lazy" width="320" height="180" />
              </a>
              <div class="p-4">
                <h3 class="font-display font-semibold text-base text-ink mb-2">
                  <a href={`/tools/${related.data.slug}/`} class="hover:text-accent-end transition-colors">{related.data.name}</a>
                </h3>
                <p class="font-body text-sm text-muted line-clamp-2 mb-3">{related.data.description}</p>
                <div class="flex items-center gap-2">
                  <span class="text-caption text-muted font-medium uppercase tracking-wide">{related.data.category}</span>
                  <span class="text-caption text-muted" aria-hidden="true">·</span>
                  <span class={`text-caption font-medium px-2 py-0.5 rounded-full ${pricingColors[related.data.pricing]}`}>{related.data.pricing}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <div class="pt-8 border-t border-border-hairline">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-8 py-4 rounded-full bg-ink text-white font-body font-medium text-base hover:bg-ink/90 transition-colors focus:outline-none focus:ring-2 focus:ring-accent-start focus:ring-offset-2"
        aria-label={`Visit ${name} - opens in new tab`}
      >
        Visit Tool
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 15h10M10 10l5-5-5-5" />
        </svg>
      </a>
    </div>

    {(maker || addedDate) && (
      <footer class="mt-10 pt-6 border-t border-border-hairline">
        <dl class="grid gap-4 sm:grid-cols-2 text-sm">
          {maker && (
            <div>
              <dt class="font-body text-caption text-muted uppercase tracking-wide mb-1">Maker</dt>
              <dd class="font-body text-body-md text-ink">{maker}</dd>
            </div>
          )}
          {addedDate && (
            <div>
              <dt class="font-body text-caption text-muted uppercase tracking-wide mb-1">Added</dt>
              <dd class="font-body text-body-md text-ink">{new Date(addedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</dd>
            </div>
          )}
          {updatedDate && (
            <div>
              <dt class="font-body text-caption text-muted uppercase tracking-wide mb-1">Last Updated</dt>
              <dd class="font-body text-body-md text-ink">{new Date(updatedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</dd>
            </div>
          )}
        </dl>
      </footer>
    )}
  </article>
</Layout>

<style is:global>
  .text-display {
    font-size: 48px;
    line-height: 1.1;
  }

  .text-body-lg {
    font-size: 16px;
    line-height: 1.6;
  }

  .text-body-md {
    font-size: 14px;
    line-height: 1.5;
  }

  .text-caption {
    font-size: 12px;
    line-height: 1.4;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .text-display {
      font-size: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a, img {
      transition: none !important;
    }
  }
</style>
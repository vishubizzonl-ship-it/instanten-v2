---
import Layout from '../../layouts/Layout.astro';
import EditorialHero from '../../components/EditorialHero.astro';
import BlogPagination from '../../components/BlogPagination.astro';
import { getCollection } from 'astro:content';
import { parseFilters, filterTools, sortTools, paginateTools } from '../../utils/filters';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  const totalPages = Math.ceil(tools.length / 10);
  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: String(i + 1) },
  }));
}

const { page } = Astro.params;
const currentPage = parseInt(page, 10) || 1;

const allTools = await getCollection('tools');

const searchParams = new URLSearchParams(Astro.url.search);
const filters = parseFilters(searchParams);
filters.page = currentPage;

const filteredTools = filterTools(allTools, filters);
const sortedTools = sortTools(filteredTools, filters.sort || 'featured');

const PER_PAGE = 10;
const totalPages = Math.ceil(sortedTools.length / PER_PAGE);
const paginatedTools = paginateTools(sortedTools, currentPage, PER_PAGE);

const toolData = paginatedTools.map((tool) => ({
  slug: tool.data.slug,
  name: tool.data.name,
  category: tool.data.category,
  description: tool.data.description,
  pricing: tool.data.pricing,
  image: tool.data.image,
  url: tool.data.url,
  tags: tool.data.tags,
  maker: tool.data.maker,
  addedDate: tool.data.addedDate,
  updatedDate: tool.data.updatedDate,
  featured: tool.data.featured,
}));

const baseUrl = '/';
const queryParams: Record<string, string> = {};
if (filters.category) queryParams.category = filters.category;
if (filters.pricing) queryParams.pricing = filters.pricing;
if (filters.tags?.length) queryParams.tags = filters.tags.join(',');
if (filters.sort && filters.sort !== 'featured') queryParams.sort = filters.sort;

const pageTitle = `Page ${currentPage} — instanten`;
const pageDescription = `Discover useful SaaS tools — Page ${currentPage} of ${totalPages}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'SaaS Tools Directory',
  description: pageDescription,
  numberOfItems: allTools.length,
  itemListElement: paginatedTools.map((tool, index) => ({
    '@type': 'ListItem',
    position: (currentPage - 1) * PER_PAGE + index + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: tool.data.name,
      description: tool.data.description,
      url: new URL(`/tools/${tool.data.slug}/`, 'https://instanten.com').href,
      applicationCategory: tool.data.category,
      offers: {
        '@type': 'Offer',
        price: tool.data.pricing === 'Free' ? '0' : undefined,
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
      },
    },
  })),
};
---
<Layout title={pageTitle} description={pageDescription} jsonLd={jsonLd} canonicalURL={`https://instanten.com/page/${currentPage}/`}>
  <EditorialHero />

  <section class="site-container pb-[64px] flex-1 lg:mb-[80px] md:mb-[48px] mb-[48px] flex flex-col items-center" aria-label="Tool directory">
    <div class="blog-grid" data-cards-grid role="list" aria-label="Featured tools">
      {toolData.map((tool) => (
        <article class="blog-card">
          <a href={`/tools/${tool.slug}/`} class="blog-card__thumbnail" aria-label={`View details for ${tool.name}`}>
            <img
              src={tool.image}
              alt={`${tool.name} preview`}
              loading="lazy"
              decoding="async"
              width="400"
              height="225"
            />
            <span class="blog-card__category-pill" style="position: absolute; top: 15px; left: 15px; background: var(--ink); color: var(--canvas); padding: 4px 10px; border-radius: 9999px; font-size: 12px; font-weight: 600; text-transform: uppercase;">
              {tool.category}
            </span>
          </a>

          <div class="blog-card__body">
            <h2 class="blog-card__title">
              <a href={`/tools/${tool.slug}/`} class="transition-colors hover:text-accent-deep">{tool.name}</a>
            </h2>

            <p class="blog-card__excerpt">{tool.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <BlogPagination currentPage={currentPage} totalPages={totalPages} basePath="" />
</Layout>
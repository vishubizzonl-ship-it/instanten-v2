---
import Layout from '../../layouts/Layout.astro';
import ToolGrid from '../../components/ToolGrid.astro';
import FilterBar from '../../components/FilterBar.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';
import { parseFilters, filterTools, sortTools, paginateTools, getTotalPages } from '../../utils/filters';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  const totalPages = Math.ceil(tools.length / 10);
  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: String(i + 1) },
  }));
}

const { page } = Astro.params;
const currentPage = parseInt(page, 10) || 1;

const allTools = await getCollection('tools');

const searchParams = new URLSearchParams(Astro.url.search);
const filters = parseFilters(searchParams);
filters.page = currentPage;

const filteredTools = filterTools(allTools, filters);
const sortedTools = sortTools(filteredTools, filters.sort || 'featured');

const PER_PAGE = 10;
const totalPages = getTotalPages(sortedTools.length, PER_PAGE);
const paginatedTools = paginateTools(sortedTools, currentPage, PER_PAGE);

const toolData = paginatedTools.map(tool => ({
  slug: tool.data.slug,
  name: tool.data.name,
  category: tool.data.category,
  description: tool.data.description,
  pricing: tool.data.pricing,
  image: tool.data.image,
  url: tool.data.url,
  tags: tool.data.tags,
  featured: tool.data.featured,
}));



const baseUrl = '/';
const queryParams: Record<string, string> = {};
if (filters.q) queryParams.q = filters.q;
if (filters.category) queryParams.category = filters.category;
if (filters.pricing) queryParams.pricing = filters.pricing;
if (filters.tags?.length) queryParams.tags = filters.tags.join(',');
if (filters.sort && filters.sort !== 'featured') queryParams.sort = filters.sort;

const pageTitle = `Page ${currentPage} — instanten`;
const pageDescription = `Discover useful SaaS tools — Page ${currentPage} of ${totalPages}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'SaaS Tools Directory',
  description: pageDescription,
  numberOfItems: allTools.length,
  itemListElement: paginatedTools.map((tool, index) => ({
    '@type': 'ListItem',
    position: (currentPage - 1) * PER_PAGE + index + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: tool.data.name,
      description: tool.data.description,
      url: new URL(`/tools/${tool.data.slug}/`, 'https://instanten.com').href,
      applicationCategory: tool.data.category,
      offers: {
        '@type': 'Offer',
        price: tool.data.pricing === 'Free' ? '0' : undefined,
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
      },
    },
  })),
};
---
<Layout title={pageTitle} description={pageDescription} jsonLd={jsonLd} canonicalURL={`https://instanten.com/page/${currentPage}/`}>
  <FilterBar
    currentCategory={filters.category}
    currentPricing={filters.pricing}
    currentTags={filters.tags}
    currentSort={filters.sort}
    hasFilters={Boolean(filters.q || filters.category || filters.pricing || filters.tags?.length)}
    baseUrl={baseUrl}
  />
  <ToolGrid tools={toolData} />
  {totalPages > 1 && (
    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      baseUrl={baseUrl}
      queryParams={queryParams}
    />
  )}
</Layout>
---
import { nonDefaultLangs, type LangCode } from '../../i18n/ui';
import { useTranslatedPath } from '../../i18n/utils';

export function getStaticPaths() {
  return nonDefaultLangs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: LangCode };
const translatePath = useTranslatedPath(lang);
const destination = translatePath('/privacy-policy/');
const canonicalURL = `https://instanten.com${destination}`;

/** Ek hi theme bootstrap (public/theme-bridge.js) — inline. */
import themeBootstrap from '../../scripts/themeBootstrap.js?raw';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Redirecting to Privacy Policy — Instanten</title>
  {/* Redirect stub — search index me na aaye (canonical asli page par hai). */}
  <meta name="robots" content="noindex, follow" />
  <meta http-equiv="refresh" content={`0;url=${destination}`} />
  {/* Theme: redirect stub bhi usi mode mein dikhe jo user ne chuna hai —
      warna dark site par is page par safed flash aata hai. */}
  <script is:inline set:html={themeBootstrap}></script>
  <style is:inline>
    html { background: #FDFDFF; color: #29294B; }
    html.dark, html[data-theme='dark'] { background: #1C1C1C; color: #E0E0E0; }
    body { background: inherit; color: inherit; font-family: system-ui, sans-serif; padding: 2rem; }
    a { color: #514DCC; }
    html.dark a, html[data-theme='dark'] a { color: #6B5BE8; }
  </style>
  <link rel="canonical" href={canonicalURL} />
</head>
<body>
  <p>If you are not redirected automatically, follow this <a href={destination}>link to the Privacy Policy</a>.</p>
</body>
</html>

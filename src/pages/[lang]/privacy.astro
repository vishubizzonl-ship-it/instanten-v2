---
import { nonDefaultLangs, type LangCode } from '../../i18n/ui';
import { useTranslatedPath } from '../../i18n/utils';

export function getStaticPaths() {
  return nonDefaultLangs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: LangCode };
const translatePath = useTranslatedPath(lang);
const destination = translatePath('/privacy-policy/');
const canonicalURL = `https://instanten.com${destination}`;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Redirecting to Privacy Policy — Instanten</title>
  <meta http-equiv="refresh" content={`0;url=${destination}`} />
  <link rel="canonical" href={canonicalURL} />
</head>
<body>
  <p>If you are not redirected automatically, follow this <a href={destination}>link to the Privacy Policy</a>.</p>
</body>
</html>

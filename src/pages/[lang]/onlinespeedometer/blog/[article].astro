---
/**
 * Localised blog articles: /<lang>/onlinespeedometer/blog/<slug>/
 * (English URLs prefix-free: /onlinespeedometer/blog/<slug>/)
 */
import A0 from '../../../../components/pages/onlinespeedometer/articles/how-accurate-is-a-phone-speedometer.astro';
import A1 from '../../../../components/pages/onlinespeedometer/articles/how-to-use-an-online-speedometer.astro';
import A2 from '../../../../components/pages/onlinespeedometer/articles/speedometer-units-kmh-mph-knots.astro';

export function getStaticPaths() {
  const locales = ['es', 'ja', 'fr', 'de', 'pt', 'ko', 'it', 'nl', 'sv'];
  const slugs = ['how-accurate-is-a-phone-speedometer', 'how-to-use-an-online-speedometer', 'speedometer-units-kmh-mph-knots'];
  return locales.flatMap((lang) => slugs.map((article) => ({ params: { lang, article } })));
}

const articles: Record<string, any> = {
  'how-accurate-is-a-phone-speedometer': A0,
  'how-to-use-an-online-speedometer': A1,
  'speedometer-units-kmh-mph-knots': A2,
};

const { article } = Astro.params as { article: string };
const Article = articles[article];
---

<Article />

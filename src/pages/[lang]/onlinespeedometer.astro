---
/**
 * onlinespeedometer — localized page.
 *
 * Island SpeedometerIsland.astro se aata hai (compassinstant se port kiya hua, jaisa tha
 * waisa chalta hua), page shell InstrumentToolPage.astro se. Copy localized hai.
 */
import InstrumentToolPage from '../../components/pages/InstrumentToolPage.astro';
import SpeedometerIsland from '../../components/instruments/SpeedometerIsland.astro';
import { getEntry } from 'astro:content';
import { instrumentUi } from '../../i18n/instruments/ui';
import { getLangFromUrl } from '../../i18n/utils';
import { speedometerProse } from '../../i18n/instruments/speedometerProse';
import { nonDefaultLangs, type LangCode } from '../../i18n/ui';

export async function getStaticPaths() {
  return nonDefaultLangs.map((lang: LangCode) => ({ params: { lang } }));
}

const tool = await getEntry('tools', 'onlinespeedometer');
if (!tool) throw new Error('tool entry missing: onlinespeedometer');

const lang = getLangFromUrl(Astro.url);
const u = instrumentUi[lang] ?? instrumentUi.en;
const how = {
  enable: u['page.speed.how.enable'],
  enableDesc: u['page.speed.how.enable.desc'],
  second: u['page.speed.how.calibrate'],
  secondDesc: u['page.speed.how.calibrate.desc'],
  third: u['page.speed.how.offline'],
  thirdDesc: u['page.speed.how.offline.desc'],
};
---

<InstrumentToolPage
  slug="onlinespeedometer"
  tool={tool}
  prose={speedometerProse}
  faqLangs={['en', 'es', 'ja', 'fr', 'de', 'pt', 'ko', 'it']}
  how={how}
>
  <SpeedometerIsland />
</InstrumentToolPage>

---
/**
 * Localised blog articles: /<lang>/onlineqibla/blog/<slug>/
 * (English URLs prefix-free: /onlineqibla/blog/<slug>/)
 */
import A0 from '../../../../components/pages/onlineqibla/articles/how-to-find-qibla-direction-anywhere.astro';
import A1 from '../../../../components/pages/onlineqibla/articles/qibla-direction-compass-degrees.astro';
import A2 from '../../../../components/pages/onlineqibla/articles/why-is-my-qibla-direction-wrong.astro';

export function getStaticPaths() {
  const locales = ['es', 'ja', 'fr', 'de', 'pt', 'ko', 'it', 'nl', 'sv'];
  const slugs = ['how-to-find-qibla-direction-anywhere', 'qibla-direction-compass-degrees', 'why-is-my-qibla-direction-wrong'];
  return locales.flatMap((lang) => slugs.map((article) => ({ params: { lang, article } })));
}

const articles: Record<string, any> = {
  'how-to-find-qibla-direction-anywhere': A0,
  'qibla-direction-compass-degrees': A1,
  'why-is-my-qibla-direction-wrong': A2,
};

const { article } = Astro.params as { article: string };
const Article = articles[article];
---

<Article />

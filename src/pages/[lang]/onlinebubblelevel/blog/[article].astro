---
/**
 * Localised blog articles: /<lang>/onlinebubblelevel/blog/<slug>/
 * (English URLs prefix-free: /onlinebubblelevel/blog/<slug>/)
 */
import A0 from '../../../../components/pages/onlinebubblelevel/articles/bubble-level-vs-spirit-level.astro';
import A1 from '../../../../components/pages/onlinebubblelevel/articles/how-accurate-is-a-phone-bubble-level.astro';
import A2 from '../../../../components/pages/onlinebubblelevel/articles/how-to-use-an-online-bubble-level.astro';
import A3 from '../../../../components/pages/onlinebubblelevel/articles/level-furniture-shelves-appliances.astro';
import A4 from '../../../../components/pages/onlinebubblelevel/articles/how-to-check-if-a-surface-is-level.astro';

export function getStaticPaths() {
  const locales = ['es', 'ja', 'fr', 'de', 'pt', 'ko', 'it', 'nl', 'sv'];
  const slugs = [
    'bubble-level-vs-spirit-level',
    'how-accurate-is-a-phone-bubble-level',
    'how-to-use-an-online-bubble-level',
    'level-furniture-shelves-appliances',
    'how-to-check-if-a-surface-is-level',
  ];
  return locales.flatMap((lang) => slugs.map((article) => ({ params: { lang, article } })));
}

const articles: Record<string, any> = {
  'bubble-level-vs-spirit-level': A0,
  'how-accurate-is-a-phone-bubble-level': A1,
  'how-to-use-an-online-bubble-level': A2,
  'level-furniture-shelves-appliances': A3,
  'how-to-check-if-a-surface-is-level': A4,
};

const { article } = Astro.params as { article: string };
const Article = articles[article];
---

<Article />

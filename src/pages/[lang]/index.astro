---
import Layout from '../../layouts/Layout.astro';
import EditorialHero from '../../components/EditorialHero.astro';
import BlogPagination from '../../components/BlogPagination.astro';
import HomeSeoSection, { homeFaqs } from '../../components/HomeSeoSection.astro';
import { getAllTools } from '../../utils/standaloneTools';
import { parseFilters, filterTools, sortTools, paginateTools, toolHref, type ToolData } from '../../utils/filters';
import { nonDefaultLangs, type LangCode } from '../../i18n/ui';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { seoHome } from '../../i18n/seoContent';

export function getStaticPaths() {
  return nonDefaultLangs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: LangCode };
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const seo = seoHome[lang];

const allTools = await getAllTools();
const searchParams = new URLSearchParams(Astro.url.search);
const filters = parseFilters(searchParams);
const filteredTools = filterTools(allTools, filters);
const sortedTools = sortTools(filteredTools, filters.sort || 'featured');
const PER_PAGE = 10;
const totalPages = Math.ceil(sortedTools.length / PER_PAGE);
const currentPage = filters.page || 1;
const paginatedTools = paginateTools(sortedTools, currentPage, PER_PAGE);

const toolData: ToolData[] = paginatedTools.map((tool) => ({
  slug: tool.data.slug,
  name: tool.data.name,
  category: tool.data.category,
  description: tool.data.description,
  pricing: tool.data.pricing,
  image: tool.data.image,
  url: tool.data.url,
  tags: tool.data.tags,
  maker: tool.data.maker,
  addedDate: tool.data.addedDate,
  updatedDate: tool.data.updatedDate,
  featured: tool.data.featured,
}));

const pageTitle = currentPage === 1 ? seo.title : `${seo.title} — Page ${currentPage}`;
const pageDescription = seo.description;
const canonicalURL = currentPage === 1
  ? `https://instanten.com/${lang}/`
  : `https://instanten.com/${lang}/page/${currentPage}/`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
  ogImage="/og-instanten.svg"
  keywords={seo.keywords}
  includeAppSchema={true}
  faqs={homeFaqs}
  breadcrumbs={currentPage === 1 ? [{ name: 'Home', item: '/' }] : [{ name: 'Home', item: '/' }, { name: 'Page ' + currentPage, item: '/page/' + currentPage }]}
  lang={lang}
>
  <EditorialHero />

  <section class="site-container pb-[64px] flex-1 lg:mb-[80px] md:mb-[48px] mb-[48px] flex flex-col items-center" aria-label="Tool directory">
    <div class="blog-grid" data-cards-grid role="list" aria-label="Featured tools">
      {toolData.map((tool) => (
        <article class="blog-card">
          <a href={translatePath(`/tools/${tool.slug}/`)} class="blog-card__thumbnail" aria-label={`View details for ${tool.name}`}>
            <img
              src={tool.image}
              alt={`${tool.name} preview`}
              loading="lazy"
              decoding="async"
              width="400"
              height="225"
            />
            <span class="blog-card__category-pill" style="position: absolute; top: 15px; left: 15px; background: var(--ink); color: var(--canvas); padding: 4px 10px; border-radius: 9999px; font-size: 12px; font-weight: 600; text-transform: uppercase;">
              {tool.category}
            </span>
          </a>
          <div class="blog-card__body">
            <h2 class="blog-card__title">
              <a href={translatePath(`/tools/${tool.slug}/`)} class="transition-colors hover:text-accent-deep">{tool.name}</a>
            </h2>
            <p class="blog-card__excerpt">{tool.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <BlogPagination currentPage={currentPage} totalPages={totalPages} basePath={translatePath('')} />

  <HomeSeoSection />
</Layout>

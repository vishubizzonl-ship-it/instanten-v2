---
import Layout from '../../layouts/Layout.astro';
import { toolPath } from '../../utils/toolPaths';
import EditorialHero from '../../components/EditorialHero.astro';
import LibraryFilterBar from '../../components/LibraryFilterBar.astro';
import BlogPagination from '../../components/BlogPagination.astro';
import HomeSeoSection, { getHomeFaqs } from '../../components/HomeSeoSection.astro';
import { getAllTools } from '../../utils/standaloneTools';
import { parseFilters, filterTools, sortTools, paginateTools, toolHref, type ToolData } from '../../utils/filters';
import { nonDefaultLangs, type LangCode } from '../../i18n/ui';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { seoHome } from '../../i18n/seoContent';
import { localizeTool, localizeToolCategory, localizePricing } from '../../i18n/toolContent';
import { toolSearchAliases } from '../../i18n/searchAliases';

export function getStaticPaths() {
  return nonDefaultLangs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: LangCode };
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const seo = seoHome[lang];

const allTools = await getAllTools();
const searchParams = new URLSearchParams(Astro.url.search);
const filters = parseFilters(searchParams);
const filteredTools = filterTools(allTools, filters);
const sortedTools = sortTools(filteredTools, filters.sort || 'featured');
// Grid ke upar filter section hai — poori list ek page par (jaise EN home).
const PER_PAGE = 50;
const totalPages = Math.ceil(sortedTools.length / PER_PAGE);
const currentPage = filters.page || 1;
const paginatedTools = paginateTools(sortedTools, currentPage, PER_PAGE);

const toolData: ToolData[] = paginatedTools.map((tool) => ({
  slug: tool.data.slug,
  name: tool.data.name,
  category: tool.data.category,
  description: tool.data.description,
  pricing: tool.data.pricing,
  image: tool.data.image,
  url: tool.data.url,
  tags: tool.data.tags,
  maker: tool.data.maker,
  addedDate: tool.data.addedDate,
  updatedDate: tool.data.updatedDate,
  featured: tool.data.featured,
}));

const pageTitle = currentPage === 1 ? seo.title : `${seo.title} — ${t('aria.page')} ${currentPage}`;
const pageDescription = seo.description;
const canonicalURL = currentPage === 1
  ? `https://instanten.com/${lang}/`
  : `https://instanten.com/${lang}/page/${currentPage}/`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
  ogImage="/og-instanten.png"
  keywords={seo.keywords}
  includeAppSchema={true}
  faqs={getHomeFaqs(lang)}
  breadcrumbs={currentPage === 1 ? [{ name: 'Home', item: '/' }] : [{ name: 'Home', item: '/' }, { name: 'Page ' + currentPage, item: '/page/' + currentPage }]}
  lang={lang}
>
  <EditorialHero />

  <section class="site-container pb-6" aria-label={t('aria.toolDirectory')}>
    <LibraryFilterBar
      tools={toolData}
      baseUrl={translatePath('/')}
      currentCategory={filters.category}
      currentPricing={filters.pricing}
      currentTags={filters.tags}
      currentSort={filters.sort}
      query={filters.q}
      showCardSize={false}
    />
  </section>

  <section class="site-container pb-[64px] flex-1 lg:mb-[80px] md:mb-[48px] mb-[48px] flex flex-col items-center" aria-label={t('aria.toolDirectory')}>
    <div class="blog-grid" data-cards-grid data-lib-grid data-lib-fixed-grid role="list" aria-label={t('aria.featuredTools')}>
      {toolData.map((tool) => {
        const localized = localizeTool(lang, tool);
        const toolHref = translatePath(toolPath(tool.slug));
        return (
        <article
          class="blog-card"
          data-tool-card
          data-slug={tool.slug}
          data-name={localized.name}
          data-category={tool.category}
          data-pricing={tool.pricing}
          data-tags={(tool.tags ?? []).join(',')}
          data-added={tool.addedDate ?? ''}
          data-updated={tool.updatedDate ?? tool.addedDate ?? ''}
          data-featured={tool.featured ? 'true' : 'false'}
          data-search={[localized.name, tool.category, localized.description, ...(tool.tags ?? []), toolSearchAliases(tool.slug, lang)].join(' ')}
        >
          <a href={toolHref} class="blog-card__thumbnail" aria-label={`${t('aria.viewDetails')} ${localized.name}`}>
            <img
              src={tool.image}
              alt={localized.name}
              loading="lazy"
              decoding="async"
              width="400"
              height="225"
            />
            <span class="blog-card__category-pill">{localizeToolCategory(lang, tool.category)}</span>
            <span class="blog-card__meta-chip">{localizePricing(lang, tool.pricing)}</span>
          </a>
          <div class="blog-card__body">
            <h2 class="blog-card__title">
              <a href={toolHref} class="transition-colors hover:text-accent-deep">{localized.name}</a>
            </h2>
            <p class="blog-card__excerpt">{localized.description}</p>
          </div>
        </article>
        );
      })}
    </div>
  </section>

  <BlogPagination currentPage={currentPage} totalPages={totalPages} basePath={translatePath('')} />

  <HomeSeoSection lang={lang} />
</Layout>

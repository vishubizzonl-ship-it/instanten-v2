---
import BlogPostPage from '../../../components/pages/BlogPostPage.astro';
import { getCollection } from 'astro:content';
import { nonDefaultLangs, type LangCode } from '../../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const paths: { params: { lang: LangCode; slug: string }; props: { post: any } }[] = [];
  for (const lang of nonDefaultLangs) {
    for (const post of posts) {
      paths.push({ params: { lang, slug: post.data.slug }, props: { post } });
    }
  }
  return paths;
}

const { post } = Astro.props as { post: any };
---

<BlogPostPage post={post} />

---
import ToolDetailPage from '../../../components/pages/ToolDetailPage.astro';
import { getCollection } from 'astro:content';

import { nonDefaultLangs, type LangCode } from '../../../i18n/ui';

/**
 * Chaar sensor tools (compass, bubble level, speedometer, Qibla) ke apne page
 * files hain — unke paas interactive island hai jo generic template se nahi
 * chalta, isliye generic [slug] route unko skip karta hai (warna duplicate
 * route banega).
 */
export async function getStaticPaths() {
  const DEDICATED = ['onlinecompass', 'onlinebubblelevel', 'onlinespeedometer', 'onlineqibla'];
  const tools = (await getCollection('tools')).filter((tool) => !DEDICATED.includes(tool.data.slug));
  const paths: { params: { lang: LangCode; slug: string }; props: { tool: any } }[] = [];
  for (const lang of nonDefaultLangs) {
    for (const tool of tools) {
      paths.push({ params: { lang, slug: tool.data.slug }, props: { tool } });
    }
  }
  return paths;
}

const { tool } = Astro.props as { tool: any };
---

<ToolDetailPage tool={tool} />

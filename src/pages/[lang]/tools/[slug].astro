---
import ToolDetailPage from '../../../components/pages/ToolDetailPage.astro';
import { getCollection } from 'astro:content';
import { nonDefaultLangs, type LangCode } from '../../../i18n/ui';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  const paths: { params: { lang: LangCode; slug: string }; props: { tool: any } }[] = [];
  for (const lang of nonDefaultLangs) {
    for (const tool of tools) {
      paths.push({ params: { lang, slug: tool.data.slug }, props: { tool } });
    }
  }
  return paths;
}

const { tool } = Astro.props as { tool: any };
---

<ToolDetailPage tool={tool} />

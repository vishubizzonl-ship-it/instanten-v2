---
import { getLangFromUrl, useTranslations, translatePathSafe } from '../i18n/utils';
import { localizeToolCategory } from '../i18n/toolContent';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const categories = [
  { slug: 'developer', label: 'Developer' },
  { slug: 'design', label: 'Design' },
  { slug: 'marketing', label: 'Marketing' },
  { slug: 'writing', label: 'Writing' },
  { slug: 'productivity', label: 'Productivity' },
  { slug: 'utility', label: 'Utility' },
] as const;
---
<div
  id="search-panel"
  hidden
  class="fixed top-[88px] right-4 z-[80] w-full max-w-[480px]"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-panel-title"
>
  <div
    data-search-backdrop
    class="fixed inset-0 bg-black/5 transition-opacity duration-200"
    aria-hidden="true"
  ></div>

  <div
    class="relative overflow-hidden rounded-2xl border border-border-hairline bg-surface shadow-float animate-in fade-in-0 zoom-in-95 duration-200 ease-out"
  >
    <div class="flex items-center justify-between border-b border-border-hairline px-6 py-4">
      <h2 id="search-panel-title" class="font-display font-semibold text-heading-md text-ink">
        {t('search.panel.title')}
      </h2>
      <button
        type="button"
        data-search-close
        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-muted transition-colors hover:bg-hairline-soft hover:text-ink"
        aria-label={t('search.panel.close')}
      >
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m5 5 10 10M15 5 5 15"></path>
        </svg>
      </button>
    </div>

    <form action={translatePathSafe('/search/', lang)} method="get" data-search-form class="p-6">
      <label for="search-input" class="sr-only">{t('nav.search')}</label>
      <div class="flex flex-col sm:flex-row items-stretch gap-3">
        <div class="relative flex-1">
          <input
            type="search"
            id="search-input"
            name="q"
            placeholder={t('search.placeholder')}
            class="w-full h-11 pl-4 pr-4 rounded-lg border border-border-hairline bg-surface text-body-lg text-ink placeholder:text-faint outline-none transition-colors focus:border-ink focus:ring-2 focus:ring-accent-soft"
            style="font-size: 16px"
            autocomplete="off"
            spellcheck="false"
            required
          />
        </div>
        <button type="submit" class="btn btn-primary shrink-0 w-full sm:w-auto px-6 h-11">
          {t('search.panel.submit')}
        </button>
      </div>
    </form>

    <div class="border-t border-border-hairline p-6">
      <p class="eyebrow mb-3">{t('search.panel.browse')}</p>
      <div class="flex flex-wrap gap-2">
        {categories.map((category) => (
          <a
            href={`${translatePathSafe('/search/', lang)}?category=${encodeURIComponent(category.label)}`}
            class="rounded-full border border-border-hairline bg-canvas px-3 py-1.5 text-caption font-medium text-body transition-colors hover:border-faint hover:text-ink"
          >
            {localizeToolCategory(lang, category.label)}
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  const panel = document.getElementById('search-panel');
  const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-search-open]'));
  const closeButton = panel?.querySelector<HTMLElement>('[data-search-close]');
  const backdrop = panel?.querySelector<HTMLElement>('[data-search-backdrop]');
  const input = panel?.querySelector<HTMLInputElement>('#search-input');
  let lastFocused: HTMLElement | null = null;

  function isOpen(): boolean {
    return Boolean(panel && !panel.hidden);
  }

  function open(event?: Event): void {
    if (!panel) return;
    event?.preventDefault();
    if (isOpen()) {
      input?.focus();
      return;
    }
    const drawer = document.getElementById('mobile-drawer');
    if (drawer && !drawer.hidden) {
      drawer.querySelector<HTMLElement>('[data-drawer-close]')?.click();
    }
    lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    panel.hidden = false;
    document.body.style.overflow = '';
    triggers.forEach((trigger) => trigger.setAttribute('aria-expanded', 'true'));
    const isMobile = window.innerWidth < 640;
    if (!isMobile) {
      window.setTimeout(() => input?.focus(), 40);
    }
  }

  function close(): void {
    if (!panel || !isOpen()) return;
    panel.hidden = true;
    document.body.style.overflow = '';
    triggers.forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));
    lastFocused?.focus();
  }

  triggers.forEach((trigger) => trigger.addEventListener('click', open));
  closeButton?.addEventListener('click', close);
  backdrop?.addEventListener('click', close);

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement | null;
    const isEditable =
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target instanceof HTMLSelectElement ||
      Boolean(target?.isContentEditable);

    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      isOpen() ? close() : open();
      return;
    }

    if (event.key === '/' && !isEditable && !event.metaKey && !event.ctrlKey && !event.altKey) {
      event.preventDefault();
      open();
      return;
    }

    if (event.key === 'Escape' && isOpen()) {
      close();
      return;
    }

    if (event.key === 'Tab' && isOpen() && panel) {
      const focusables = Array.from(
        panel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      ).filter((element) => !element.hasAttribute('hidden'));

      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });

  document.querySelector<HTMLElement>('[data-search-form]')?.addEventListener('submit', () => {
    document.body.style.overflow = '';
  });
</script>

<style>
  @media (max-width: 640px) {
    #search-panel {
      top: 88px;
      right: 0;
      left: 0;
      max-width: none;
      border-radius: 0;
      border-left: none;
      border-right: none;
    }
    #search-panel > div:last-child {
      border-radius: 0;
    }
  }
</style>
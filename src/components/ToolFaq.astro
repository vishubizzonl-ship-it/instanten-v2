---
/**
 * Tool page FAQ — visible accordion.
 *
 * JSON-LD alag se aata hai: ToolDetailPage yehi questions Layout ke `faqs`
 * prop mein deta hai, jisse SeoHead ek hi FAQPage entity banata hai. Is
 * component mein koi <script> nahi hai, taaki do FAQPage blocks na banein.
 */
interface Props {
  heading?: string;
  questions: { q: string; a: string }[];
}

const { heading = 'Frequently asked questions', questions } = Astro.props;
---

{
  questions.length > 0 && (
    <section class="mb-10" aria-labelledby="tool-faq-title" data-tool-faq>
      <h2
        id="tool-faq-title"
        class="font-display font-semibold text-body-lg text-ink mb-4 flex items-center gap-2"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-accent"
          aria-hidden="true"
        >
          <circle cx="10" cy="10" r="8" />
          <path d="M7.5 7.5a2.5 2.5 0 1 1 3.4 2.4c-.6.2-.9.8-.9 1.4v.4" />
          <path d="M10 14.5h.01" />
        </svg>
        {heading}
      </h2>
      <div class="flex flex-col border border-border-hairline rounded-card overflow-hidden bg-surface">
        {questions.map((item) => (
          <details class="group border-b border-border-hairline last:border-b-0">
            <summary class="flex items-center justify-between gap-3 cursor-pointer list-none px-5 py-4 font-medium text-body-md text-ink hover:bg-surface-soft transition-colors">
              <span>{item.q}</span>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                class="flex-shrink-0 text-muted transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p class="px-5 pb-4 text-body-md text-muted leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  )
}

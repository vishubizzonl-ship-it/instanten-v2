---
/**
 * Contact form — shared by every silo so all five contact pages behave the same.
 *
 * Do modes (dono me message asli me nikalta hai):
 *   - LIVE: `PUBLIC_WEB3FORMS_KEY` set ho → form khud Web3Forms par POST karta hai.
 *   - FALLBACK: key na ho → visitor ke mail app me poora message ready khulta hai.
 * Koi bhi mode "bhej diya" ka jhooth nahi bolta — logic src/lib/contactSubmit.ts me hai.
 */
import { getLangFromUrl } from '../i18n/utils';
import { contactFormCopy } from '../i18n/contactForm';
import {
  PUBLIC_EMAIL,
  DELIVERY_EMAIL,
  WEB3FORMS_ENDPOINT,
  WEB3FORMS_KEY,
  CONTACT_FORM_LIVE,
} from '../config/contact';

const lang = getLangFromUrl(Astro.url);
const copy = contactFormCopy[lang] ?? contactFormCopy.en;
const mailtoStatus = copy.status.replace('{email}', DELIVERY_EMAIL);
const messages = {
  sending: copy.sending,
  sent: copy.sent,
  mailto: mailtoStatus,
  error: copy.error,
};
---

<form
  id="contact-form"
  class="space-y-4"
  data-email={DELIVERY_EMAIL}
  data-endpoint={WEB3FORMS_ENDPOINT}
  data-key={WEB3FORMS_KEY}
  data-live={CONTACT_FORM_LIVE ? 'true' : 'false'}
  data-messages={JSON.stringify(messages)}
  action={`mailto:${DELIVERY_EMAIL}`}
  method="post"
  enctype="text/plain">
  <div>
    <label for="name" class="block text-sm font-medium text-ink mb-1">{copy.name}</label>
    <input id="name" name="name" type="text" required autocomplete="name" class="w-full rounded-md border border-hairline bg-canvas px-3 py-2 text-sm text-ink focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none" />
  </div>
  <div>
    <label for="email" class="block text-sm font-medium text-ink mb-1">{copy.email}</label>
    <input id="email" name="email" type="email" required autocomplete="email" class="w-full rounded-md border border-hairline bg-canvas px-3 py-2 text-sm text-ink focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none" />
  </div>
  <div>
    <label for="subject" class="block text-sm font-medium text-ink mb-1">{copy.subject}</label>
    <select id="subject" name="subject" class="w-full rounded-md border border-hairline bg-canvas px-3 py-2 text-sm text-ink focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none">
      {copy.options.map((option) => (
        <option>{option}</option>
      ))}
    </select>
  </div>
  <div>
    <label for="message" class="block text-sm font-medium text-ink mb-1">{copy.message}</label>
    <textarea id="message" name="message" rows="5" required class="w-full rounded-md border border-hairline bg-canvas px-3 py-2 text-sm text-ink focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none"></textarea>
  </div>
  <!-- Honeypot: bot bharega, insaan nahi dekhega. -->
  <input type="text" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" style="display:none" />
  <button type="submit" aria-busy="false" class="inline-flex items-center rounded-sm bg-ink text-canvas px-5 py-2 text-sm font-medium hover:opacity-90 transition-opacity focus-visible:ring-2 focus-visible:ring-link-soft focus-visible:outline-none disabled:opacity-60">
    {copy.submit}
  </button>
  <p id="contact-form-status" role="status" aria-live="polite" class="text-sm text-body leading-relaxed" hidden></p>
  <p id="contact-form-error" role="alert" class="text-sm text-danger leading-relaxed" hidden>{copy.error}</p>
  <p class="text-xs text-muted">
    Or email directly: <a href={`mailto:${PUBLIC_EMAIL}`} class="underline">{PUBLIC_EMAIL}</a>
  </p>
</form>

<script>
  import { wireContactForm } from '../lib/contactSubmit';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const messages = JSON.parse(form.dataset.messages || '{}');
    wireContactForm({
      form,
      statusEl: document.getElementById('contact-form-status'),
      errorEl: document.getElementById('contact-form-error'),
      messages: {
        sending: messages.sending || 'Sending…',
        sent: messages.sent || 'Message sent.',
        mailto: messages.mailto || 'Your email app is opening.',
        error: messages.error || 'Please fill in your name, email and message.',
      },
    });
  }
</script>

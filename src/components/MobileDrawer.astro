---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import GitHubIcon from './icons/GitHub.astro';
import TwitterIcon from './icons/Twitter.astro';
import LinkedInIcon from './icons/LinkedIn.astro';
import EmailIcon from './icons/Email.astro';

const navLinks = [
  { href: '/tools/', label: 'All tools' },
  { href: '/categories/', label: 'Categories' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/makers/', label: 'Makers' },
  { href: '/about/', label: 'About' },
] as const;

const categories = [
  { slug: 'utility', label: 'Utility' },
  { slug: 'developer', label: 'Developer' },
  { slug: 'design', label: 'Design' },
  { slug: 'marketing', label: 'Marketing' },
  { slug: 'writing', label: 'Writing' },
  { slug: 'productivity', label: 'Productivity' },
] as const;

const socialLinks = [
  { href: 'https://github.com/vishubizzonl-ship-it/instanten-v2', label: 'GitHub', icon: GitHubIcon },
  { href: 'https://twitter.com/instanten', label: 'X (Twitter)', icon: TwitterIcon },
  { href: 'https://linkedin.com/company/instanten', label: 'LinkedIn', icon: LinkedInIcon },
  { href: 'mailto:hello@instanten.com', label: 'Email', icon: EmailIcon },
] as const;
---
<div id="mobile-drawer" class="cs-offcanvas fixed inset-y-0 left-0 z-[75] lg:hidden flex flex-col" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
  <div class="cs-offcanvas__header grid grid-cols-[1fr_40px] items-center border-b border-border-hairline px-6 py-4 min-h-[88px]">
    <div class="cs-logo flex">
      <Logo size="md" />
    </div>
    <nav class="cs-offcanvas__nav flex items-center justify-center w-10 h-10" aria-label="Close menu">
      <button
        type="button"
        data-menu-close
        class="cs-offcanvas__toggle inline-flex items-center justify-center text-muted transition-colors hover:text-ink"
        aria-label="Close menu"
      >
        <svg class="cs-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </nav>
  </div>

  <aside class="cs-offcanvas__sidebar flex-1 overflow-x-hidden overflow-y-auto">
    <div class="cs-offcanvas__inner flex flex-col h-full p-6">
      <h2 id="drawer-title" class="sr-only">Site menu</h2>

      <div class="cs-offcanvas__button mb-6">
        <a href="/submit/" data-menu-link class="btn btn-primary w-full inline-flex items-center justify-center">
          Submit a Tool
        </a>
      </div>

      <nav aria-label="Mobile navigation" class="mb-6">
        <ul class="space-y-1" role="list">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                data-menu-link
                class="flex min-h-11 items-center rounded-md px-3 py-2.5 text-body-md font-medium text-body transition-colors hover:bg-hairline-soft hover:text-ink"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mb-6">
        <h3 class="eyebrow mb-3">Browse by category</h3>
        <ul class="space-y-1.5" role="list">
          {categories.map((cat) => (
            <li>
              <a
                href={`/category/${cat.slug}/`}
                data-menu-link
                class="flex min-h-10 items-center rounded-md px-3 py-2 text-body-sm text-body transition-colors hover:bg-hairline-soft hover:text-ink"
              >
                {cat.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </aside>

  <div class="cs-offcanvas__bottombar flex items-center justify-between border-t border-border-hairline pt-4 px-6">
    <div class="flex items-center gap-2" role="list" aria-label="Social links">
      {socialLinks.map((social) => (
        <a
          href={social.href}
          data-menu-link
          class="cs-social__link inline-flex h-10 w-10 items-center justify-center rounded-full border border-border-hairline bg-surface text-body transition-colors hover:border-faint hover:text-ink"
          aria-label={social.label}
          target={'href' in social && social.href.startsWith('http') ? '_blank' : undefined}
          rel={'href' in social && social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          <social.icon />
        </a>
      ))}
    </div>
    <div class="cs-offcanvas__scheme-toggle">
      <ThemeToggle />
    </div>
  </div>
</div>

<div id="site-overlay" class="cs-site-overlay fixed inset-0 bg-black/45 z-[74] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300" aria-hidden="true"></div>

<script>
  const drawer = document.getElementById('mobile-drawer');
  const overlay = document.getElementById('site-overlay');
  const closeButton = drawer?.querySelector<HTMLElement>('[data-menu-close]');
  let lastFocused: HTMLElement | null = null;

  function isOpen(): boolean {
    return document.body.classList.contains('cs-offcanvas-active');
  }

  function open(event?: Event): void {
    event?.preventDefault();
    if (isOpen()) return;

    const searchPanel = document.getElementById('search-panel');
    if (searchPanel && !searchPanel.hidden) {
      searchPanel.querySelector<HTMLElement>('[data-search-close]')?.click();
    }

    lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    document.body.classList.add('cs-offcanvas-active');
    document.body.style.overflow = 'hidden';
    document.querySelectorAll<HTMLElement>('[data-menu-open]').forEach((trigger) => trigger.setAttribute('aria-expanded', 'true'));
    window.setTimeout(() => closeButton?.focus(), 180);
  }

  function close(): void {
    if (!isOpen()) return;
    document.body.classList.remove('cs-offcanvas-active');
    document.body.style.overflow = '';
    document.querySelectorAll<HTMLElement>('[data-menu-open]').forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));
    lastFocused?.focus();
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const openTrigger = target.closest('[data-menu-open]');
    const closeTrigger = target.closest('[data-menu-close]');
    const link = target.closest('[data-menu-link]');

    if (openTrigger) {
      open(event);
    } else if (closeTrigger || overlay === target || link) {
      close();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (!isOpen()) return;

    if (event.key === 'Escape') {
      close();
      return;
    }

    if (event.key === 'Tab' && drawer) {
      const focusables = Array.from(
        drawer.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      ).filter((element) => !element.hasAttribute('hidden'));

      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (event.matches && isOpen()) {
      document.body.classList.remove('cs-offcanvas-active');
      document.body.style.overflow = '';
      document.querySelectorAll<HTMLElement>('[data-menu-open]').forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));
    }
  });

  const toggleIcon = drawer?.querySelector<HTMLElement>('.cs-offcanvas__toggle .cs-icon');
  const closeBtn = drawer?.querySelector<HTMLElement>('[data-menu-close]');
  if (toggleIcon && closeBtn) {
    closeBtn.addEventListener('mouseenter', () => {
      toggleIcon.style.transform = 'rotate(180deg)';
    });
    closeBtn.addEventListener('mouseleave', () => {
      toggleIcon.style.transform = 'rotate(0deg)';
    });
  }
</script>

<style>
  .cs-offcanvas {
    --cs-offcanvas-width: 100%;
    transform: translateX(-100%);
    transition: transform 0.4s ease;
    width: 100%;
    height: 100vh;
    background: var(--surface);
  }

  @media (min-width: 768px) {
    .cs-offcanvas {
      --cs-offcanvas-width: 33.5rem;
      transform: translateX(-100%);
    }
  }

  :global(.cs-offcanvas-active) .cs-offcanvas {
    transform: translateX(0);
  }

  :global(.cs-offcanvas-active) .cs-site-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .cs-offcanvas__toggle .cs-icon {
    transition: transform 0.25s ease;
  }
</style>
---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import TwitterIcon from './icons/Twitter.astro';
import YouTubeIcon from './icons/YouTube.astro';
import InstagramIcon from './icons/Instagram.astro';
import TelegramIcon from './icons/Telegram.astro';
import GitHubIcon from './icons/GitHub.astro';
import EmailIcon from './icons/Email.astro';

const navLinks = [
  { href: '/tools/', label: 'All tools' },
  { href: '/categories/', label: 'Categories' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/makers/', label: 'Makers' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
  { href: '/contact/', label: 'Contact' },
  { href: '/privacy-policy/', label: 'Privacy Policy' },
  { href: '/terms/', label: 'Terms' },
] as const;

const categories = [
  { slug: 'utility', label: 'Utility' },
  { slug: 'developer', label: 'Developer' },
  { slug: 'design', label: 'Design' },
  { slug: 'marketing', label: 'Marketing' },
  { slug: 'writing', label: 'Writing' },
  { slug: 'productivity', label: 'Productivity' },
] as const;

const socialLinks = [
  { href: 'https://www.youtube.com/@instanten', label: 'YouTube', icon: YouTubeIcon, hidden: true },
  { href: 'https://x.com/instanten', label: 'X (Twitter)', icon: TwitterIcon },
  { href: 'https://www.instagram.com/instanten/', label: 'Instagram', icon: InstagramIcon },
  { href: 'https://t.me/instanten', label: 'Telegram', icon: TelegramIcon },
  { href: 'https://www.youtube.com/@instanten', label: 'YouTube', icon: YouTubeIcon },
  { href: 'https://github.com/instanten', label: 'GitHub', icon: GitHubIcon },
  { href: 'mailto:hello@instanten.com', label: 'Email', icon: EmailIcon },
] as const;
---
<div id="mobile-drawer" data-drawer-panel class="cs-offcanvas fixed inset-y-0 left-0 z-[100] lg:hidden flex flex-col" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
  <div class="cf-drawer-topbar">
    <div class="cf-drawer-brand-link" data-site-logo="true">
      <Logo />
    </div>
    <button
      type="button"
      class="cf-drawer-close-btn"
      data-drawer-close
      aria-label="Close navigation menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <aside data-drawer-body class="cs-offcanvas__sidebar flex-1 overflow-x-hidden overflow-y-auto" style="flex: 1 1 auto; display: flex; flex-direction: column; padding: 24px 24px 20px 24px;">
    <h2 id="drawer-title" class="sr-only">Site menu</h2>

    <div class="cs-offcanvas__button" style="margin-bottom: 24px;">
      <a href="/submit/" data-menu-link class="btn btn-primary w-full inline-flex items-center justify-center" style="padding: 10px 18px; border-radius: 8px;">
        Submit a Tool
      </a>
    </div>

    <nav aria-label="Mobile navigation" style="margin-bottom: 24px;">
      <h3 class="cs-offcanvas__section-title" style="font-family: var(--font-display); font-size: 12px; font-weight: 800; line-height: 1.2; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin: 0 0 16px 0;">ARCHIVES</h3>
      <ul class="cs-offcanvas__list" role="list" style="list-style: none; padding: 0; margin: 0;">
        {navLinks.map((link, index) => (
          <li style="font-family: var(--font-display); font-size: 16px; font-weight: 800; line-height: 1.2; letter-spacing: -0.03em; padding-bottom: 12px; color: var(--ink);" data-last={index === navLinks.length - 1}>
            <a
              href={link.href}
              data-menu-link
              class="cs-offcanvas__link flex min-h-11 items-center rounded-md px-3 py-2.5 text-body transition-colors hover:text-muted"
              style="font-family: var(--font-display); font-size: 16px; font-weight: 800; line-height: 1.2; letter-spacing: -0.03em; text-decoration: none; color: var(--ink);"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div style="margin-bottom: 24px;">
      <h3 class="cs-offcanvas__section-title" style="font-family: var(--font-display); font-size: 12px; font-weight: 800; line-height: 1.2; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin: 0 0 16px 0;">CATEGORIES</h3>
      <ul class="cs-offcanvas__list" role="list" style="list-style: none; padding: 0; margin: 0;">
        {categories.map((cat, index) => (
          <li style="font-family: var(--font-display); font-size: 16px; font-weight: 800; line-height: 1.2; letter-spacing: -0.03em; padding-bottom: 12px; color: var(--ink);" data-last={index === categories.length - 1}>
            <a
              href={`/category/${cat.slug}/`}
              data-menu-link
              class="cs-offcanvas__link flex min-h-10 items-center rounded-md px-3 py-2 text-body transition-colors hover:text-muted"
              style="font-family: var(--font-display); font-size: 16px; font-weight: 800; line-height: 1.2; letter-spacing: -0.03em; text-decoration: none; color: var(--ink);"
            >
              {cat.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </aside>

  <div data-drawer-footer class="cs-offcanvas__bottombar" role="list" aria-label="Social links and theme">
    <div class="cs-offcanvas__bottombar-inner">
      {socialLinks.map((social) => (
        <a
          href={social.href}
          data-menu-link
          class="cs-social__link inline-flex items-center justify-center rounded-full"
          aria-label={social.label}
          target={'href' in social && social.href.startsWith('http') ? '_blank' : undefined}
          rel={'href' in social && social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          style={('hidden' in social && social.hidden) ? 'opacity: 0; pointer-events: none; width: 40px; height: 40px;' : ''}
        >
          <social.icon size={24} style="fill: currentColor;" />
        </a>
      ))}
      <div class="cs-offcanvas__scheme-toggle flex-shrink-0">
        <ThemeToggle showLeftDivider={false} />
      </div>
    </div>
  </div>
</div>

<div id="site-overlay" data-drawer-backdrop class="cs-site-overlay fixed inset-0 z-[99] lg:hidden opacity-0 pointer-events-none transition-opacity duration-300" aria-hidden="true" style="background: rgba(0, 0, 0, 0.3);"></div>

<script>
  const drawer = document.getElementById('mobile-drawer');
  const overlay = document.getElementById('site-overlay');
  const closeButton = drawer?.querySelector<HTMLElement>('[data-drawer-close]');
  let lastFocused: HTMLElement | null = null;

  // Ensure Drawer & Backdrop are direct children of document.body so no ancestor
  // stacking context (sticky/backdrop-filter header) can trap them below the Top Bar.
  if (overlay && overlay.parentElement !== document.body) document.body.appendChild(overlay);
  if (drawer && drawer.parentElement !== document.body) document.body.appendChild(drawer);

  function isOpen(): boolean {
    return document.body.classList.contains('cs-offcanvas-active');
  }

  function open(event?: Event): void {
    event?.preventDefault();
    if (isOpen()) return;

    const searchPanel = document.getElementById('search-panel');
    if (searchPanel && !searchPanel.hidden) {
      searchPanel.querySelector<HTMLElement>('[data-search-close]')?.click();
    }

    lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    document.body.classList.add('cs-offcanvas-active');
    document.documentElement.style.overflow = 'hidden';
    document.querySelectorAll<HTMLElement>('[data-menu-open]').forEach((trigger) => trigger.setAttribute('aria-expanded', 'true'));
    window.setTimeout(() => closeButton?.focus(), 180);
  }

  function close(): void {
    if (!isOpen()) return;
    document.body.classList.remove('cs-offcanvas-active');
    document.documentElement.style.overflow = '';
    document.querySelectorAll<HTMLElement>('[data-menu-open]').forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));
    lastFocused?.focus();
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const openTrigger = target.closest('[data-menu-open]');
    const closeTrigger = target.closest('[data-drawer-close]');
    const link = target.closest('[data-menu-link]');

    if (openTrigger) {
      open(event);
    } else if (closeTrigger || overlay === target || link) {
      close();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (!isOpen()) return;

    if (event.key === 'Escape') {
      close();
      return;
    }

    if (event.key === 'Tab' && drawer) {
      const focusables = Array.from(
        drawer.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      ).filter((element) => !element.hasAttribute('hidden'));

      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (event.matches && isOpen()) {
      document.body.classList.remove('cs-offcanvas-active');
      document.documentElement.style.overflow = '';
      document.querySelectorAll<HTMLElement>('[data-menu-open]').forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));
    }
  });

  // STRICT NO-SPIN RULE: Force disable any rotation/transform on close button
  const closeBtn = drawer?.querySelector<HTMLElement>('[data-drawer-close]');
  const closeIcon = closeBtn?.querySelector<SVGElement>('svg');
  if (closeBtn && closeIcon) {
    const lockNoSpin = () => {
      closeBtn.style.transform = 'none';
      closeBtn.style.rotate = '0deg';
      closeBtn.style.animation = 'none';
      closeIcon.style.transform = 'none';
      closeIcon.style.rotate = '0deg';
      closeIcon.style.animation = 'none';
    };
    // Lock on all possible states
    ['mouseenter', 'mouseleave', 'mousedown', 'mouseup', 'focus', 'blur', 'click'].forEach(evt => {
      closeBtn.addEventListener(evt, lockNoSpin);
    });
    // Initial lock
    lockNoSpin();
  }
</script>

<style>
  .cs-offcanvas {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    height: 100dvh;
    z-index: 100;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    --cs-offcanvas-width: 100%;
    transform: translateX(-100%);
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    width: 100%;
    max-width: 100%;
  }

  @media (min-width: 576px) {
    .cs-offcanvas {
      --cs-offcanvas-width: 432px;
      width: 432px;
      max-width: 432px;
      transform: translateX(-100%);
    }
  }

  @media (min-width: 1248px) {
    .cs-offcanvas {
      --cs-offcanvas-width: 432px;
      width: 432px;
      max-width: 432px;
      transform: translateX(-100%);
    }
  }

  :global(.cs-offcanvas-active) .cs-offcanvas {
    transform: translateX(0);
  }

  :global(.cs-offcanvas-active) .cs-site-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .cs-offcanvas__header {
    display: grid;
    grid-template-columns: 1fr 40px;
    align-items: center;
    min-height: 88px;
    border-bottom: 1px solid var(--hairline);
  }

  .cs-offcanvas__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
  }

  .cs-offcanvas__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--muted);
    transition: color 0.2s ease !important;
    transform: none !important;
    rotate: 0deg !important;
    animation: none !important;
  }

  .cs-offcanvas__close:hover,
  .cs-offcanvas__close:active,
  .cs-offcanvas__close:focus,
  .cs-offcanvas__close:focus-visible {
    color: var(--ink) !important;
    background: transparent !important;
    transform: none !important;
    rotate: 0deg !important;
    animation: none !important;
  }

  .cs-offcanvas__close .cs-icon {
    transform: none !important;
    rotate: 0deg !important;
    animation: none !important;
    transition: color 0.2s ease !important;
  }

  .cs-offcanvas__close:hover .cs-icon,
  .cs-offcanvas__close:active .cs-icon,
  .cs-offcanvas__close:focus .cs-icon {
    transform: none !important;
    rotate: 0deg !important;
    animation: none !important;
  }

  .cs-offcanvas__sidebar {
    flex: 1 1 auto;
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .cs-offcanvas__inner {
    padding: 24px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .cs-offcanvas__button {
    margin-bottom: 24px;
  }

  .cs-offcanvas__section-title {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 16px 0;
  }

  .cs-offcanvas__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cs-offcanvas__list li {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    padding-bottom: 12px;
    color: var(--ink);
  }

  .cs-offcanvas__list li:last-child {
    padding-bottom: 0;
  }

  .cs-offcanvas__link {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-decoration: none;
    color: var(--ink);
    transition: color 0.25s ease;
  }

  .cs-offcanvas__link:hover {
    color: var(--muted);
  }

  .cs-offcanvas__bottombar {
    position: sticky;
    bottom: 0;
    margin-top: auto;
    border-top: 1px solid var(--hairline);
    background: var(--surface);
    padding: 12px 16px;
    padding-bottom: max(12px, env(safe-area-inset-bottom));
  }

  .cs-offcanvas__bottombar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
  }

  @media (min-width: 1248px) {
    .cs-offcanvas__header {
      padding: 2.5rem;
    }

    .cs-offcanvas__inner {
      padding: 2.5rem;
    }

    .cs-offcanvas__bottombar {
      margin-left: -2.5rem;
      margin-right: -2.5rem;
      padding: 2.5rem 2.5rem 0 2.5rem;
    }
  }

  .cs-social__link {
    display: flex;
    justify-content: center;
    align-items: center;
    text-decoration: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--ink);
    transition: opacity 0.25s ease, background-color 0.25s ease;
  }

  .cs-social__link:hover {
    opacity: 0.7;
    background-color: var(--hairline-soft);
  }

  .cs-social__link svg {
    width: 24px !important;
    height: 24px !important;
    transition: fill 0.25s ease;
  }

  .cs-social__link svg path {
    fill: currentColor;
  }
</style>
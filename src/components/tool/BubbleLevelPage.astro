---
const DICT: Record<string, string> = {
  "bubble.ui.bullseye": "Bubble level",
  "bubble.ui.calibrated": "Calibrated",
  "compass.how.title": "How to use",
  "page.bubble.how.calibrate": "Calibrate",
  "page.bubble.how.calibrate.desc": "If the reading drifts, recalibrate on a known level surface.",
  "page.bubble.how.enable": "Place on surface",
  "page.bubble.how.enable.desc": "Put the device flat on the surface you want to check. The bubble moves with tilt.",
  "page.bubble.how.offline": "Offline use",
  "page.bubble.how.offline.desc": "Works without a network connection once loaded.",
  "page.bubble.title": "Bubble Level"  
};
const t = (key: string) => DICT[key] ?? key;
---


  
  
    <section class="py-4 lg:py-8 pt-2 lg:pt-4" aria-label={t('page.bubble.title')}>
      <div class="mx-auto max-w-5xl px-6 lg:px-8">
        <div id="bubble-card" class="bg-canvas-elevated border border-hairline rounded-md p-6 lg:p-8 shadow-[0px_1px_2px_rgba(0,0,0,0.03)] relative">
          <button type="button" id="bubble-fullscreen-btn" aria-label="Fullscreen" class="absolute top-3 right-3 z-30 inline-flex items-center justify-center w-8 h-8 rounded-sm bg-canvas border border-hairline text-ink hover:bg-canvas-elevated transition-colors">
            <svg class="icon-enter" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            <svg class="icon-exit hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"/></svg>
          </button>
          <div class="text-center mb-1">
            <h2 class="font-sans text-xl font-semibold tracking-tight text-ink">{t('bubble.ui.bullseye')}</h2>
            <p id="bubble-status" class="text-xs text-mute font-mono mt-1" role="status" aria-live="polite">{t('bubble.ui.calibrated')}</p>
          </div>

          <div class="flex flex-col items-center gap-2 py-6">
            <div class="flex items-center gap-6 text-xs font-mono tabular-nums text-ink" aria-live="polite">
              <span>X: <span id="bubble-x" class="font-semibold">0.0°</span></span>
              <span>Y: <span id="bubble-y" class="font-semibold">0.0°</span></span>
            </div>
            <div
              id="bubble-area"
              class="relative w-[260px] h-[260px] sm:w-[300px] sm:h-[300px] bg-canvas-elevated border border-hairline shadow-[inset_0_3px_10px_rgba(0,0,0,0.12),0_1px_2px_rgba(0,0,0,0.04)] overflow-hidden bubble-area"
              aria-label="Spirit level"
            >
              <div class="absolute left-1/2 top-0 bottom-0 w-[2px] crosshair -translate-x-1/2"></div>
              <div class="absolute top-1/2 left-0 right-0 h-[2px] crosshair -translate-y-1/2"></div>
              <div class="absolute bottom-0 left-0 right-0 h-[1px] edge-line"></div>
              <div class="absolute top-0 bottom-0 right-0 w-[1px] edge-line"></div>
              <div
                id="bubble-dot"
                class="absolute top-1/2 left-1/2 w-3 h-3 rounded-full bg-ink shadow-md pointer-events-none z-20"
                style="transform: translate(-50%, -50%);"
              ></div>
            </div>
          </div>

          <p id="bubble-message" class="text-xs text-body font-mono mt-3 text-center" role="alert" aria-live="assertive"></p>
        </div>
      </div>
    </section>
  <style>
    .bubble-area {
      background-image: linear-gradient(to right, rgba(0, 0, 0, 0.9) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0, 0, 0, 0.9) 1px, transparent 1px);
      background-size: 10% 10%;
    }
    html.dark .bubble-area {
      background-image: linear-gradient(to right, rgba(255, 255, 255, 0.9) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.9) 1px, transparent 1px);
      background-size: 10% 10%;
    }
    .crosshair {
      background-color: rgba(0, 0, 0, 0.9);
    }
    html.dark .crosshair {
      background-color: rgba(255, 255, 255, 0.9);
    }
    .edge-line {
      background-color: rgba(0, 0, 0, 0.9);
    }
    html.dark .edge-line {
      background-color: rgba(255, 255, 255, 0.9);
    }
  </style>
    <section class="py-16 lg:py-24" aria-label={t('compass.how.title')}>
      <div class="mx-auto max-w-[48rem] px-6 lg:px-8">
        <h2 class="font-sans text-2xl font-semibold tracking-tight text-ink mb-8">{t('compass.how.title')}</h2>
        <div class="space-y-8">
          <article class="border-l-2 border-hairline pl-6">
            <h3 class="font-sans text-base font-semibold text-ink mb-2">{t('page.bubble.how.enable')}</h3>
            <p class="text-sm text-body leading-relaxed">{t('page.bubble.how.enable.desc')}</p>
          </article>
          <article class="border-l-2 border-hairline pl-6">
            <h3 class="font-sans text-base font-semibold text-ink mb-2">{t('page.bubble.how.calibrate')}</h3>
            <p class="text-sm text-body leading-relaxed">{t('page.bubble.how.calibrate.desc')}</p>
          </article>
          <article class="border-l-2 border-hairline pl-6">
            <h3 class="font-sans text-base font-semibold text-ink mb-2">{t('page.bubble.how.offline')}</h3>
            <p class="text-sm text-body leading-relaxed">{t('page.bubble.how.offline.desc')}</p>
          </article>
        </div>
      </div>
    </section>
  
  
  

<script>
  (function () {
    const area = document.getElementById('bubble-area');
    const card = document.getElementById('bubble-card');
    const fsBtn = document.getElementById('bubble-fullscreen-btn');
    function syncFsIcon() {
      if (!fsBtn) return;
      const entering = !document.fullscreenElement;
      fsBtn.querySelector('.icon-enter')?.classList.toggle('hidden', !entering);
      fsBtn.querySelector('.icon-exit')?.classList.toggle('hidden', entering);
    }
    if (fsBtn) {
      fsBtn.addEventListener('click', () => {
        if (document.fullscreenElement) document.exitFullscreen();
        else if (card && card.requestFullscreen) card.requestFullscreen();
      });
      document.addEventListener('fullscreenchange', syncFsIcon);
      syncFsIcon();
    }
    const dot = document.getElementById('bubble-dot');
    const xEl = document.getElementById('bubble-x');
    const yEl = document.getElementById('bubble-y');
    const statusEl = document.getElementById('bubble-status');
    const messageEl = document.getElementById('bubble-message');

    const SCALE = 3; // px per degree
    const LEVEL_TOL = 3; // degrees

    function getScreenAngle() {
      try {
        if (window.screen && window.screen.orientation && typeof window.screen.orientation.angle === 'number') {
          return window.screen.orientation.angle;
        }
      } catch (e) {}
      if (typeof window.orientation === 'number') {
        return (window.orientation + 360) % 360;
      }
      return 0;
    }
    let running = false;
    let smoothX = 0;
    let smoothY = 0;
    let targetX = 0;
    let targetY = 0;
    let rafId: number | null = null;

    function setMessage(msg: string) {
      if (messageEl) messageEl.textContent = msg;
    }

    function setStatus(msg: string) {
      if (statusEl) statusEl.textContent = msg;
    }

    function getMaxTravel() {
      if (!area || !dot) return 100;
      const rect = area.getBoundingClientRect();
      const dotSize = dot.getBoundingClientRect().width || 24;
      return Math.min(rect.width, rect.height) / 2 - dotSize / 2 - 4;
    }

    function clampToSquare(x: number, y: number) {
      const maxTravel = getMaxTravel();
      return {
        x: Math.max(-maxTravel, Math.min(maxTravel, x)),
        y: Math.max(-maxTravel, Math.min(maxTravel, y)),
      };
    }

    function updateDot() {
      smoothX += (targetX - smoothX) * 0.15;
      smoothY += (targetY - smoothY) * 0.15;
      if (dot) {
        dot.style.transform = `translate(calc(-50% + ${smoothX.toFixed(1)}px), calc(-50% + ${smoothY.toFixed(1)}px))`;
      }
      rafId = requestAnimationFrame(updateDot);
    }

    function handleOrientation(event: DeviceOrientationEvent) {
      if (!running) return;
      const beta = typeof event.beta === 'number' ? event.beta : 0;
      const gamma = typeof event.gamma === 'number' ? event.gamma : 0;

      const tiltX = Math.max(-60, Math.min(60, gamma));
      const tiltY = Math.max(-60, Math.min(60, beta));

      const rawX = tiltX * SCALE;
      const rawY = tiltY * SCALE;
      const clamped = clampToSquare(rawX, rawY);
      targetX = clamped.x;
      targetY = clamped.y;

      if (xEl) xEl.textContent = tiltX.toFixed(1) + '°';
      if (yEl) yEl.textContent = tiltY.toFixed(1) + '°';

      if (Math.abs(tiltX) <= LEVEL_TOL && Math.abs(tiltY) <= LEVEL_TOL) {
        setStatus('Level');
      } else if (running) {
        setStatus('Tilt to level');
      }
    }

    async function start() {
      if (running) return;
      if (!window.isSecureContext) {
        setMessage('Sensor access requires HTTPS or localhost.');
        return;
      }
      if (!window.DeviceOrientationEvent) {
        setMessage('Device orientation sensor is not supported on this device.');
        return;
      }
      if (typeof (DeviceOrientationEvent as any).requestPermission === 'function') {
        try {
          const res = await (DeviceOrientationEvent as any).requestPermission();
          if (res !== 'granted') {
            setMessage('Permission denied. Enable motion sensors in browser settings.');
            return;
          }
        } catch {
          setMessage('Permission request failed. Tap again to retry.');
          return;
        }
      }
      running = true;
      setStatus('Tilt to level');
      setMessage('');
      window.addEventListener('deviceorientation', handleOrientation);
      if (rafId === null) rafId = requestAnimationFrame(updateDot);
    }

    function stop() {
      running = false;
      window.removeEventListener('deviceorientation', handleOrientation);
      targetX = 0;
      targetY = 0;
      setStatus('Stopped');
    }

    // auto-start; allow tap to retry if permission failed
    start();
    if (area) area.addEventListener('click', () => { if (!running) start(); });

    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (dot) dot.style.transition = 'none';
    }
  })();
</script>
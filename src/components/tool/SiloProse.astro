---
interface Props {
  html: string;
}
const { html } = Astro.props;
---
<div class="cs-silo-prose site-container max-w-[64rem] pb-16 pt-8" set:html={html} />

<style is:global>
  .cs-silo-prose h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 2.5rem 0 0.75rem;
  }
  .cs-silo-prose h1 {
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--ink);
  }
  .cs-silo-prose p {
    color: var(--body);
    font-size: 1rem;
    line-height: 1.75;
    margin: 0 0 1rem;
  }
  .cs-silo-prose p.lead {
    font-size: 1.125rem;
    border-left: 3px solid #9fe870;
    padding-left: 1rem;
    margin-bottom: 2rem;
  }
  .cs-silo-prose p.meta {
    font-size: 0.75rem;
    color: var(--muted);
    font-family: var(--font-mono);
    margin-top: 2.5rem;
  }
  .cs-silo-prose ul,
  .cs-silo-prose ol {
    color: var(--body);
    line-height: 1.75;
    margin: 0 0 1.25rem;
    padding-left: 1.35rem;
  }
  .cs-silo-prose ul { list-style: disc; }
  .cs-silo-prose ol { list-style: decimal; }
  .cs-silo-prose li { margin-bottom: 0.4rem; }
  .cs-silo-prose a {
    color: var(--accent-deep);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cs-silo-prose strong { color: var(--ink); font-weight: 600; }
  .cs-silo-prose code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--surface-soft);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  .cs-silo-prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    margin: 0 0 1.5rem;
  }
  .cs-silo-prose th {
    text-align: left;
    font-weight: 600;
    color: var(--ink);
    border-bottom: 1px solid var(--hairline);
    padding: 0.6rem 0.75rem;
    background: var(--surface-soft);
  }
  .cs-silo-prose td {
    color: var(--body);
    border-bottom: 1px solid var(--hairline);
    padding: 0.6rem 0.75rem;
  }
</style>

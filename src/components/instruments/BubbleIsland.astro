---
import { getLangFromUrl } from '../../i18n/utils';
import { instrumentUi } from '../../i18n/instruments/ui';

const lang = getLangFromUrl(Astro.url);
const ui = instrumentUi[lang] ?? instrumentUi.en;
---

<section id="tool" data-tool-root="onlinebubblelevel" class="py-4 lg:py-8 pt-2 lg:pt-4" aria-label={ui['page.bubble.title']}>
      <div class="mx-auto max-w-5xl sm:px-2 lg:px-0">
        <div id="bubble-card" data-msg-level={ui['bubble.page.level']} data-msg-tilt={ui['bubble.page.tilt']} data-msg-stopped={ui['bubble.page.stopped']} data-msg-https={ui['bubble.page.https']} data-msg-unsupported={ui['bubble.page.unsupported']} data-msg-denied={ui['bubble.page.denied']} data-msg-retry={ui['bubble.page.retry']} class="bg-surface border border-hairline rounded-md p-6 lg:p-8 shadow-[0px_1px_2px_rgba(0,0,0,0.03)] relative [&:fullscreen]:flex [&:fullscreen]:flex-col [&:fullscreen]:items-center [&:fullscreen]:justify-center [&:fullscreen]:w-full [&:fullscreen]:h-full [&:fullscreen]:overflow-auto">
          <button type="button" id="bubble-fullscreen-btn" aria-label={ui['bubble.page.fullscreen']} class="absolute top-3 right-3 z-30 inline-flex items-center justify-center w-8 h-8 rounded-sm bg-canvas border border-hairline text-ink hover:bg-surface transition-colors">
            <svg class="icon-enter" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            <svg class="icon-exit hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"/></svg>
          </button>
          <div class="text-center mb-1">
            <h2 class="font-display text-xl font-semibold tracking-tight text-ink">{ui['bubble.ui.bullseye']}</h2>
            <p id="bubble-status" class="text-xs text-muted font-mono mt-1" role="status" aria-live="polite">{ui['bubble.ui.calibrated']}</p>
          </div>

          <div class="flex flex-col items-center gap-2 py-6">
            <div class="flex items-center gap-6 text-xs font-mono tabular-nums text-ink" aria-live="polite">
              <span>X: <span id="bubble-x" class="font-semibold">0.0°</span></span>
              <span>Y: <span id="bubble-y" class="font-semibold">0.0°</span></span>
            </div>
            <!-- Calibration used to be promised in the copy with no control behind it.
                 These two buttons make the "recalibrate on a known surface" step real. -->
            <div class="flex items-center gap-2">
              <button type="button" id="bubble-calibrate-btn" data-calibrated={ui['bubble.ui.calibrated']} class="inline-flex items-center rounded-[var(--radius-btn)] bg-canvas border border-hairline text-ink text-xs font-medium px-3 py-1.5 hover:bg-surface transition-colors focus-visible:ring-2 focus-visible:ring-accent-soft focus-visible:outline-none">
                {ui['bubble.ui.calibrate']}
              </button>
              <button type="button" id="bubble-reset-btn" class="inline-flex items-center rounded-[var(--radius-btn)] bg-transparent border border-hairline text-body text-xs font-medium px-3 py-1.5 hover:text-ink transition-colors focus-visible:ring-2 focus-visible:ring-accent-soft focus-visible:outline-none">
                {ui['bubble.page.reset']}
              </button>
            </div>
            <div
              id="bubble-area"
              class="relative w-full max-w-[300px] aspect-square bg-surface border border-hairline shadow-[inset_0_3px_10px_rgba(0,0,0,0.12),0_1px_2px_rgba(0,0,0,0.04)] overflow-hidden bg-[linear-gradient(to_right,rgba(0,0,0,0.9)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,0,0,0.9)_1px,transparent_1px)] [background-size:10%_10%] dark:bg-[linear-gradient(to_right,rgba(255,255,255,0.9)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.9)_1px,transparent_1px)]"
              aria-label={ui['bubble.page.spirit']}
            >
              <div class="absolute left-1/2 top-0 bottom-0 w-[2px] bg-ink -translate-x-1/2"></div>
              <div class="absolute top-1/2 left-0 right-0 h-[2px] bg-ink -translate-y-1/2"></div>
              <div class="absolute bottom-0 left-0 right-0 h-[1px] bg-ink"></div>
              <div class="absolute top-0 bottom-0 right-0 w-[1px] bg-ink"></div>
              <div
                id="bubble-dot"
                class="absolute top-1/2 left-1/2 w-3 h-3 rounded-[var(--radius-btn)] bg-ink shadow-md pointer-events-none z-20"
                style="transform: translate(-50%, -50%);"
              ></div>
            </div>
          </div>

          <p id="bubble-message" class="text-xs text-body font-mono mt-3 text-center" role="alert" aria-live="assertive"></p>
        </div>
      </div>
    </section>
<script>
  (function () {
    const area = document.getElementById('bubble-area');
    const card = document.getElementById('bubble-card');

    // Every runtime sentence comes from the page, so the widget speaks the
    // same language as the copy around it.
    const msg = {
      level: card?.dataset.msgLevel || 'Level',
      tilt: card?.dataset.msgTilt || 'Tilt to level',
      stopped: card?.dataset.msgStopped || 'Stopped',
      https: card?.dataset.msgHttps || 'Sensor access requires HTTPS or localhost.',
      unsupported: card?.dataset.msgUnsupported || 'Device orientation sensor is not supported on this device.',
      denied: card?.dataset.msgDenied || 'Permission denied. Enable motion sensors in browser settings.',
      retry: card?.dataset.msgRetry || 'Permission request failed. Tap again to retry.',
    };
    const fsBtn = document.getElementById('bubble-fullscreen-btn');
    function syncFsIcon() {
      if (!fsBtn) return;
      const entering = !document.fullscreenElement;
      fsBtn.querySelector('.icon-enter')?.classList.toggle('hidden', !entering);
      fsBtn.querySelector('.icon-exit')?.classList.toggle('hidden', entering);
    }
    if (fsBtn) {
      fsBtn.addEventListener('click', () => {
        if (document.fullscreenElement) document.exitFullscreen();
        else if (card && card.requestFullscreen) card.requestFullscreen();
      });
      document.addEventListener('fullscreenchange', syncFsIcon);
      syncFsIcon();
    }
    const dot = document.getElementById('bubble-dot');
    const xEl = document.getElementById('bubble-x');
    const yEl = document.getElementById('bubble-y');
    const statusEl = document.getElementById('bubble-status');
    const messageEl = document.getElementById('bubble-message');

    const SCALE = 3; // px per degree
    const LEVEL_TOL = 3; // degrees

    function getScreenAngle() {
      try {
        if (window.screen && window.screen.orientation && typeof window.screen.orientation.angle === 'number') {
          return window.screen.orientation.angle;
        }
      } catch (e) {}
      if (typeof window.orientation === 'number') {
        return (window.orientation + 360) % 360;
      }
      return 0;
    }
    let running = false;
    let smoothX = 0;
    let smoothY = 0;
    let targetX = 0;
    let targetY = 0;
    let rafId: number | null = null;

    function setMessage(msg: string) {
      if (messageEl) messageEl.textContent = msg;
    }

    function setStatus(msg: string) {
      if (statusEl) statusEl.textContent = msg;
    }

    function getMaxTravel() {
      if (!area || !dot) return 100;
      const rect = area.getBoundingClientRect();
      const dotSize = dot.getBoundingClientRect().width || 24;
      return Math.min(rect.width, rect.height) / 2 - dotSize / 2 - 4;
    }

    function clampToSquare(x: number, y: number) {
      const maxTravel = getMaxTravel();
      return {
        x: Math.max(-maxTravel, Math.min(maxTravel, x)),
        y: Math.max(-maxTravel, Math.min(maxTravel, y)),
      };
    }

    function updateDot() {
      smoothX += (targetX - smoothX) * 0.15;
      smoothY += (targetY - smoothY) * 0.15;
      if (dot) {
        dot.style.transform = `translate(calc(-50% + ${smoothX.toFixed(1)}px), calc(-50% + ${smoothY.toFixed(1)}px))`;
      }
      rafId = requestAnimationFrame(updateDot);
    }

    // --- calibration offsets -------------------------------------------------
    // A phone resting on a table is rarely at a true 0.0°, and a case or a camera
    // bump shifts it further. Calibrate records the current angles as zero.
    let offsetX = 0;
    let offsetY = 0;
    try {
      const saved = localStorage.getItem('bubble-offset');
      if (saved) {
        const o = JSON.parse(saved);
        if (typeof o.x === 'number' && typeof o.y === 'number') {
          offsetX = o.x;
          offsetY = o.y;
        }
      }
    } catch (e) {}
    let lastBeta = 0;
    let lastGamma = 0;

    function saveOffset() {
      try {
        localStorage.setItem('bubble-offset', JSON.stringify({ x: offsetX, y: offsetY }));
      } catch (e) {}
    }

    function handleOrientation(event: DeviceOrientationEvent) {
      if (!running) return;
      const beta = typeof event.beta === 'number' ? event.beta : 0;
      const gamma = typeof event.gamma === 'number' ? event.gamma : 0;
      lastBeta = beta;
      lastGamma = gamma;

      const tiltX = Math.max(-60, Math.min(60, gamma - offsetX));
      const tiltY = Math.max(-60, Math.min(60, beta - offsetY));

      const rawX = tiltX * SCALE;
      const rawY = tiltY * SCALE;
      const clamped = clampToSquare(rawX, rawY);
      targetX = clamped.x;
      targetY = clamped.y;

      if (xEl) xEl.textContent = tiltX.toFixed(1) + '°';
      if (yEl) yEl.textContent = tiltY.toFixed(1) + '°';

      if (Math.abs(tiltX) <= LEVEL_TOL && Math.abs(tiltY) <= LEVEL_TOL) {
        setStatus(msg.level);
      } else if (running) {
        setStatus(msg.tilt);
      }
    }

    async function start() {
      if (running) return;
      if (!window.isSecureContext) {
        setMessage(msg.https);
        return;
      }
      if (!window.DeviceOrientationEvent) {
        setMessage(msg.unsupported);
        return;
      }
      if (typeof (DeviceOrientationEvent as any).requestPermission === 'function') {
        try {
          const res = await (DeviceOrientationEvent as any).requestPermission();
          if (res !== 'granted') {
            setMessage(msg.denied);
            return;
          }
        } catch {
          setMessage(msg.retry);
          return;
        }
      }
      running = true;
      setStatus(msg.tilt);
      setMessage('');
      window.addEventListener('deviceorientation', handleOrientation);
      if (rafId === null) rafId = requestAnimationFrame(updateDot);
    }

    function stop() {
      running = false;
      window.removeEventListener('deviceorientation', handleOrientation);
      targetX = 0;
      targetY = 0;
      setStatus(msg.stopped);
    }

    const calibrateBtn = document.getElementById('bubble-calibrate-btn') as HTMLButtonElement | null;
    const calibratedLabel = calibrateBtn?.dataset.calibrated || 'Calibrated';
    const resetBtn = document.getElementById('bubble-reset-btn');
    if (calibrateBtn) {
      calibrateBtn.addEventListener('click', () => {
        offsetX = lastGamma;
        offsetY = lastBeta;
        saveOffset();
        setStatus(calibratedLabel);
        setMessage('');
      });
    }
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        offsetX = 0;
        offsetY = 0;
        saveOffset();
        setStatus(calibratedLabel);
      });
    }

    // auto-start; allow tap to retry if permission failed
    start();
    if (area) area.addEventListener('click', () => { if (!running) start(); });

    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (dot) dot.style.transition = 'none';
    }
  })();
</script>

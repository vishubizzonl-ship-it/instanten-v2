---
/** Base64 encoder / decoder — UTF-8 safe, RFC 4648. */
---
<div class="rounded-2xl border border-border-hairline bg-surface p-5 text-ink shadow-[0_1px_1px_rgb(0_0_0/0.04)] max-sm:p-3.5" data-tool-root="base64-encoder">
  <div class="mb-4">
    <h2 class="font-display text-lg font-semibold tracking-tight text-ink">Encode or decode Base64</h2>
    <p class="mt-1 text-[13px] leading-relaxed text-muted">Emoji aur Indian languages bhi sahi round-trip hote hain.</p>
  </div>
  <div class="flex flex-wrap items-center gap-2.5 max-sm:[&>button]:flex-1 mb-3" role="group" aria-label="Mode">
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5 border-transparent bg-[linear-gradient(180deg,var(--accent-start),var(--accent-end))] text-white hover:text-white hover:opacity-95" data-b64-mode="encode" aria-pressed="true">Encode → Base64</button>
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5" data-b64-mode="decode" aria-pressed="false">Decode ← Base64</button>
  </div>
  <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body">
    Input
    <textarea class="w-full min-h-[120px] resize-y rounded-[10px] border border-border-hairline bg-canvas px-3 py-2 font-mono text-[13px] leading-relaxed text-ink outline-none transition focus-visible:border-accent focus-visible:ring-2 focus-visible:ring-accent/25 max-sm:text-base" data-b64-input spellcheck="false" placeholder="Type text here…"></textarea>
  </label>
  <p class="mt-3 rounded-[10px] border border-[#fda29b] bg-[#fef3f2] px-3 py-2 text-[13px] text-[#b42318]" data-b64-error hidden></p>
  <pre class="mt-3 block max-h-[240px] overflow-auto whitespace-pre-wrap break-words rounded-[10px] border border-border-hairline bg-surface-soft px-3 py-2.5 font-mono text-[12.5px] leading-relaxed text-ink" data-b64-out aria-live="polite"></pre>
  <div class="flex flex-wrap items-center gap-2.5 max-sm:[&>button]:flex-1 mt-3">
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5" data-b64-copy>Copy output</button>
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5" data-b64-clear>Clear</button>
  </div>
</div>

<script>
  import { encodeBase64, decodeBase64 } from '../../lib/tools/core.mjs';

  /** active preset button ke Tailwind tokens */
  const PRIMARY = [
    'border-transparent',
    'bg-[linear-gradient(180deg,var(--accent-start),var(--accent-end))]',
    'text-white',
  ];


  const root = document.querySelector('[data-tool-root="base64-encoder"]');
  if (root) {
    const input = root.querySelector('[data-b64-input]');
    const out = root.querySelector('[data-b64-out]');
    const err = root.querySelector('[data-b64-error]');
    let mode = 'encode';

    const run = () => {
      if (!input.value) {
        out.textContent = '';
        err.hidden = true;
        return;
      }
      if (mode === 'encode') {
        err.hidden = true;
        out.textContent = encodeBase64(input.value);
        return;
      }
      const res = decodeBase64(input.value);
      if (res.ok) {
        err.hidden = true;
        out.textContent = res.output;
      } else {
        out.textContent = '';
        err.hidden = false;
        err.textContent = res.error;
      }
    };

    root.querySelectorAll('[data-b64-mode]').forEach((button) => {
      button.addEventListener('click', () => {
        mode = button.dataset.b64Mode;
        root.querySelectorAll('[data-b64-mode]').forEach((other) => {
          const active = other === button;
          PRIMARY.forEach((token) => other.classList.toggle(token, active));
          other.setAttribute('aria-pressed', String(active));
        });
        run();
      });
    });
    root.querySelector('[data-b64-clear]').addEventListener('click', () => {
      input.value = '';
      out.textContent = '';
      err.hidden = true;
    });
    root.querySelector('[data-b64-copy]').addEventListener('click', async (event) => {
      const button = event.currentTarget;
      try {
        await navigator.clipboard.writeText(out.textContent ?? '');
        button.textContent = 'Copied ✓';
        setTimeout(() => (button.textContent = 'Copy output'), 1200);
      } catch {
        button.textContent = 'Copy failed';
      }
    });
    input.addEventListener('input', run);
  }
</script>

---
/** Image compressor — canvas based, kuch bhi upload nahi hota. */
---
<div class="rounded-2xl border border-border-hairline bg-surface p-5 text-ink shadow-[0_1px_1px_rgb(0_0_0/0.04)] max-sm:p-3.5" data-tool-root="image-compressor">
  <div class="mb-4">
    <h2 class="font-display text-lg font-semibold tracking-tight text-ink">Compress an image in your browser</h2>
    <p class="mt-1 text-[13px] leading-relaxed text-muted">JPEG, PNG, WebP — file device se bahar nahi jati.</p>
  </div>

  <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body">
    Choose an image
    <input type="file" class="w-full rounded-[10px] border border-border-hairline bg-canvas px-3 py-2 text-sm text-ink outline-none transition focus-visible:border-accent focus-visible:ring-2 focus-visible:ring-accent/25 max-sm:text-base" accept="image/*" data-ic-file />
  </label>

  <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body mt-3">
    Quality: <b data-ic-quality-label>75</b>%
    <input type="range" class="w-full accent-accent" min="30" max="95" value="75" data-ic-quality />
  </label>

  <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body mt-3">
    Output format
    <select class="w-full rounded-[10px] border border-border-hairline bg-canvas px-3 py-2 text-sm text-ink outline-none transition focus-visible:border-accent focus-visible:ring-2 focus-visible:ring-accent/25 max-sm:text-base" data-ic-format>
      <option value="image/jpeg">JPEG (smallest, no transparency)</option>
      <option value="image/webp">WebP (best for web)</option>
      <option value="image/png">PNG (keeps transparency)</option>
    </select>
  </label>

  <div class="flex flex-wrap items-center gap-2.5 max-sm:[&>button]:flex-1 mt-3.5">
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5 border-transparent bg-[linear-gradient(180deg,var(--accent-start),var(--accent-end))] text-white hover:text-white hover:opacity-95" data-ic-run>Compress</button>
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5" data-ic-download disabled>Download</button>
  </div>

  <p class="mt-3 rounded-[10px] border border-danger-border bg-danger-soft px-3 py-2 text-[13px] text-danger" data-ic-error hidden></p>
  <div class="mt-3 rounded-[10px] border border-dashed border-border-hairline bg-surface-soft px-3.5 py-4 text-[13px] text-muted [&_img]:mx-auto [&_img]:mt-3 [&_img]:block [&_img]:max-h-[220px] [&_img]:max-w-full [&_img]:rounded-md" data-ic-drop>Abhi koi image nahi chuni.</div>
  <div class="mt-4 grid grid-cols-2 gap-2.5 sm:grid-cols-4" data-ic-stats hidden>
    <div class="flex flex-col gap-0.5 rounded-xl border border-border-hairline bg-surface-soft px-3 py-2.5 text-center"><b data-ic-original>—</b><span>Original</span></div>
    <div class="flex flex-col gap-0.5 rounded-xl border border-border-hairline bg-surface-soft px-3 py-2.5 text-center"><b data-ic-size>—</b><span>Compressed</span></div>
    <div class="flex flex-col gap-0.5 rounded-xl border border-border-hairline bg-surface-soft px-3 py-2.5 text-center"><b data-ic-saved>—</b><span>Saved</span></div>
    <div class="flex flex-col gap-0.5 rounded-xl border border-border-hairline bg-surface-soft px-3 py-2.5 text-center"><b data-ic-dims>—</b><span>Dimensions</span></div>
  </div>
</div>

<script>
  const root = document.querySelector('[data-tool-root="image-compressor"]');
  if (root) {
    const fileInput = root.querySelector('[data-ic-file]');
    const qualityInput = root.querySelector('[data-ic-quality]');
    const qualityLabel = root.querySelector('[data-ic-quality-label]');
    const formatSelect = root.querySelector('[data-ic-format]');
    const drop = root.querySelector('[data-ic-drop]');
    const stats = root.querySelector('[data-ic-stats]');
    const err = root.querySelector('[data-ic-error]');
    const downloadButton = root.querySelector('[data-ic-download]');
    let currentFile = null;
    let resultUrl = null;
    let resultName = 'compressed';

    const kb = (bytes) => `${(bytes / 1024).toFixed(bytes > 1024 * 1024 ? 0 : 1)} KB`;

    const showOriginal = (file) => {
      currentFile = file;
      const reader = new FileReader();
      reader.onload = () => {
        drop.innerHTML = '';
        const img = document.createElement('img');
        img.src = String(reader.result);
        img.alt = file.name;
        drop.textContent = `${file.name} · ${kb(file.size)} — selected`;
        drop.appendChild(img);
      };
      reader.readAsDataURL(file);
      stats.hidden = true;
      err.hidden = true;
    };

    const compress = async () => {
      if (!currentFile) {
        err.hidden = false;
        err.textContent = 'Pehle koi image chuno.';
        return;
      }
      const quality = Number(qualityInput.value) / 100;
      const type = formatSelect.value;
      const bitmap = await createImageBitmap(currentFile);
      const canvas = document.createElement('canvas');
      canvas.width = bitmap.width;
      canvas.height = bitmap.height;
      canvas.getContext('2d').drawImage(bitmap, 0, 0);

      const blob = await new Promise((resolve) => canvas.toBlob(resolve, type, quality));
      if (!blob) {
        err.hidden = false;
        err.textContent = 'Is format mein compress nahi ho paya — dusra format chuno.';
        return;
      }
      if (resultUrl) URL.revokeObjectURL(resultUrl);
      resultUrl = URL.createObjectURL(blob);
      const extension = type.split('/')[1].replace('jpeg', 'jpg');
      resultName = `${currentFile.name.replace(/\.[^.]+$/, '')}-compressed.${extension}`;

      err.hidden = true;
      stats.hidden = false;
      root.querySelector('[data-ic-original]').textContent = kb(currentFile.size);
      root.querySelector('[data-ic-size]').textContent = kb(blob.size);
      const saved = Math.max(0, Math.round((1 - blob.size / currentFile.size) * 100));
      root.querySelector('[data-ic-saved]').textContent = `${saved}%`;
      root.querySelector('[data-ic-dims]').textContent = `${bitmap.width}×${bitmap.height}`;
      downloadButton.disabled = false;
    };

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files[0]) showOriginal(fileInput.files[0]);
    });
    qualityInput.addEventListener('input', () => (qualityLabel.textContent = qualityInput.value));
    root.querySelector('[data-ic-run]').addEventListener('click', compress);
    downloadButton.addEventListener('click', () => {
      if (!resultUrl) return;
      const link = document.createElement('a');
      link.href = resultUrl;
      link.download = resultName;
      link.click();
    });
  }
</script>

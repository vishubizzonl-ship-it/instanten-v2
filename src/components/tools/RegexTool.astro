---
/** Regex tester — live matches, groups, flags. */
---
<div class="rounded-2xl border border-border-hairline bg-surface p-5 text-ink shadow-[0_1px_1px_rgb(0_0_0/0.04)] max-sm:p-3.5" data-tool-root="regex-tester">
  <div class="mb-4">
    <h2 class="font-display text-lg font-semibold tracking-tight text-ink">Test a regular expression</h2>
    <p class="mt-1 text-[13px] leading-relaxed text-muted">JavaScript flavour — browser ka apna engine, kuch upload nahi.</p>
  </div>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body">
      Pattern
      <input class="w-full rounded-[10px] border border-border-hairline bg-canvas px-3 py-2 text-sm text-ink outline-none transition focus-visible:border-accent focus-visible:ring-2 focus-visible:ring-accent/25 max-sm:text-base font-mono" data-re-pattern value="(\\w+)@(\\w+)\\.com" spellcheck="false" />
    </label>
    <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body">
      Flags (g, i, m, s, u)
      <input class="w-full rounded-[10px] border border-border-hairline bg-canvas px-3 py-2 text-sm text-ink outline-none transition focus-visible:border-accent focus-visible:ring-2 focus-visible:ring-accent/25 max-sm:text-base font-mono" data-re-flags value="g" spellcheck="false" />
    </label>
  </div>

  <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body mt-3">
    Sample text
    <textarea class="w-full min-h-[120px] resize-y rounded-[10px] border border-border-hairline bg-canvas px-3 py-2 font-mono text-[13px] leading-relaxed text-ink outline-none transition focus-visible:border-accent focus-visible:ring-2 focus-visible:ring-accent/25 max-sm:text-base min-h-[140px]" data-re-text>Write to asha@example.com or team@instanten.com</textarea>
  </label>

  <p class="mt-3 rounded-[10px] border border-danger-border bg-danger-soft px-3 py-2 text-[13px] text-danger" data-re-error hidden></p>
  <p class="mt-2 text-[12.5px] leading-relaxed text-muted" data-re-meta></p>
  <table class="mt-3 w-full border-collapse overflow-hidden rounded-[10px] text-[13px] [&_th]:border-b [&_th]:border-border-hairline [&_th]:bg-surface-soft [&_th]:px-2.5 [&_th]:py-2 [&_th]:text-left [&_th]:font-semibold [&_th]:text-ink [&_td]:border-b [&_td]:border-hairline-soft [&_td]:px-2.5 [&_td]:py-2 [&_td]:align-top [&_td]:text-body [&_code]:font-mono [&_code]:text-[12px]" data-re-table hidden>
    <thead>
      <tr><th>#</th><th>Match</th><th>Index</th><th>Groups</th></tr>
    </thead>
    <tbody data-re-rows></tbody>
  </table>
</div>

<script>
  import { regexMatches } from '../../lib/tools/core.mjs';

  const root = document.querySelector('[data-tool-root="regex-tester"]');
  if (root) {
    const pattern = root.querySelector('[data-re-pattern]');
    const flags = root.querySelector('[data-re-flags]');
    const text = root.querySelector('[data-re-text]');
    const err = root.querySelector('[data-re-error]');
    const meta = root.querySelector('[data-re-meta]');
    const table = root.querySelector('[data-re-table]');
    const rows = root.querySelector('[data-re-rows]');

    const run = () => {
      const res = regexMatches(pattern.value, flags.value.replace(/[^gimsuy]/g, ''), text.value);
      if (!res.ok) {
        err.hidden = false;
        err.textContent = res.error;
        table.hidden = true;
        meta.textContent = '';
        return;
      }
      err.hidden = true;
      meta.textContent = `${res.count} match${res.count === 1 ? '' : 'es'} found.`;
      if (res.count === 0) {
        table.hidden = true;
        rows.innerHTML = '';
        return;
      }
      table.hidden = false;
      rows.innerHTML = res.matches
        .slice(0, 200)
        .map(
          (m, i) =>
            `<tr><td>${i + 1}</td><td><code>${m.match.replace(/</g, '&lt;')}</code></td><td>${m.index}</td><td>${
              m.groups.length ? m.groups.map((g) => (g == null ? '—' : g.replace(/</g, '&lt;'))).join(' · ') : '—'
            }</td></tr>`
        )
        .join('');
    };

    [pattern, flags, text].forEach((el) => el.addEventListener('input', run));
    run();
  }
</script>

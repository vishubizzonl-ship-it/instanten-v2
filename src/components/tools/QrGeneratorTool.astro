---
/** QR generator — URL / text / Wi-Fi / vCard, PNG + SVG download. */
---
<div class="tool-shell" data-tool-root="qr-generator">
  <div class="tool-head">
    <h2 class="tool-title">Create a QR code</h2>
    <p class="tool-hint">Code aapke browser mein banta hai — koi data upload nahi.</p>
  </div>

  <label class="tool-field">
    What should the code contain?
    <select class="tool-select" data-qr-type>
      <option value="url">Website link (URL)</option>
      <option value="text">Plain text</option>
      <option value="wifi">Wi-Fi network</option>
      <option value="vcard">Contact card (vCard)</option>
    </select>
  </label>

  <div data-qr-fields="url" style="margin-top:12px">
    <label class="tool-field">URL <input class="tool-input" data-qr-url value="https://instanten.com/" inputmode="url" /></label>
  </div>

  <div data-qr-fields="text" hidden style="margin-top:12px">
    <label class="tool-field">Text <textarea class="tool-textarea" data-qr-text placeholder="Any text…"></textarea></label>
  </div>

  <div data-qr-fields="wifi" hidden style="margin-top:12px">
    <div class="tool-grid-2">
      <label class="tool-field">Network name (SSID) <input class="tool-input" data-qr-ssid /></label>
      <label class="tool-field">Password <input class="tool-input" data-qr-pass /></label>
      <label class="tool-field">
        Security
        <select class="tool-select" data-qr-enc">
          <option value="WPA">WPA / WPA2 / WPA3</option>
          <option value="WEP">WEP</option>
          <option value="nopass">Open (no password)</option>
        </select>
      </label>
      <label class="tool-check" style="align-self:end"><input type="checkbox" data-qr-hidden /> Hidden network</label>
    </div>
  </div>

  <div data-qr-fields="vcard" hidden style="margin-top:12px">
    <div class="tool-grid-2">
      <label class="tool-field">Name <input class="tool-input" data-qr-vname /></label>
      <label class="tool-field">Organisation <input class="tool-input" data-qr-vorg /></label>
      <label class="tool-field">Phone <input class="tool-input" data-qr-vphone inputmode="tel" /></label>
      <label class="tool-field">Email <input class="tool-input" data-qr-vemail inputmode="email" /></label>
    </div>
  </div>

  <div class="tool-row" style="margin-top:14px">
    <button type="button" class="tool-btn tool-btn--primary" data-qr-generate>Generate QR</button>
    <button type="button" class="tool-btn" data-qr-png>Download PNG</button>
    <button type="button" class="tool-btn" data-qr-svg>Download SVG</button>
  </div>

  <p class="tool-error" data-qr-error hidden></p>
  <div class="tool-qr-out">
    <canvas data-qr-canvas width="256" height="256" aria-label="QR code"></canvas>
    <div>
      <p class="tool-note" data-qr-meta></p>
      <pre class="tool-out" data-qr-payload style="min-height:auto; max-height:120px"></pre>
    </div>
  </div>
</div>

<script>
  import qrcode from 'qrcode-generator';
  import { wifiQrPayload, vcardPayload } from '../../lib/tools/core.mjs';

  const root = document.querySelector('[data-tool-root="qr-generator"]');
  if (root) {
    const typeSelect = root.querySelector('[data-qr-type]');
    const canvas = root.querySelector('[data-qr-canvas]');
    const err = root.querySelector('[data-qr-error]');
    const meta = root.querySelector('[data-qr-meta]');
    const payloadBox = root.querySelector('[data-qr-payload]');
    let payload = 'https://instanten.com/';

    const buildPayload = () => {
      const type = typeSelect.value;
      if (type === 'text') return root.querySelector('[data-qr-text]').value.trim();
      if (type === 'wifi') {
        return wifiQrPayload({
          ssid: root.querySelector('[data-qr-ssid]').value.trim(),
          password: root.querySelector('[data-qr-pass]').value,
          encryption: root.querySelector('[data-qr-enc]').value,
          hidden: root.querySelector('[data-qr-hidden]').checked,
        });
      }
      if (type === 'vcard') {
        return vcardPayload({
          name: root.querySelector('[data-qr-vname]').value.trim(),
          org: root.querySelector('[data-qr-vorg]').value.trim(),
          phone: root.querySelector('[data-qr-vphone]').value.trim(),
          email: root.querySelector('[data-qr-vemail]').value.trim(),
        });
      }
      return root.querySelector('[data-qr-url]').value.trim();
    };

    const render = () => {
      payload = buildPayload();
      if (!payload) {
        err.hidden = false;
        err.textContent = 'Pehle content bharo, phir Generate dabao.';
        return;
      }
      try {
        const qr = qrcode(0, 'M');
        qr.addData(payload);
        qr.make();
        err.hidden = true;
        const count = qr.getModuleCount();
        const size = 256;
        const cell = size / count;
        const ctx = canvas.getContext('2d');
        canvas.width = size;
        canvas.height = size;
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, size, size);
        ctx.fillStyle = '#17171c';
        for (let row = 0; row < count; row++) {
          for (let col = 0; col < count; col++) {
            if (qr.isDark(row, col)) ctx.fillRect(Math.floor(col * cell), Math.floor(row * cell), Math.ceil(cell), Math.ceil(cell));
          }
        }
        payloadBox.textContent = payload;
        meta.textContent = `${count} × ${count} modules · error correction M · payload ${payload.length} characters`;
        canvas.dataset.qrReady = '1';
      } catch (error) {
        err.hidden = false;
        err.textContent = `QR banane mein dikkat: ${error.message}. Text thoda chhota karo.`;
      }
    };

    const download = (href, filename) => {
      const link = document.createElement('a');
      link.href = href;
      link.download = filename;
      link.click();
    };

    typeSelect.addEventListener('change', () => {
      root.querySelectorAll('[data-qr-fields]').forEach((block) => {
        block.hidden = block.dataset.qrFields !== typeSelect.value;
      });
      render();
    });
    root.querySelector('[data-qr-generate]').addEventListener('click', render);
    root.querySelector('[data-qr-png]').addEventListener('click', () => {
      if (!canvas.dataset.qrReady) render();
      download(canvas.toDataURL('image/png'), 'instanten-qr.png');
    });
    root.querySelector('[data-qr-svg]').addEventListener('click', () => {
      if (!payload) return;
      const qr = qrcode(0, 'M');
      qr.addData(payload);
      qr.make();
      const svg = qr.createSvgTag({ scalable: true, margin: 2 });
      const blob = new Blob([`<?xml version="1.0" encoding="UTF-8"?>\n${svg}`], { type: 'image/svg+xml' });
      download(URL.createObjectURL(blob), 'instanten-qr.svg');
    });

    render();
  }
</script>

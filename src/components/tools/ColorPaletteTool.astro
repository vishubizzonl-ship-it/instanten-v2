---
/** Colour palette + WCAG 2.2 contrast checker. */
---
<div class="rounded-2xl border border-border-hairline bg-surface p-5 text-ink shadow-[0_1px_1px_rgb(0_0_0/0.04)] max-sm:p-3.5" data-tool-root="color-palette">
  <div class="mb-4">
    <h2 class="font-display text-lg font-semibold tracking-tight text-ink">Build a palette and check contrast</h2>
    <p class="mt-1 text-[13px] leading-relaxed text-muted">WCAG 2.2 AA: 4.5:1 normal text, 3:1 large text.</p>
  </div>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body">
      Base colour
      <input type="color" class="w-full rounded-[10px] border border-border-hairline bg-canvas px-3 py-2 text-sm text-ink outline-none transition focus-visible:border-accent focus-visible:ring-2 focus-visible:ring-accent/25 max-sm:text-base h-11 p-1" data-cp-color value="#514DCC" />
    </label>
    <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body">
      Hex value
      <input class="w-full rounded-[10px] border border-border-hairline bg-canvas px-3 py-2 text-sm text-ink outline-none transition focus-visible:border-accent focus-visible:ring-2 focus-visible:ring-accent/25 max-sm:text-base" data-cp-hex value="#514DCC" spellcheck="false" />
    </label>
  </div>

  <div class="flex flex-wrap items-center gap-2.5 max-sm:[&>button]:flex-1 mt-3.5">
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5 border-transparent bg-[linear-gradient(180deg,var(--accent-start),var(--accent-end))] text-white hover:text-white hover:opacity-95" data-cp-generate>Generate harmonies</button>
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5" data-cp-copy>Copy CSS variables</button>
  </div>

  <p class="mt-3 rounded-[10px] border border-danger-border bg-danger-soft px-3 py-2 text-[13px] text-danger" data-cp-error hidden></p>
  <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4" data-cp-swatches></div>

  <table class="mt-3 w-full border-collapse overflow-hidden rounded-[10px] text-[13px] [&_th]:border-b [&_th]:border-border-hairline [&_th]:bg-surface-soft [&_th]:px-2.5 [&_th]:py-2 [&_th]:text-left [&_th]:font-semibold [&_th]:text-ink [&_td]:border-b [&_td]:border-hairline-soft [&_td]:px-2.5 [&_td]:py-2 [&_td]:align-top [&_td]:text-body [&_code]:font-mono [&_code]:text-[12px]" data-cp-table hidden>
    <thead>
      <tr><th>Pair</th><th>Ratio</th><th>Grade</th></tr>
    </thead>
    <tbody data-cp-rows></tbody>
  </table>
  <pre class="mt-3 block max-h-[240px] overflow-auto whitespace-pre-wrap break-words rounded-[10px] border border-border-hairline bg-surface-soft px-3 py-2.5 font-mono text-[12.5px] leading-relaxed text-ink max-h-40" data-cp-css hidden></pre>
</div>

<script>
  import { harmonies, contrastRatio, contrastGrade, hexToRgb } from '../../lib/tools/core.mjs';

  const root = document.querySelector('[data-tool-root="color-palette"]');
  if (root) {
    const colorInput = root.querySelector('[data-cp-color]');
    const hexInput = root.querySelector('[data-cp-hex]');
    const swatches = root.querySelector('[data-cp-swatches]');
    const table = root.querySelector('[data-cp-table]');
    const rows = root.querySelector('[data-cp-rows]');
    const cssBox = root.querySelector('[data-cp-css]');
    const err = root.querySelector('[data-cp-error]');
    let current = null;

    const render = (hex) => {
      const set = harmonies(hex);
      if (!set) {
        err.hidden = false;
        err.textContent = 'Valid hex colour do, jaise #514DCC.';
        swatches.innerHTML = '';
        table.hidden = true;
        cssBox.hidden = true;
        return;
      }
      err.hidden = true;
      current = set;

      swatches.innerHTML = Object.entries(set)
        .flatMap(([name, colors]) =>
          colors.map(
            (color) =>
              `<button type="button" class="flex flex-col items-center gap-1 rounded-[10px] border border-border-hairline bg-surface p-1.5 text-[11px] text-body transition hover:border-accent [&_i]:block [&_i]:h-9 [&_i]:w-full [&_i]:rounded-md" data-copy="${color}" title="Copy ${color}"><i style="background:${color}"></i><span>${color}</span><em class="text-[10px] not-italic opacity-60">${name.slice(0, 6)}</em></button>`
          )
        )
        .join('');

      const unique = [...new Set([hex, ...Object.values(set).flat()])];
      rows.innerHTML = unique
        .map((color) => {
          const white = contrastRatio(color, '#ffffff');
          const black = contrastRatio(color, '#000000');
          const best = white >= black ? { name: 'white text', ratio: white } : { name: 'black text', ratio: black };
          const grade = contrastGrade(best.ratio);
          const pass = best.ratio >= 4.5;
          const badge = pass ? 'bg-success-soft text-success' : 'bg-danger-soft text-danger';
          return `<tr><td><span class="mr-1.5 inline-block size-3.5 -translate-y-px rounded-[3px]" style="background:${color}"></span>${color}</td><td>${best.ratio}:1 with ${best.name}</td><td><span class="inline-block rounded-full px-2 py-0.5 text-[11px] font-semibold ${badge}">${grade}</span></td></tr>`;
        })
        .join('');
      table.hidden = false;

      const vars = unique.map((color, index) => `  --color-${index + 1}: ${color};`).join('\n');
      cssBox.textContent = `:root {\n${vars}\n}`;
      cssBox.hidden = false;
    };

    const sync = (hex) => {
      if (!hexToRgb(hex)) {
        render(hex);
        return;
      }
      colorInput.value = hex;
      hexInput.value = hex;
      render(hex);
    };

    colorInput.addEventListener('input', () => sync(colorInput.value));
    hexInput.addEventListener('input', () => {
      const value = hexInput.value.trim();
      if (hexToRgb(value)) colorInput.value = value;
      render(value);
    });
    root.querySelector('[data-cp-generate]').addEventListener('click', () => sync(colorInput.value));
    root.querySelector('[data-cp-copy]').addEventListener('click', async (event) => {
      const button = event.currentTarget;
      try {
        await navigator.clipboard.writeText(cssBox.textContent ?? '');
        button.textContent = 'Copied ✓';
        setTimeout(() => (button.textContent = 'Copy CSS variables'), 1200);
      } catch {
        button.textContent = 'Copy failed';
      }
    });
    swatches.addEventListener('click', async (event) => {
      const target = event.target.closest('[data-copy]');
      if (!target) return;
      try {
        await navigator.clipboard.writeText(target.dataset.copy);
        target.dataset.copied = '1';
      } catch {
        /* clipboard blocked — ignore */
      }
    });

    render('#514DCC');
  }
</script>

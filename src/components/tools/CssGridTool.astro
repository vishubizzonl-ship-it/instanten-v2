---
/** CSS Grid generator — live preview + copy-paste CSS. */
---
<div class="rounded-2xl border border-border-hairline bg-surface p-5 text-ink shadow-[0_1px_1px_rgb(0_0_0/0.04)] max-sm:p-3.5" data-tool-root="css-grid-generator">
  <div class="mb-4">
    <h2 class="font-display text-lg font-semibold tracking-tight text-ink">Build a CSS grid</h2>
    <p class="mt-1 text-[13px] leading-relaxed text-muted">Preview dekho, phir CSS copy karo — koi framework nahi.</p>
  </div>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body">
      Columns: <b data-grid-columns-label>3</b>
      <input type="range" class="w-full accent-accent" min="1" max="6" value="3" data-grid-columns />
    </label>
    <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body">
      Rows: <b data-grid-rows-label>2</b>
      <input type="range" class="w-full accent-accent" min="1" max="6" value="2" data-grid-rows />
    </label>
    <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body">
      Gap: <b data-grid-gap-label>16</b>px
      <input type="range" class="w-full accent-accent" min="0" max="48" value="16" data-grid-gap />
    </label>
    <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body">
      Align items
      <select class="w-full rounded-[10px] border border-border-hairline bg-canvas px-3 py-2 text-sm text-ink outline-none transition focus-visible:border-accent focus-visible:ring-2 focus-visible:ring-accent/25 max-sm:text-base" data-grid-align">
        <option value="stretch">stretch</option>
        <option value="start">start</option>
        <option value="center">center</option>
        <option value="end">end</option>
      </select>
    </label>
  </div>

  <div class="flex flex-wrap items-center gap-2.5 max-sm:[&>button]:flex-1 mt-3.5">
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5" data-grid-copy>Copy CSS</button>
  </div>

  <div class="mt-3 grid gap-3 [&>div]:flex [&>div]:h-10 [&>div]:items-center [&>div]:justify-center [&>div]:rounded-lg [&>div]:bg-accent-soft [&>div]:text-[12px] [&>div]:font-semibold [&>div]:text-accent max-sm:[&>div]:h-8" data-grid-preview aria-hidden="true"></div>
  <pre class="mt-3 block max-h-[240px] overflow-auto whitespace-pre-wrap break-words rounded-[10px] border border-border-hairline bg-surface-soft px-3 py-2.5 font-mono text-[12.5px] leading-relaxed text-ink max-h-44" data-grid-css></pre>
</div>

<script>
  import { gridCss } from '../../lib/tools/core.mjs';

  const root = document.querySelector('[data-tool-root="css-grid-generator"]');
  if (root) {
    const columns = root.querySelector('[data-grid-columns]');
    const rows = root.querySelector('[data-grid-rows]');
    const gap = root.querySelector('[data-grid-gap]');
    const align = root.querySelector('[data-grid-align]');
    const preview = root.querySelector('[data-grid-preview]');
    const cssBox = root.querySelector('[data-grid-css]');

    const update = () => {
      root.querySelector('[data-grid-columns-label]').textContent = columns.value;
      root.querySelector('[data-grid-rows-label]').textContent = rows.value;
      root.querySelector('[data-grid-gap-label]').textContent = gap.value;

      const css = gridCss({
        columns: Number(columns.value),
        rows: Number(rows.value),
        gap: Number(gap.value),
        align: align.value,
      });
      cssBox.textContent = `.grid {\n${css
        .split('\n')
        .map((line) => `  ${line}`)
        .join('\n')}\n}`;

      const total = Number(columns.value) * Number(rows.value);
      preview.style.gridTemplateColumns = `repeat(${Number(columns.value)}, 1fr)`;
      preview.style.gap = `${Number(gap.value)}px`;
      preview.style.alignItems = align.value;
      preview.innerHTML = Array.from({ length: total }, (_, i) => `<div>${i + 1}</div>`).join('');
    };

    [columns, rows, gap, align].forEach((el) => el.addEventListener('input', update));
    root.querySelector('[data-grid-copy]').addEventListener('click', async (event) => {
      const button = event.currentTarget;
      try {
        await navigator.clipboard.writeText(cssBox.textContent ?? '');
        button.textContent = 'Copied ✓';
        setTimeout(() => (button.textContent = 'Copy CSS'), 1200);
      } catch {
        button.textContent = 'Copy failed';
      }
    });
    update();
  }
</script>

---
/** Password generator — crypto.getRandomValues, entropy estimate. */
---
<div class="tool-shell" data-tool-root="password-generator">
  <div class="tool-head">
    <h2 class="tool-title">Generate a strong password</h2>
    <p class="tool-hint">Browser ke cryptographic random source se — server par kuch nahi jata.</p>
  </div>
  <label class="tool-field">
    Length: <b data-pw-length-label>16</b> characters
    <input type="range" class="tool-range" min="8" max="64" value="16" data-pw-length />
  </label>
  <div class="tool-row" style="margin-top:12px; gap:16px">
    <label class="tool-check"><input type="checkbox" data-pw-set="lower" checked /> abc</label>
    <label class="tool-check"><input type="checkbox" data-pw-set="upper" checked /> ABC</label>
    <label class="tool-check"><input type="checkbox" data-pw-set="digits" checked /> 123</label>
    <label class="tool-check"><input type="checkbox" data-pw-set="symbols" checked /> !@#</label>
    <label class="tool-check"><input type="checkbox" data-pw-ambiguous checked /> Ambiguous (O, 0, l, 1) hatao</label>
  </div>
  <div class="tool-row" style="margin-top:14px">
    <button type="button" class="tool-btn tool-btn--primary" data-pw-generate>Generate</button>
    <button type="button" class="tool-btn" data-pw-copy>Copy</button>
  </div>
  <p class="tool-error" data-pw-error hidden></p>
  <pre class="tool-out" data-pw-out aria-live="polite" style="font-size:16px; letter-spacing:0.5px"></pre>
  <p class="tool-note" data-pw-meta></p>
</div>

<script>
  import { generatePassword } from '../../lib/tools/core.mjs';

  const root = document.querySelector('[data-tool-root="password-generator"]');
  if (root) {
    const lengthInput = root.querySelector('[data-pw-length]');
    const lengthLabel = root.querySelector('[data-pw-length-label]');
    const out = root.querySelector('[data-pw-out]');
    const meta = root.querySelector('[data-pw-meta]');
    const err = root.querySelector('[data-pw-error]');
    const box = (name) => root.querySelector(`[data-pw-set="${name}"]`).checked;

    const make = () => {
      const res = generatePassword({
        length: Number(lengthInput.value),
        lower: box('lower'),
        upper: box('upper'),
        digits: box('digits'),
        symbols: box('symbols'),
        excludeAmbiguous: root.querySelector('[data-pw-ambiguous]').checked,
      });
      if (!res.ok) {
        out.textContent = '';
        meta.textContent = '';
        err.hidden = false;
        err.textContent = res.error;
        return;
      }
      err.hidden = true;
      out.textContent = res.password;
      const strength =
        res.entropyBits >= 128 ? 'very strong' : res.entropyBits >= 90 ? 'strong' : res.entropyBits >= 64 ? 'good' : 'weak';
      meta.textContent = `${res.entropyBits} bits of entropy — ${strength}`;
    };

    lengthInput.addEventListener('input', () => {
      lengthLabel.textContent = lengthInput.value;
      make();
    });
    root.querySelectorAll('[data-pw-set]').forEach((cb) => cb.addEventListener('change', make));
    root.querySelector('[data-pw-ambiguous]').addEventListener('change', make);
    root.querySelector('[data-pw-generate]').addEventListener('click', make);
    root.querySelector('[data-pw-copy]').addEventListener('click', async (event) => {
      const button = event.currentTarget;
      try {
        await navigator.clipboard.writeText(out.textContent ?? '');
        button.textContent = 'Copied ✓';
        setTimeout(() => (button.textContent = 'Copy'), 1200);
      } catch {
        button.textContent = 'Copy failed';
      }
    });
    make();
  }
</script>

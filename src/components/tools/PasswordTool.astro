---
/** Password generator — crypto.getRandomValues, entropy estimate. */
---
<div class="rounded-2xl border border-border-hairline bg-surface p-5 text-ink shadow-[0_1px_1px_rgb(0_0_0/0.04)] max-sm:p-3.5" data-tool-root="password-generator">
  <div class="mb-4">
    <h2 class="font-display text-lg font-semibold tracking-tight text-ink">Generate a strong password</h2>
    <p class="mt-1 text-[13px] leading-relaxed text-muted">Browser ke cryptographic random source se — server par kuch nahi jata.</p>
  </div>
  <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body">
    Length: <b data-pw-length-label>16</b> characters
    <input type="range" class="w-full accent-accent" min="8" max="64" value="16" data-pw-length />
  </label>
  <div class="mt-3 flex flex-wrap items-center gap-4 max-sm:[&>button]:flex-1">
    <label class="flex items-center gap-2 text-[13px] font-medium text-body"><input type="checkbox" data-pw-set="lower" checked /> abc</label>
    <label class="flex items-center gap-2 text-[13px] font-medium text-body"><input type="checkbox" data-pw-set="upper" checked /> ABC</label>
    <label class="flex items-center gap-2 text-[13px] font-medium text-body"><input type="checkbox" data-pw-set="digits" checked /> 123</label>
    <label class="flex items-center gap-2 text-[13px] font-medium text-body"><input type="checkbox" data-pw-set="symbols" checked /> !@#</label>
    <label class="flex items-center gap-2 text-[13px] font-medium text-body"><input type="checkbox" data-pw-ambiguous checked /> Ambiguous (O, 0, l, 1) hatao</label>
  </div>
  <div class="flex flex-wrap items-center gap-2.5 max-sm:[&>button]:flex-1 mt-3.5">
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5 border-transparent bg-[linear-gradient(180deg,var(--accent-start),var(--accent-end))] text-white hover:text-white hover:opacity-95" data-pw-generate>Generate</button>
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5" data-pw-copy>Copy</button>
  </div>
  <p class="mt-3 rounded-[10px] border border-[#fda29b] bg-[#fef3f2] px-3 py-2 text-[13px] text-[#b42318]" data-pw-error hidden></p>
  <pre class="mt-3 block max-h-[240px] overflow-auto whitespace-pre-wrap break-words rounded-[10px] border border-border-hairline bg-surface-soft px-3 py-2.5 font-mono text-[12.5px] leading-relaxed text-ink text-base tracking-[0.5px]" data-pw-out aria-live="polite"></pre>
  <p class="mt-2 text-[12.5px] leading-relaxed text-muted" data-pw-meta></p>
</div>

<script>
  import { generatePassword } from '../../lib/tools/core.mjs';

  const root = document.querySelector('[data-tool-root="password-generator"]');
  if (root) {
    const lengthInput = root.querySelector('[data-pw-length]');
    const lengthLabel = root.querySelector('[data-pw-length-label]');
    const out = root.querySelector('[data-pw-out]');
    const meta = root.querySelector('[data-pw-meta]');
    const err = root.querySelector('[data-pw-error]');
    const box = (name) => root.querySelector(`[data-pw-set="${name}"]`).checked;

    const make = () => {
      const res = generatePassword({
        length: Number(lengthInput.value),
        lower: box('lower'),
        upper: box('upper'),
        digits: box('digits'),
        symbols: box('symbols'),
        excludeAmbiguous: root.querySelector('[data-pw-ambiguous]').checked,
      });
      if (!res.ok) {
        out.textContent = '';
        meta.textContent = '';
        err.hidden = false;
        err.textContent = res.error;
        return;
      }
      err.hidden = true;
      out.textContent = res.password;
      const strength =
        res.entropyBits >= 128 ? 'very strong' : res.entropyBits >= 90 ? 'strong' : res.entropyBits >= 64 ? 'good' : 'weak';
      meta.textContent = `${res.entropyBits} bits of entropy — ${strength}`;
    };

    lengthInput.addEventListener('input', () => {
      lengthLabel.textContent = lengthInput.value;
      make();
    });
    root.querySelectorAll('[data-pw-set]').forEach((cb) => cb.addEventListener('change', make));
    root.querySelector('[data-pw-ambiguous]').addEventListener('change', make);
    root.querySelector('[data-pw-generate]').addEventListener('click', make);
    root.querySelector('[data-pw-copy]').addEventListener('click', async (event) => {
      const button = event.currentTarget;
      try {
        await navigator.clipboard.writeText(out.textContent ?? '');
        button.textContent = 'Copied ✓';
        setTimeout(() => (button.textContent = 'Copy'), 1200);
      } catch {
        button.textContent = 'Copy failed';
      }
    });
    make();
  }
</script>

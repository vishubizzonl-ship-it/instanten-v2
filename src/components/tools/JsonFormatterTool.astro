---
/** JSON Formatter — browser mein hi format/validate/minify (RFC 8259). */
---
<div class="rounded-2xl border border-border-hairline bg-surface p-5 text-ink shadow-[0_1px_1px_rgb(0_0_0/0.04)] max-sm:p-3.5" data-tool-root="json-formatter">
  <div class="mb-4">
    <h2 class="font-display text-lg font-semibold tracking-tight text-ink">Format, validate or minify JSON</h2>
    <p class="mt-1 text-[13px] leading-relaxed text-muted">Sab kuch aapke browser mein — kuch upload nahi hota.</p>
  </div>
  <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body">
    JSON input
    <textarea class="w-full min-h-[120px] resize-y rounded-[10px] border border-border-hairline bg-canvas px-3 py-2 font-mono text-[13px] leading-relaxed text-ink outline-none transition focus-visible:border-accent focus-visible:ring-2 focus-visible:ring-accent/25 max-sm:text-base" data-json-input spellcheck="false" placeholder='{"name":"instanten","tools":12}'></textarea>
  </label>
  <div class="flex flex-wrap items-center gap-2.5 max-sm:[&>button]:flex-1 mt-3">
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5 border-transparent bg-[linear-gradient(180deg,var(--accent-start),var(--accent-end))] text-white hover:text-white hover:opacity-95" data-json-format>Format</button>
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5" data-json-minify>Minify</button>
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5" data-json-copy>Copy output</button>
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5" data-json-sample>Sample</button>
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5" data-json-clear>Clear</button>
  </div>
  <p class="mt-3 rounded-[10px] border border-danger-border bg-danger-soft px-3 py-2 text-[13px] text-danger" data-json-error hidden></p>
  <pre class="mt-3 block max-h-[240px] overflow-auto whitespace-pre-wrap break-words rounded-[10px] border border-border-hairline bg-surface-soft px-3 py-2.5 font-mono text-[12.5px] leading-relaxed text-ink" data-json-out aria-live="polite"></pre>
  <p class="mt-2 text-[12.5px] leading-relaxed text-muted" data-json-meta></p>
</div>

<script>
  import { formatJson, minifyJson } from '../../lib/tools/core.mjs';

  const root = document.querySelector('[data-tool-root="json-formatter"]');
  if (root) {
    const input = root.querySelector('[data-json-input]');
    const out = root.querySelector('[data-json-out]');
    const err = root.querySelector('[data-json-error]');
    const meta = root.querySelector('[data-json-meta]');

    const show = (res) => {
      if (res.ok) {
        err.hidden = true;
        out.textContent = res.output;
        meta.textContent = `${res.output.split('\n').length} lines · ${res.output.length} characters`;
      } else {
        out.textContent = '';
        meta.textContent = '';
        err.hidden = false;
        const where = res.error.line ? ` Line ${res.error.line}, column ${res.error.column}.` : '';
        err.textContent = `Invalid JSON — ${res.error.message}.${where}`;
      }
    };

    root.querySelector('[data-json-format]').addEventListener('click', () => show(formatJson(input.value, 2)));
    root.querySelector('[data-json-minify]').addEventListener('click', () => show(minifyJson(input.value)));
    root.querySelector('[data-json-sample]').addEventListener('click', () => {
      input.value =
        '{\n  "site": "instanten",\n  "free": true,\n  "tools": ["json", "qr", "ruler"],\n  "nested": { "ok": null }\n}';
      show(formatJson(input.value, 2));
    });
    root.querySelector('[data-json-clear]').addEventListener('click', () => {
      input.value = '';
      out.textContent = '';
      meta.textContent = '';
      err.hidden = true;
    });
    root.querySelector('[data-json-copy]').addEventListener('click', async (event) => {
      const button = event.currentTarget;
      try {
        await navigator.clipboard.writeText(out.textContent ?? '');
        const label = button.textContent;
        button.textContent = 'Copied ✓';
        setTimeout(() => (button.textContent = label), 1200);
      } catch {
        button.textContent = 'Copy failed';
      }
    });
    input.addEventListener('input', () => {
      if (input.value.trim()) show(formatJson(input.value, 2));
    });
  }
</script>

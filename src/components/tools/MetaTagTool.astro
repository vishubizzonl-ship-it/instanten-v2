---
/** Meta tag generator — title/description/OG/Twitter block. */
---
<div class="rounded-2xl border border-border-hairline bg-surface p-5 text-ink shadow-[0_1px_1px_rgb(0_0_0/0.04)] max-sm:p-3.5" data-tool-root="meta-tag-generator">
  <div class="mb-4">
    <h2 class="font-display text-lg font-semibold tracking-tight text-ink">Generate meta tags</h2>
    <p class="mt-1 text-[13px] leading-relaxed text-muted">Title 50–60 chars, description 120–160 chars — counters niche.</p>
  </div>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body">
      Page title (<span data-meta-title-count>0</span>/60)
      <input class="w-full rounded-[10px] border border-border-hairline bg-canvas px-3 py-2 text-sm text-ink outline-none transition focus-visible:border-accent focus-visible:ring-2 focus-visible:ring-accent/25 max-sm:text-base" data-meta-title placeholder="Free Online Tools Hub for Instant Work" />
    </label>
    <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body">
      Site name
      <input class="w-full rounded-[10px] border border-border-hairline bg-canvas px-3 py-2 text-sm text-ink outline-none transition focus-visible:border-accent focus-visible:ring-2 focus-visible:ring-accent/25 max-sm:text-base" data-meta-site value="Instanten" />
    </label>
    <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body sm:col-span-2">
      Description (<span data-meta-desc-count>0</span>/160)
      <textarea class="w-full min-h-[120px] resize-y rounded-[10px] border border-border-hairline bg-canvas px-3 py-2 font-mono text-[13px] leading-relaxed text-ink outline-none transition focus-visible:border-accent focus-visible:ring-2 focus-visible:ring-accent/25 max-sm:text-base min-h-[90px]" data-meta-desc placeholder="Instanten is a free online tools hub with 12 instant tools for instant work."></textarea>
    </label>
    <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body">
      Canonical URL
      <input class="w-full rounded-[10px] border border-border-hairline bg-canvas px-3 py-2 text-sm text-ink outline-none transition focus-visible:border-accent focus-visible:ring-2 focus-visible:ring-accent/25 max-sm:text-base" data-meta-url value="https://instanten.com/" inputmode="url" />
    </label>
    <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body">
      Social image URL (1200×630 PNG)
      <input class="w-full rounded-[10px] border border-border-hairline bg-canvas px-3 py-2 text-sm text-ink outline-none transition focus-visible:border-accent focus-visible:ring-2 focus-visible:ring-accent/25 max-sm:text-base" data-meta-image value="https://instanten.com/og-instanten.png" inputmode="url" />
    </label>
  </div>

  <div class="flex flex-wrap items-center gap-2.5 max-sm:[&>button]:flex-1 mt-3.5">
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5" data-meta-copy>Copy tags</button>
  </div>

  <pre class="mt-3 block max-h-[240px] overflow-auto whitespace-pre-wrap break-words rounded-[10px] border border-border-hairline bg-surface-soft px-3 py-2.5 font-mono text-[12.5px] leading-relaxed text-ink max-h-72" data-meta-out></pre>
  <p class="mt-2 text-[12.5px] leading-relaxed text-muted" data-meta-hint></p>
</div>

<script>
  import { metaTags } from '../../lib/tools/core.mjs';

  const root = document.querySelector('[data-tool-root="meta-tag-generator"]');
  if (root) {
    const title = root.querySelector('[data-meta-title]');
    const site = root.querySelector('[data-meta-site]');
    const desc = root.querySelector('[data-meta-desc]');
    const url = root.querySelector('[data-meta-url]');
    const image = root.querySelector('[data-meta-image]');
    const out = root.querySelector('[data-meta-out]');
    const hint = root.querySelector('[data-meta-hint]');

    const update = () => {
      root.querySelector('[data-meta-title-count]').textContent = title.value.length;
      root.querySelector('[data-meta-desc-count]').textContent = desc.value.length;
      out.textContent = metaTags({
        title: title.value.trim(),
        description: desc.value.trim(),
        url: url.value.trim(),
        image: image.value.trim(),
        siteName: site.value.trim(),
      });

      const notes = [];
      if (title.value.length > 60) notes.push('Title lamba hai — search result mein cut hoga.');
      if (desc.value.length > 160) notes.push('Description lamba hai — 120–160 chars rakho.');
      if (url.value && !url.value.startsWith('http')) notes.push('Canonical absolute URL hona chahiye (https:// se shuru).');
      hint.textContent = notes.join(' ');
    };

    [title, site, desc, url, image].forEach((el) => el.addEventListener('input', update));
    root.querySelector('[data-meta-copy]').addEventListener('click', async (event) => {
      const button = event.currentTarget;
      try {
        await navigator.clipboard.writeText(out.textContent ?? '');
        button.textContent = 'Copied ✓';
        setTimeout(() => (button.textContent = 'Copy tags'), 1200);
      } catch {
        button.textContent = 'Copy failed';
      }
    });
    update();
  }
</script>

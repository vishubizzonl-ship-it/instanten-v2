---
/** Online ruler — ISO/IEC 7810 ID-1 card calibration, cm + inch ticks. */
---
<div class="rounded-2xl border border-border-hairline bg-surface p-5 text-ink shadow-[0_1px_1px_rgb(0_0_0/0.04)] max-sm:p-3.5" data-tool-root="online-ruler">
  <div class="mb-4">
    <h2 class="font-display text-lg font-semibold tracking-tight text-ink">Measure on screen</h2>
    <p class="mt-1 text-[13px] leading-relaxed text-muted">Card ko screen par rakh kar slider set karo — phir scale sahi ho jayega.</p>
  </div>

  <label class="flex flex-col gap-1.5 text-[13px] font-medium text-body">
    Calibrate: card ki width <b data-ruler-label>324</b> px
    <input type="range" class="w-full accent-accent" min="200" max="460" value="324" data-ruler-cal />
  </label>

  <div class="flex flex-wrap items-center gap-2.5 max-sm:[&>button]:flex-1 mt-3">
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5" data-ruler-preset="cm">Show centimetres</button>
    <button type="button" class="inline-flex items-center justify-center gap-2 rounded-[10px] border border-border-hairline bg-surface px-4 py-2.5 text-[13px] font-semibold text-ink transition hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-45 max-sm:px-3.5 max-sm:py-2.5" data-ruler-preset="inch">Show inches</button>
  </div>

  <div class="mt-3 overflow-x-auto rounded-[10px] border border-border-hairline bg-surface p-2.5 max-sm:[scrollbar-width:thin]">
    <svg data-ruler-svg width="760" height="120" role="img" aria-label="On-screen ruler"></svg>
  </div>

  <p class="mt-2 text-[12.5px] leading-relaxed text-muted" data-ruler-meta></p>
  <div class="mt-3 rounded-[10px] border border-dashed border-border-hairline bg-surface-soft px-3.5 py-4 text-[13px] text-muted [&_img]:mx-auto [&_img]:mt-3 [&_img]:block [&_img]:max-h-[220px] [&_img]:max-w-full [&_img]:rounded-md mt-3">
    Calibration card outline (ID-1: 85.60 × 53.98 mm) — screen par apna card iske upar rakho
    <svg class="block max-w-full" data-ruler-card width="324" height="204" viewBox="0 0 85.6 53.98" >
      <rect x="0.5" y="0.5" width="84.6" height="52.98" rx="2.5" fill="none" stroke="var(--hairline)" stroke-width="0.5" stroke-dasharray="2 2"></rect>
    </svg>
  </div>
</div>

<script>
  import { pixelsPerMm, mmToInches, CARD_MM } from '../../lib/tools/core.mjs';

  /** active preset button ke Tailwind tokens */
  const PRIMARY = [
    'border-transparent',
    'bg-[linear-gradient(180deg,var(--accent-start),var(--accent-end))]',
    'text-white',
  ];


  const root = document.querySelector('[data-tool-root="online-ruler"]');
  if (root) {
    const cal = root.querySelector('[data-ruler-cal]');
    const label = root.querySelector('[data-ruler-label]');
    const svg = root.querySelector('[data-ruler-svg]');
    const card = root.querySelector('[data-ruler-card]');
    const meta = root.querySelector('[data-ruler-meta]');
    let unit = 'cm';

    const draw = () => {
      const cardPixels = Number(cal.value);
      label.textContent = cardPixels;
      const perMm = pixelsPerMm(cardPixels);
      const pxPerUnit = unit === 'cm' ? perMm * 10 : perMm * 25.4;
      const width = 760;
      const height = 120;
      const baseline = 92;
      const maxUnits = Math.floor((width - 24) / pxPerUnit);
      const parts = [];

      parts.push(`<rect x="0" y="0" width="${width}" height="${height}" fill="#ffffff"></rect>`);
      for (let i = 0; i <= maxUnits; i++) {
        const x = 12 + i * pxPerUnit;
        parts.push(`<line x1="${x}" y1="${baseline}" x2="${x}" y2="${baseline - 34}" stroke="var(--ink)" stroke-width="1.2"></line>`);
        parts.push(`<text x="${x}" y="${baseline + 18}" font-size="12" fill="var(--ink)" text-anchor="middle">${i}</text>`);
        if (i < maxUnits) {
          for (let s = 1; s < 10; s++) {
            const sx = x + (s * pxPerUnit) / 10;
            const len = s === 5 ? 20 : 12;
            parts.push(`<line x1="${sx}" y1="${baseline}" x2="${sx}" y2="${baseline - len}" stroke="var(--muted)" stroke-width="0.8"></line>`);
          }
        }
      }
      parts.push(`<line x1="12" y1="${baseline}" x2="${12 + maxUnits * pxPerUnit}" y2="${baseline}" stroke="var(--ink)" stroke-width="1.4"></line>`);
      parts.push(`<text x="12" y="22" font-size="12" fill="var(--muted)">${unit === 'cm' ? 'centimetres' : 'inches'}</text>`);
      svg.innerHTML = parts.join('');
      svg.setAttribute('height', String(height));

      card.setAttribute('width', String(cardPixels));
      card.setAttribute('height', String(Math.round(cardPixels * (CARD_MM.h / CARD_MM.w))));

      const inchWidth = Math.round(cardPixels / 25.4 * 10) / 10;
      meta.textContent = `1 cm = ${(perMm * 10).toFixed(1)} px · 1 inch = ${(perMm * 25.4).toFixed(1)} px · card 85.6 mm = ${mmToInches(85.6)} in = ${inchWidth} in on screen`;
    };

    cal.addEventListener('input', draw);
    root.querySelectorAll('[data-ruler-preset]').forEach((button) => {
      button.addEventListener('click', () => {
        unit = button.dataset.rulerPreset;
        root.querySelectorAll('[data-ruler-preset]').forEach((other) => PRIMARY.forEach((token) => other.classList.toggle(token, other === button)));
        draw();
      });
    });
    draw();
  }
</script>

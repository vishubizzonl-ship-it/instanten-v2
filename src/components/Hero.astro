---
interface Props {
  toolCount: number;
  categoryCount: number;
}

const { toolCount, categoryCount } = Astro.props;
---
<section aria-labelledby="hero-title">
  <div class="site-container flex flex-col items-center pt-8 pb-10 text-center md:pt-16 md:pb-16">
    <h1
      id="hero-title"
      class="max-w-[920px] font-display font-bold leading-[62px] tracking-[-0.03em] text-[52px] text-ink"
    >
      Useful SaaS tools, ready in an instant.
    </h1>

    <p class="mt-10 max-w-[640px] text-[18px] leading-[28px] text-body">
      A curated directory of genuinely useful SaaS tools for developers, designers, writers, and builders. No fluff. No dead links.
    </p>

    <div class="mt-10 flex items-center justify-center gap-4 md:mt-16">
      <div class="hero-rule" aria-hidden="true"></div>
    </div>
  </div>
</section>
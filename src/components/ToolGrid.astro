---
import ToolCard from './ToolCard.astro';
import { buildSearchText, type ToolData } from '../utils/filters';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { localizeTool } from '../i18n/toolContent';
import { toolSearchAliases } from '../i18n/searchAliases';

interface Props {
  tools: ToolData[];
  visibleStart?: number;
  visibleEnd?: number;
}

const { tools, visibleStart = 0, visibleEnd = tools.length } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/**
 * Search index ek hi jagah se banta hai: us bhasha ka naam + description +
 * tags + us bhasha ke synonyms (searchAliases.ts) + English text.
 * Pehle sirf English text hota tha, isliye /ja/search/ par "速度" ya "方位磁針"
 * se kuch nahi milta tha — jabki home ke grid par milta tha.
 */
const searchIndex = (tool: ToolData) => {
  const localized = localizeTool(lang, { slug: tool.slug, name: tool.name, description: tool.description });
  return [
    localized.name,
    localized.description,
    tool.category,
    ...(tool.tags ?? []),
    toolSearchAliases(tool.slug, lang),
    buildSearchText(tool),
  ]
    .filter(Boolean)
    .join(' ');
};
---
<section aria-labelledby="tools-heading" id="tools">
  <h2 id="tools-heading" class="sr-only">{t('tools.allTools')}</h2>
  <!--
    1 → 2 → 3 columns. Pehle yahan inline `style` mein @media daala gaya tha —
    style attribute mein at-rule valid nahi hota, browser baaki declarations
    drop kar deta hai, isliye desktop par bhi sirf 1 column bachta tha.
    Ab Tailwind utilities (Rule 7): mobile 1, tablet 2, desktop 3.
  -->
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6 xl:gap-7" data-directory-grid>
    {tools.map((tool, index) => (
      <ToolCard
        slug={tool.slug}
        name={tool.name}
        category={tool.category}
        description={tool.description}
        pricing={tool.pricing}
        image={tool.image}
        
        tags={tool.tags}
        maker={tool.maker}
        addedDate={tool.addedDate}
        updatedDate={tool.updatedDate}
        featured={tool.featured}
        hidden={index < visibleStart || index >= visibleEnd}
        searchText={searchIndex(tool)}
      />
    ))}
  </div>
</section>
---
import ToolCard from './ToolCard.astro';
import { buildSearchText, type ToolData } from '../utils/filters';

interface Props {
  tools: ToolData[];
  visibleStart?: number;
  visibleEnd?: number;
}

const { tools, visibleStart = 0, visibleEnd = tools.length } = Astro.props;
---
<section aria-labelledby="tools-heading" id="tools">
  <h2 id="tools-heading" class="sr-only">Tools</h2>
  <div
    class="grid gap-6"
    data-directory-grid
    style="
      grid-template-columns: repeat(1, minmax(0, 1fr));
      @media (min-width: 768px) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      @media (min-width: 1024px) {
        grid-template-columns: repeat(3, minmax(0, 400px));
      }
    "
  >
    {tools.map((tool, index) => (
      <ToolCard
        slug={tool.slug}
        name={tool.name}
        category={tool.category}
        description={tool.description}
        pricing={tool.pricing}
        image={tool.image}
        url={tool.url}
        tags={tool.tags}
        maker={tool.maker}
        addedDate={tool.addedDate}
        updatedDate={tool.updatedDate}
        featured={tool.featured}
        hidden={index < visibleStart || index >= visibleEnd}
        searchText={buildSearchText(tool)}
      />
    ))}
  </div>
</section>
---
---
<button
  type="button"
  data-theme-toggle
  class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border-hairline bg-surface text-body transition-colors hover:border-faint hover:text-ink"
  aria-label="Switch to dark theme"
  aria-pressed="false"
  title="Toggle theme (Ctrl+Shift+L)"
>
  <svg data-theme-icon="light" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="10" cy="10" r="3.7"></circle>
    <path d="M10 2v2.2M10 15.8V18M2 10h2.2M15.8 10H18M4.4 4.4l1.5 1.5M14.1 14.1l1.5 1.5M4.4 15.6l1.5-1.5M14.1 5.9l1.5-1.5"></path>
  </svg>
  <svg data-theme-icon="dark" class="hidden" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M17.4 12.5A7.4 7.4 0 0 1 7.5 2.6 7.4 7.4 0 1 0 17.4 12.5Z"></path>
  </svg>
</button>

<script>
  const toggle = document.querySelector<HTMLElement>('[data-theme-toggle]');
  const lightIcon = toggle?.querySelector<HTMLElement>('[data-theme-icon="light"]');
  const darkIcon = toggle?.querySelector<HTMLElement>('[data-theme-icon="dark"]');
  const root = document.documentElement;

  function syncThemeUI(): void {
    const isDark = root.classList.contains('dark');
    if (toggle) {
      toggle.setAttribute('aria-pressed', String(isDark));
      toggle.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
    }
    lightIcon?.classList.toggle('hidden', isDark);
    darkIcon?.classList.toggle('hidden', !isDark);
    root.style.colorScheme = isDark ? 'dark' : 'light';
  }

  function setTheme(theme: 'light' | 'dark'): void {
    root.classList.toggle('dark', theme === 'dark');
    try {
      localStorage.setItem('theme', theme);
    } catch (_) {}
    syncThemeUI();
  }

  syncThemeUI();

  toggle?.addEventListener('click', () => {
    setTheme(root.classList.contains('dark') ? 'light' : 'dark');
  });

  document.addEventListener('keydown', (event) => {
    if (event.ctrlKey && event.shiftKey && event.key.toLowerCase() === 'l') {
      event.preventDefault();
      toggle?.click();
    }
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    try {
      if (!localStorage.getItem('theme')) {
        root.classList.toggle('dark', event.matches);
        syncThemeUI();
      }
    } catch (_) {}
  });

  window.addEventListener('storage', (event) => {
    if (event.key === 'theme') {
      root.classList.toggle('dark', event.newValue === 'dark');
      syncThemeUI();
    }
  });
</script>

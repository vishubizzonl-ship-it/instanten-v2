---
import { getLangFromUrl, useTranslations, translatePathSafe, formatLocalizedDate } from '../i18n/utils';
import { localizeTool, localizeToolCategory, localizePricing } from '../i18n/toolContent';

interface Props {
  slug: string;
  name: string;
  category: string;
  description: string;
  pricing: 'Free' | 'Freemium' | 'Paid';
  image: string;
  tags?: string[];
  maker?: string;
  addedDate?: string;
  updatedDate?: string;
  featured?: boolean;
  hidden?: boolean;
  searchText?: string;
}

const {
  slug,
  name,
  category,
  description,
  pricing,
  image,
  tags = [],
  maker,
  addedDate,
  updatedDate,
  featured = false,
  hidden = false,
  searchText = '',
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localized = localizeTool(lang, { slug, name, description });
const categoryLabel = localizeToolCategory(lang, category);
const pricingLabel = localizePricing(lang, pricing);

const pricingClasses = {
  Free: 'bg-success-soft text-success',
  Freemium: 'bg-warning-soft text-warning',
  Paid: 'bg-violet-soft text-violet',
} as const satisfies Record<'Free' | 'Freemium' | 'Paid', string>;

const displayDate = updatedDate || addedDate;
const formattedDate = displayDate ? formatLocalizedDate(displayDate, lang) : '';
const toolHref = translatePathSafe(`/tools/${slug}/`, lang);
const makerHref = maker
  ? translatePathSafe(`/maker/${maker.toLowerCase().replace(/\s+/g, '-')}/`, lang)
  : '';
---
<article
  data-tool-card
  data-slug={slug}
  data-name={localized.name}
  data-category={category}
  data-pricing={pricing}
  data-tags={tags.join(',')}
  data-maker={maker || ''}
  data-added={addedDate || ''}
  data-updated={updatedDate || ''}
  data-featured={featured ? 'true' : 'false'}
  data-search={searchText}
  hidden={hidden}
  class="group flex flex-col"
>
  <a
    href={toolHref}
    class="relative block aspect-video overflow-hidden rounded-[16px] bg-surface-soft"
    aria-label={`${t('aria.viewDetails')} ${localized.name}`}
  >
    <img
      src={image}
      alt={localized.name}
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
      loading="lazy"
      decoding="async"
      width="400"
      height="225"
    />
    <span class="absolute left-5 top-5 rounded-full bg-ink/90 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.08em] text-canvas backdrop-blur-sm">
      {categoryLabel}
    </span>
    <span class="absolute right-5 top-5 opacity-0 transition-opacity duration-200 group-hover:opacity-100">
      <span class={`inline-flex items-center rounded-full px-2 py-0.5 font-medium text-caption ${pricingClasses[pricing]}`}>
        {pricingLabel}
      </span>
    </span>
  </a>

  <div class="mt-5 flex flex-col">
    <div class="flex items-center gap-2 text-[15px] leading-[18px] text-muted">
      {maker && (
        <a
          href={makerHref}
          class="font-medium transition-colors hover:text-ink"
          aria-label={`${t('nav.makers')}: ${maker}`}
        >
          {maker}
        </a>
      )}
      {maker && formattedDate && <span aria-hidden="true">·</span>}
      {formattedDate && <time datetime={displayDate!} class="font-medium">{formattedDate}</time>}
    </div>

    <h2 class="mt-[10px] font-display font-bold text-[21px] leading-[1.2] tracking-[-0.04em] text-ink">
      <a href={toolHref} class="transition-colors hover:text-accent-deep">{localized.name}</a>
    </h2>

    <p class="mt-1.5 line-clamp-3 text-[16px] leading-[1.55] font-normal text-muted">{localized.description}</p>
  </div>
</article>

---
/**
 * Prose renderer for the sensor tool pages.
 *
 * compassinstant ki copy mein **bold** markdown bhi hai aur `<strong>`/`<em>`
 * tags bhi (donon shakal source mein maujood hain). Pehle sirf markdown handle
 * hota tha, isliye tags page par literal text ban ke dikh rahe the.
 *
 * Yahan sirf teen inline tags allowed hain — strong, b, em, i. Baaki sab escape
 * hota hai, isliye copy se koi script/markup ghus nahi sakta.
 */
interface Props {
  text: string;
}

const { text } = Astro.props;

const escapeHtml = (value: string) =>
  value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');

const ALLOWED = new Set(['strong', 'b', 'em', 'i']);

const html = text
  // 1. **bold** → <strong>
  .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
  // 2. sab escape
  .split(/(<[^>]+>)/g)
  .map((part) => {
    const tag = part.match(/^<(\/?)([a-z]+)>$/i);
    if (tag && ALLOWED.has(tag[2].toLowerCase())) {
      const name = tag[2].toLowerCase();
      if (tag[1]) return `</${name}>`;
      return name === 'em' || name === 'i'
        ? `<em class="italic">`
        : `<strong class="font-semibold text-ink">`;
    }
    return escapeHtml(part);
  })
  .join('');
---

<p class="mb-4 text-body-md leading-relaxed text-body" set:html={html} />

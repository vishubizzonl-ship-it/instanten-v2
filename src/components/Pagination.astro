---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
  queryParams?: Record<string, string>;
}

const { currentPage, totalPages, baseUrl, queryParams = {} } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));

const buildUrl = (page: number) => {
  const params = new URLSearchParams(queryParams);
  if (page > 1) params.set('page', String(page));
  else params.delete('page');
  const qs = params.toString();
  return `${baseUrl}${qs ? `?${qs}` : ''}`;
};
---
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@700;800&display=swap');

  .cf-pager {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    width: 100% !important;
    margin: 72px auto !important;
    padding: 16px 0 !important;
  }

  .cf-pager__inner {
    display: inline-flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
  }

  .cf-pager__item {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 42px !important;
    min-width: 42px !important;
    height: 42px !important;
    min-height: 42px !important;
    padding: 0 !important;
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    font-family: "DM Sans", sans-serif !important;
    font-size: 16px !important;
    font-weight: 800 !important;
    line-height: 1 !important;
    letter-spacing: -0.02em !important;
    color: #29294B !important;
    text-decoration: none !important;
    cursor: pointer !important;
    transition: color 0.25s ease !important;
    user-select: none !important;
  }

  .cf-pager__item:hover {
    color: #828282 !important;
  }

  /* Active White Floating Squircle Card [ 1 ] with Soft Lavender-Blue Halo Glow */
  .cf-pager__item.is-active {
    background-color: #FFFFFF !important;
    color: #29294B !important;
    border-radius: 10px !important;
    margin: 0 8px !important;
    box-shadow: 0px 6px 24px 2px rgba(114, 114, 255, 0.22), 0px 2px 6px 0px rgba(41, 41, 75, 0.04) !important;
    cursor: default !important;
    pointer-events: none !important;
  }

  /* Dark Mode Support */
  .dark .cf-pager__item,
  [data-theme="dark"] .cf-pager__item,
  [data-scheme="dark"] .cf-pager__item {
    color: #FFFFFF !important;
  }

  .dark .cf-pager__item:hover,
  [data-theme="dark"] .cf-pager__item:hover,
  [data-scheme="dark"] .cf-pager__item:hover {
    color: #CDCDCD !important;
  }

  .dark .cf-pager__item.is-active,
  [data-theme="dark"] .cf-pager__item.is-active,
  [data-scheme="dark"] .cf-pager__item.is-active {
    background-color: #222222 !important;
    color: #FFFFFF !important;
    outline: 1px solid #2E2E2E !important;
    box-shadow: none !important;
  }
</style>
<nav class="cf-pager" aria-label={t('aria.pagination')} role="navigation" data-base-url={baseUrl}>
  {currentPage > 1 && (
    <a href={buildUrl(currentPage - 1)} class="cf-pager__item" aria-label={t('aria.previousPage')}>
      <svg class="cf-pager__arrow" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5l-5 5 5 5"/></svg>
    </a>
  )}

  {currentPage > 2 && (
    <span class="cf-pager__ellipsis" aria-hidden="true">…</span>
  )}

  <a href={buildUrl(1)} class="cf-pager__item" aria-label={`${t('aria.page')} 1`}>
    1
  </a>

  {currentPage > 2 && currentPage < totalPages - 1 && (
    <span class="cf-pager__ellipsis" aria-hidden="true">…</span>
  )}

  {currentPage >= 2 && currentPage <= totalPages - 1 && (
    <span class="cf-pager__item is-active" aria-current="page">
      {currentPage}
    </span>
  )}

  {currentPage < totalPages - 1 && (
    <span class="cf-pager__ellipsis" aria-hidden="true">…</span>
  )}

  {totalPages > 1 && (
    <a href={buildUrl(totalPages)} class="cf-pager__item" aria-label={`${t('aria.page')} ${totalPages}`}>
      {totalPages}
    </a>
  )}

  {currentPage < totalPages && (
    <a href={buildUrl(currentPage + 1)} class="cf-pager__item" aria-label={t('aria.nextPage')}>
      <svg class="cf-pager__arrow" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 5l5 5-5 5"/></svg>
    </a>
  )}
</nav>
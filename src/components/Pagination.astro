---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
  queryParams?: Record<string, string>;
}

const { currentPage, totalPages, baseUrl, queryParams = {} } = Astro.props;

const showFirst = currentPage > 3;
const showLast = currentPage < totalPages - 2;
const startPage = Math.max(1, currentPage - 2);
const endPage = Math.min(totalPages, currentPage + 2);

const buildUrl = (page: number) => {
  const params = new URLSearchParams(queryParams);
  if (page > 1) params.set('page', String(page));
  else params.delete('page');
  const qs = params.toString();
  return `${baseUrl}${qs ? `?${qs}` : ''}`;
};

const pageBtnClasses = 'inline-flex h-10 w-10 items-center justify-center rounded-[8px] bg-surface text-body-sm font-medium text-ink shadow-[0_2px_8px_-4px_rgba(0,0,0,0.08),0_1px_2px_-1px_rgba(0,0,0,0.04)] transition-all duration-150 hover:bg-hairline-soft hover:shadow-[0_4px_12px_-4px_rgba(0,0,0,0.12),0_2px_4px_-2px_rgba(0,0,0,0.08)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2';
const activeBtnClasses = 'inline-flex h-10 w-10 items-center justify-center rounded-[8px] bg-ink text-canvas text-body-sm font-medium shadow-[0_2px_8px_-4px_rgba(0,0,0,0.12),0_1px_2px_-1px_rgba(0,0,0,0.08)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2';
const navBtnClasses = 'inline-flex h-10 w-10 items-center justify-center rounded-[8px] border border-border-hairline bg-surface text-body transition-all duration-150 hover:border-faint hover:bg-hairline-soft hover:shadow-[0_4px_12px_-4px_rgba(0,0,0,0.08),0_2px_4px_-2px_rgba(0,0,0,0.04)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2';
---
<nav class="pagination site-container flex items-center justify-center gap-2 py-10" aria-label="Pagination" role="navigation" data-base-url={baseUrl}>
  {currentPage > 1 && (
    <a href={buildUrl(currentPage - 1)} class={navBtnClasses} aria-label="Previous page">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5l-5 5 5 5"/></svg>
    </a>
  )}

  {showFirst && (
    <a href={buildUrl(1)} class={pageBtnClasses} aria-label="Page 1">1</a>
  )}

  {showFirst && currentPage > 4 && (
    <span class="h-10 flex items-center px-3 text-muted" aria-hidden="true">…</span>
  )}

  {Array.from({ length: endPage - startPage + 1 }, (_, i) => startPage + i).map(page => (
    <a
      href={buildUrl(page)}
      class={page === currentPage ? activeBtnClasses : pageBtnClasses}
      aria-label={`Page ${page}`}
      aria-current={page === currentPage ? 'page' : undefined}
    >
      {page}
    </a>
  ))}

  {showLast && currentPage < totalPages - 3 && (
    <span class="h-10 flex items-center px-3 text-muted" aria-hidden="true">…</span>
  )}

  {showLast && (
    <a href={buildUrl(totalPages)} class={pageBtnClasses} aria-label={`Page ${totalPages}`}>{totalPages}</a>
  )}

  {currentPage < totalPages && (
    <a href={buildUrl(currentPage + 1)} class={navBtnClasses} aria-label="Next page">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 5l5 5-5 5"/></svg>
    </a>
  )}
</nav>
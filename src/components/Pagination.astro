---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
  queryParams?: Record<string, string>;
}

const { currentPage, totalPages, baseUrl, queryParams = {} } = Astro.props;

const showFirst = currentPage > 3;
const showLast = currentPage < totalPages - 2;
const startPage = Math.max(1, currentPage - 2);
const endPage = Math.min(totalPages, currentPage + 2);

const buildUrl = (page: number) => {
  const params = new URLSearchParams(queryParams);
  if (page > 1) params.set('page', String(page));
  else params.delete('page');
  const qs = params.toString();
  return `${baseUrl}${qs ? `?${qs}` : ''}`;
};

const pageBtnClasses = 'inline-flex h-10 min-w-[40px] items-center justify-center rounded-lg bg-surface text-body font-semibold text-ink shadow-[0_5px_20px_0_rgba(114,114,255,0.15)] transition-all duration-150 hover:bg-hairline-soft hover:shadow-[0_8px_24px_0_rgba(114,114,255,0.2)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 mx-1.5';
const activeBtnClasses = 'inline-flex h-10 min-w-[40px] items-center justify-center rounded-lg bg-surface text-body font-semibold text-ink shadow-[0_5px_20px_0_rgba(114,114,255,0.15)] transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 mx-1.5 dark:outline dark:outline-border-hairline';
const navBtnClasses = 'inline-flex h-10 min-w-[40px] items-center justify-center rounded-lg bg-surface text-body font-semibold text-ink shadow-[0_5px_20px_0_rgba(114,114,255,0.15)] transition-all duration-150 hover:bg-hairline-soft hover:shadow-[0_8px_24px_0_rgba(114,114,255,0.2)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 mx-1.5';
---
<nav class="pagination site-container flex items-center justify-center py-10" aria-label="Pagination" role="navigation" data-base-url={baseUrl}>
  {currentPage > 1 && (
    <a href={buildUrl(currentPage - 1)} class={navBtnClasses} aria-label="Previous page">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5l-5 5 5 5"/></svg>
    </a>
  )}

  {showFirst && (
    <a href={buildUrl(1)} class={pageBtnClasses} aria-label="Page 1">1</a>
  )}

  {showFirst && currentPage > 4 && (
    <span class="h-10 min-w-[40px] flex items-center justify-center text-muted" aria-hidden="true">…</span>
  )}

  {Array.from({ length: endPage - startPage + 1 }, (_, i) => startPage + i).map(page => (
    <a
      href={buildUrl(page)}
      class={page === currentPage ? activeBtnClasses : pageBtnClasses}
      aria-label={`Page ${page}`}
      aria-current={page === currentPage ? 'page' : undefined}
    >
      {page}
    </a>
  ))}

  {showLast && currentPage < totalPages - 3 && (
    <span class="h-10 min-w-[40px] flex items-center justify-center text-muted" aria-hidden="true">…</span>
  )}

  {showLast && (
    <a href={buildUrl(totalPages)} class={pageBtnClasses} aria-label={`Page ${totalPages}`}>{totalPages}</a>
  )}

  {currentPage < totalPages && (
    <a href={buildUrl(currentPage + 1)} class={navBtnClasses} aria-label="Next page">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 5l5 5-5 5"/></svg>
    </a>
  )}
</nav>
---
/**
 * Shared error page (403 / 404 / 500 / 503).
 *
 * SEO rules baked in (instanten.com):
 *  - always `noindex, nofollow` — error pages must never enter an index
 *  - no hreflang cluster (an "alternate" pointing at an error is worse than none)
 *  - self-referencing canonical to the error URL itself
 *  - never listed in sitemap.xml (see astro.config.mjs filter + sitemapXml.ts)
 *  - carries no indexable content: one h1, one short paragraph, recovery links
 *
 * Styling: sirf Tailwind utilities + compilefuture tokens (Rule 7). Koi
 * `<style>` block nahi, koi hard-coded rang nahi — page ka look baaki site se
 * wahi rehta hai, aur 500/503 par bhi koi external asset load nahi hota.
 */
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { toolPath } from '../utils/toolPaths';
import { localizeTool } from '../i18n/toolContent';
import { instrumentToolCopy } from '../i18n/instruments/toolCopy';
import { INSTRUMENT_SLUGS } from '../utils/toolPaths';

interface Props {
  /** HTTP status shown big: 403, 404, 500, 503 */
  code: 403 | 404 | 500 | 503;
  heading: string;
  message: string;
  /** Optional "what you can do" bullets, kept to 3 for a calm page. */
  tips?: string[];
  /** Show three popular tools as an exit route (off by default). */
  showPopularTools?: boolean;
  /** Show a "try again" button (used by 500 and 503). */
  retry?: boolean;
}

const { code, heading, message, tips = [], showPopularTools = false, retry = false } = Astro.props;

const allTools = await getCollection('tools');
// Error pages English-only hain (rule: koi locale-wise error page nahi), to
// labels bhi English.
const featuredTools = showPopularTools ? allTools.filter((t) => t.data.featured).slice(0, 3) : [];
const sensorTools = INSTRUMENT_SLUGS.map((slug) => ({
  slug,
  name: instrumentToolCopy.en[slug]?.name ?? slug,
  href: toolPath(slug),
}));

const breadcrumbs = [{ label: 'Home', href: '/' }, { label: String(code) }];

// Search-result friendly, non-indexable descriptions.
const titles: Record<number, string> = {
  403: `403 — Access Denied | instanten`,
  404: `404 — Page Not Found | instanten`,
  500: `500 — Something Went Wrong | instanten`,
  503: `503 — Temporarily Unavailable | instanten`,
};
const descriptions: Record<number, string> = {
  403: 'Access to this page is denied. Return to the homepage or browse the free instant tools hub.',
  404: 'Page not found. Return to the homepage to discover free instant tools and guides.',
  500: 'Something went wrong on our side. Please reload the page or return to the homepage.',
  503: 'The tool is temporarily unavailable for maintenance. Please try again in a moment.',
};
const pageTitle = titles[code];
const pageDescription = descriptions[code];

const secondaryBtn =
  'inline-flex w-full items-center justify-center gap-2 rounded-[8px] border border-border-hairline bg-surface px-8 py-3 font-body text-sm font-medium text-ink transition-colors hover:bg-canvas focus:outline-none focus:ring-2 focus:ring-accent-start focus:ring-offset-2 sm:w-auto';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={`https://instanten.com/${code}.html`}
  noindex
>
  <Breadcrumbs items={breadcrumbs} />
  <div class="flex min-h-[70vh] items-center justify-center px-gutter py-10">
    <div class="w-full max-w-md text-center">
      <p class="mb-3 font-display text-[5rem] font-semibold leading-none text-muted/20 sm:text-[7rem]" aria-hidden="true">
        {code}
      </p>
      <h1 class="mb-4 font-display text-[2rem] font-semibold leading-[1.1] tracking-[-1px] text-ink sm:text-[3rem] sm:tracking-[-2px]">
        {heading}
      </h1>
      <p class="mb-8 font-body text-base leading-relaxed text-muted">{message}</p>

      {
        tips.length > 0 && (
          <ul class="mx-auto mb-10 max-w-sm space-y-2 text-left font-body text-sm text-muted" role="list">
            {tips.map((tip) => (
              <li class="flex items-start gap-2">
                <span aria-hidden="true" class="mt-0.5 text-accent">•</span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        )
      }

      <div class="mb-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a
          href="/"
          class="btn-primary inline-flex w-full items-center justify-center gap-2 rounded-[8px] px-8 py-3 font-body text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-accent-start focus:ring-offset-2 sm:w-auto"
        >
          Back to Homepage
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M13 4.5H5M8 9.5l4 4-4 4" />
          </svg>
        </a>
        <a href="/" class={secondaryBtn}>Browse All Tools</a>
        <a href="/search/" class={secondaryBtn}>Search Tools</a>
        {
          retry && (
            <button type="button" onclick="location.reload()" class={secondaryBtn}>
              Try Again
            </button>
          )
        }
      </div>

      {/* Chaar sensor tools — site ke sabse seedhe raaste, error par ek tap. */}
      <section class="mb-10" aria-label="Popular sensor tools">
        <h2 class="mb-3 font-display text-sm font-semibold uppercase tracking-wide text-muted">Open a tool directly</h2>
        <ul class="grid grid-cols-2 gap-2 sm:grid-cols-4">
          {
            sensorTools.map((tool) => (
              <li>
                <a
                  href={tool.href}
                  class="block rounded-[8px] border border-border-hairline bg-surface px-3 py-2 text-center font-body text-sm font-medium text-ink transition-colors hover:border-accent/40 hover:text-accent"
                >
                  {tool.name}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      {
        featuredTools.length > 0 && (
          <section class="mb-10" aria-labelledby="popular-tools">
            <h2 id="popular-tools" class="mb-4 font-display text-sm font-semibold uppercase tracking-wide text-muted">
              Popular tools
            </h2>
            <div class="grid gap-3 text-left sm:grid-cols-2">
              {featuredTools.map((tool) => (
                <a
                  href={toolPath(tool.data.slug)}
                  class="block rounded-[8px] border border-border-hairline bg-surface p-4 transition-colors hover:border-accent/40 hover:shadow-sm"
                >
                  <h3 class="mb-1 font-display text-sm font-semibold text-ink">{localizeTool('en', tool.data).name}</h3>
                  <p class="font-body text-xs leading-relaxed text-muted">{tool.data.description}</p>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <p class="font-body text-xs text-muted">
        Still stuck? <a href="/contact/" class="text-accent hover:underline">Contact us</a>
      </p>
    </div>
  </div>
</Layout>

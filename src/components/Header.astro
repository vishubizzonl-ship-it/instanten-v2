---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
---
<header class="w-full bg-canvas">
  <div data-mobile-bar class="site-container flex h-[64px] items-center gap-4 lg:hidden">
    <div class="flex items-center justify-start min-w-0 flex-1">
      <button
        type="button"
        data-menu-open
        class="cs-menu-toggle inline-flex h-10 w-10 items-center justify-center rounded-md bg-transparent text-body transition-colors hover:text-ink hover:bg-hairline-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
        aria-label="Open menu"
        aria-controls="mobile-drawer"
        aria-expanded="false"
      >
        <svg class="cs-hamburger-icon h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
    <Logo class="flex-1 lg:flex-none flex items-center justify-center lg:justify-start min-w-0 max-w-[200px] text-ink font-display font-bold text-xl tracking-tight whitespace-nowrap overflow-hidden text-ellipsis" />
    <div class="flex items-center justify-end min-w-0 flex-1">
      <button
        type="button"
        data-search-open
        class="inline-flex h-10 w-10 items-center justify-center rounded-md bg-transparent text-body transition-colors hover:text-ink"
        aria-haspopup="dialog"
        aria-controls="search-panel"
        aria-expanded="false"
        aria-label="Search tools"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="9" r="6.2"></circle>
          <path d="m13.6 13.6 3.2 3.2"></path>
        </svg>
      </button>
    </div>
  </div>

  <div data-desktop-bar class="site-container hidden h-[80px] items-center gap-4 lg:flex">
    <Logo class="flex-none" />
    <div class="hidden items-center gap-2 lg:flex" aria-label="Header actions">
      <button
        type="button"
        data-search-open
        class="inline-flex h-10 w-10 items-center justify-center rounded-md bg-transparent text-body transition-colors hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
        aria-haspopup="dialog"
        aria-controls="search-panel"
        aria-expanded="false"
        aria-label="Search tools"
        title="Search tools (⌘K)"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="9" r="6.2"></circle>
          <path d="m13.6 13.6 3.2 3.2"></path>
        </svg>
      </button>
      <ThemeToggle showLeftDivider={true} />
      <a
        href="/submit/"
        class="inline-flex h-10 min-w-[140px] items-center justify-center rounded-[8px] bg-ink text-canvas text-body-sm font-medium transition-opacity hover:opacity-86 whitespace-nowrap"
        aria-label="Submit a tool"
      >
        Submit a Tool
      </a>
    </div>
  </div>
</header>

---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---
<header class="w-full bg-canvas">
  <div data-mobile-bar class="site-container relative flex h-[64px] items-center justify-between lg:hidden">
    <div class="flex items-center justify-start z-10 shrink-0">
      <button
        type="button"
        data-menu-open
        class="cs-menu-toggle inline-flex h-10 w-10 items-center justify-center rounded-md bg-transparent text-body transition-colors hover:text-ink hover:bg-hairline-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
        aria-label={t('aria.openMenu')}
        aria-controls="mobile-drawer"
        aria-expanded="false"
      >
        <svg class="cs-hamburger-icon h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
    <div class="header-logo-center absolute inset-0 flex items-center justify-center pointer-events-none">
      <div class="pointer-events-auto flex items-center justify-center">
        <Logo href={translatePath('/')} class="flex items-center justify-center min-w-0 text-ink font-display font-bold text-xl tracking-tight whitespace-nowrap" />
      </div>
    </div>
    <div class="flex items-center justify-end z-10 shrink-0">
      <div class="inline-flex items-center" aria-label={t('aria.languagePicker')}>
        <LanguagePicker placement="header" />
      </div>
    </div>
  </div>

  <div data-desktop-bar class="site-container relative hidden h-[80px] items-center justify-between lg:flex">
    <div class="desktop-left-placeholder flex items-center min-w-[200px] shrink-0">
      <!-- Empty left anchor balances header for true centering of logo -->
    </div>
    <div class="header-logo-center absolute inset-0 flex items-center justify-center pointer-events-none">
      <div class="pointer-events-auto flex items-center justify-center">
        <Logo href={translatePath('/')} class="flex-none" />
      </div>
    </div>
    <div class="flex items-center gap-2 z-10 shrink-0" aria-label={t('aria.headerActions')}>
      <ThemeToggle showLeftDivider={true} />
      <div class="inline-flex" aria-label={t('aria.languagePicker')}>
        <LanguagePicker placement="header" />
      </div>
      <a
        href={translatePath('/submit/')}
        class="inline-flex h-10 min-w-[140px] items-center justify-center rounded-[8px] bg-ink text-canvas text-body-sm font-medium transition-opacity hover:opacity-86 whitespace-nowrap"
        aria-label={t('nav.submit')}
      >
        {t('nav.submit')}
      </a>
    </div>
  </div>
</header>

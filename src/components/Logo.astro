---
/**
 * Site logo — black squircle mark (Montserrat Black Italic "I") + instanten
 * wordmark. Mark `src/config/toolMarks.mjs` se aata hai, wahi file jo chaaron
 * tool silos ke marks chalati hai, isliye poore site ka brand ek jaisa rehta hai.
 *
 * Colour: Layout ka global CSS `[data-site-logo]` par light mode me pure black
 * (#000000) aur dark mode me pure white (#FFFFFF) force karta hai — mark SVG
 * bhi usi ke andar hai, isliye apne aap sahi ho jaata hai.
 */
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { toolMarkSvg } from '../config/toolMarks.mjs';

const { href = '/', showMark = true } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---
<a
  href={href}
  class="cs-logo inline-flex items-center gap-2 site-brand-logo"
  data-site-logo="true"
  aria-label={t('aria.siteLogo')}
>
  {
    showMark && (
      <span class="cs-logo-mark" aria-hidden="true" set:html={toolMarkSvg('instanten')} />
    )
  }
  <span class="cs-logo-text">
    instanten
  </span>
</a>
<style>
  .cs-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
  }

  .cs-logo-mark {
    display: inline-flex;
    width: 26px;
    height: 26px;
    flex: none;
  }

  .cs-logo-mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cs-logo-text {
    font-family: "Montserrat", "Arial Black", sans-serif !important;
    font-weight: 900 !important;
    font-variation-settings: 'wght' 1000;
    font-style: italic !important;
    font-size: 23px !important;
    letter-spacing: -0.025em !important;
    line-height: 1 !important;
    white-space: nowrap !important;
    text-transform: uppercase !important;
    color: #000000 !important;
    -webkit-text-stroke: 0.7px currentColor !important;
    paint-order: stroke fill !important;
    display: inline-flex !important;
    align-items: center !important;
    padding: 0 4px !important;
    max-width: 280px !important;
    height: auto !important;
    overflow: visible !important;
  }

  .dark .cs-logo-text {
    color: #FFFFFF !important;
    -webkit-text-stroke: 0.7px currentColor !important;
  }

  .cs-logo:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (min-width: 992px) {
    .cs-logo-text {
      font-size: 23px !important;
      max-width: 340px !important;
      height: 21px !important;
    }

    .cs-logo-mark {
      width: 30px;
      height: 30px;
    }
  }
</style>

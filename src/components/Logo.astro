---
/**
 * Site logo — opendesignmd.com ke logo jaisa: filled black rounded square
 * (squircle) ke andar white letter, uske saath "instanten" wordmark.
 *
 * Font bhi wahi hai jo opendesignmd.com ka logo use karta hai: **Inter**
 * (Bold 700, tracking -0.03em). Yahan wordmark ek inline SVG path hai, isliye
 * har device/browser par bilkul wahi shape aati hai — koi webfont load nahi,
 * koi fallback font nahi.
 *
 * Mark aur wordmark dono `src/config/toolMarks.mjs` se aate hain, wahi file jo
 * chaaron tool silos ke marks chalati hai — poore site ka brand ek jaisa.
 *
 * Colour: Layout ka global rule `[data-site-logo]` light mode me pure black
 * (#000000) aur dark mode me pure white (#FFFFFF) force karta hai; SVG
 * `currentColor` use karti hai, isliye apne aap sahi ho jaata hai.
 */
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { toolMarkSvg, wordmarkSvg } from '../config/toolMarks.mjs';

const { href = '/', showMark = true } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<a
  href={href}
  class="cs-logo inline-flex items-center gap-2 site-brand-logo"
  data-site-logo="true"
  aria-label={t('aria.siteLogo')}
>
  {
    showMark && (
      <span class="cs-logo-mark" aria-hidden="true" set:html={toolMarkSvg('instanten')} />
    )
  }
  <span class="cs-logo-text" set:html={wordmarkSvg(21)} />
</a>
<style>
  .cs-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
    color: #000000;
  }

  .dark .cs-logo,
  [data-theme='dark'] .cs-logo {
    color: #FFFFFF;
  }

  .cs-logo-mark {
    display: inline-flex;
    width: 26px;
    height: 26px;
    flex: none;
  }

  .cs-logo-mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cs-logo-text {
    display: inline-flex;
    align-items: center;
    flex: none;
    max-width: 320px;
  }

  .cs-logo-text :global(svg) {
    display: block;
    height: 21px;
    width: auto;
  }

  .cs-logo:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (min-width: 992px) {
    .cs-logo-mark {
      width: 30px;
      height: 30px;
    }

    .cs-logo-text :global(svg) {
      height: 23px;
    }
  }
</style>

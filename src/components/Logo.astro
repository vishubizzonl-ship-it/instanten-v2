---
interface Props {
  href?: string;
  size?: 'sm' | 'md';
  class?: string;
}

const { href = '/', size = 'md', class: className = '' } = Astro.props;
const markSize = size === 'sm' ? 26 : 30;
const textSize = size === 'sm' ? 'text-base' : 'text-lg';
---
<a
  href={href}
  class:list={[
    'inline-flex items-center gap-2.5 font-display font-semibold tracking-[-0.035em] text-ink',
    textSize,
    className,
  ]}
  aria-label="instanten home"
>
  <svg
    width={markSize}
    height={markSize}
    viewBox="0 0 28 28"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="shrink-0"
  >
    <rect width="28" height="28" rx="8" fill="currentColor" />
    <rect x="11.75" y="12.9" width="4.5" height="9.3" rx="2.25" fill="var(--canvas)" />
    <rect
      x="11.5"
      y="5.85"
      width="5"
      height="5"
      rx="1.1"
      transform="rotate(45 14 8.35)"
      fill="var(--canvas)"
    />
  </svg>
  <span>instanten</span>
</a>
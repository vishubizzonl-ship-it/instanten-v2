---
/**
 * instanten route ke silo pages ka FAQ block (visible accordion).
 *
 * JSON-LD alag se aata hai: har page yehi questions Layout ke `faqs` prop mein
 * deta hai, jisse SeoHead ek hi FAQPage entity banata hai. Is component mein
 * koi <script> nahi hai — do FAQPage blocks kabhi na banein.
 *
 * Sirf English par render hota hai (localized pages par English leak na ho).
 * Rule 7: styling Tailwind v4 utilities + design tokens.
 */
import type { FaqItem } from './SeoHead.astro';

interface Props {
  heading: string;
  lead?: string;
  faqs: FaqItem[];
  /** data attribute + id prefix, taaki test page pehchaan sake */
  page: string;
}

const { heading, lead, faqs, page } = Astro.props;
const titleId = `faq-${page}-title`;
---

{
  faqs.length > 0 && (
    <section class="mt-12" aria-labelledby={titleId} data-root-faq data-faq-page={page}>
      <h2 id={titleId} class="text-[22px] sm:text-[26px] font-semibold tracking-tight text-ink">
        {heading}
      </h2>
      {lead && <p class="mt-2 max-w-2xl text-[15px] leading-[1.7] text-body">{lead}</p>}

      <div class="mt-5 flex flex-col rounded-2xl border border-border-hairline bg-surface overflow-hidden">
        {faqs.map((item) => (
          <details class="group border-b border-border-hairline last:border-b-0">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-4 text-[15.5px] font-medium text-ink transition-colors hover:bg-surface-soft">
              <span>{item.question}</span>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                class="shrink-0 text-muted transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p class="px-5 pb-5 text-[15px] leading-[1.75] text-body">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )
}

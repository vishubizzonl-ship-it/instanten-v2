---
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();
---
<footer class="border-t border-border-hairline bg-canvas" role="contentinfo">
  <div class="site-container">
    <div class="flex flex-col items-center text-center gap-4 md:flex-row md:items-center md:gap-8 max-w-[460px] mx-auto">
      <Logo class="h-8 w-auto" />

      <div class="flex flex-col md:flex-row items-center gap-2 text-[12px] leading-normal">
        <a href="/blog" class="text-[var(--ink)] hover:text-[var(--accent)] transition-colors">Blog</a>
        <a href="/about" class="text-[var(--ink)] hover:text-[var(--accent)] transition-colors">About</a>
        <a href="/contact" class="text-[var(--ink)] hover:text-[var(--accent)] transition-colors">Contact</a>
        <a href="/privacy" class="text-[var(--ink)] hover:text-[var(--accent)] transition-colors">Privacy Policy</a>
        <a href="/terms" class="text-[var(--ink)] hover:text-[var(--accent)] transition-colors">Terms</a>
      </div>

      <p class="mt-2 text-[12px] leading-normal text-faint antialiased">
        © {currentYear} instanten. All rights reserved.
      </p>
      <p class="mt-1 text-[11px] leading-normal text-faint antialiased">
        Kuch links affiliate links hain. Purchase par hume commission mil sakta hai.
      </p>
    </div>
  </div>
</footer>
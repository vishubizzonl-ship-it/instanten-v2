---
import QuickLinksBar from './QuickLinksBar.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="editorial-hero" data-hero-section aria-labelledby="editorial-hero-title">
  <div class="site-container">
    <QuickLinksBar variant="hero" />
    <h1
      id="editorial-hero-title"
      class="editorial-hero__title"
    >
      {t('editorial.titleBefore')}<span class="editorial-hero__title-gradient">{t('editorial.titleAccent')}</span>{t('editorial.titleAfter')}
    </h1>

    <p class="editorial-hero__subtitle">
      {t('editorial.subtitle')}
    </p>
  </div>
</section>

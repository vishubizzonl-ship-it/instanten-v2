---
interface Props {
  slug: string;
  title: string;
  excerpt: string;
  thumbnail?: string;
  thumbnailAlt?: string;
  categories?: Array<{ name: string; slug: string }>;
  author?: { name: string; slug: string };
  publishedAt: string;
}

const {
  slug,
  title,
  excerpt,
  thumbnail,
  thumbnailAlt,
  categories,
  author,
  publishedAt,
} = Astro.props;

const formatDate = (dateStr: string) => {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
};
---
<article class="blog-card">
  <a href={`/blog/${slug}/`} class="blog-card__thumbnail" aria-label={`Read ${title}`}>
    <img
      src={thumbnail}
      alt={thumbnailAlt}
      loading="lazy"
      decoding="async"
      width="400"
      height="225"
    />
    <div class="blog-card__category-pills">
      {categories?.map((cat) => (
        <a
          href={`/blog/category/${cat.slug}/`}
          class="blog-card__category-pill"
          aria-label={`View all posts in ${cat.name}`}
        >
          {cat.name}
        </a>
      ))}
    </div>
  </a>

  <button class="blog-card__search-btn" data-search-open aria-label="Search articles">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="8" />
      <path d="m21 21-4.3-4.3" />
    </svg>
    <span>Search</span>
  </button>

  <div class="blog-card__body">
    <div class="blog-card__meta">
      <a href={`/author/${author?.slug}/`} class="blog-card__author">
        {author?.name}
      </a>
      <time datetime={publishedAt} class="blog-card__date">
        on {formatDate(publishedAt)}
      </time>
    </div>

    <h2 class="blog-card__title">
      <a href={`/blog/${slug}/`}>{title}</a>
    </h2>

    <div class="blog-card__excerpt">{excerpt}</div>
  </div>
</article>
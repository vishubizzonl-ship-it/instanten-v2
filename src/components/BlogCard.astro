---
import { getLangFromUrl, useTranslations, translatePathSafe, formatLocalizedDate } from '../i18n/utils';
import { localizePost, localizeBlogCategory } from '../i18n/blogContent';

interface Props {
  slug: string;
  title: string;
  excerpt: string;
  thumbnail?: string;
  thumbnailAlt?: string;
  categories?: Array<{ name: string; slug: string }>;
  author?: { name: string; slug: string };
  publishedAt: string;
}

const {
  slug,
  title,
  excerpt,
  thumbnail,
  thumbnailAlt,
  categories,
  author,
  publishedAt,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const localized = localizePost(lang, { slug, title, excerpt });
const postHref = translatePathSafe(`/blog/${slug}/`, lang);
const formattedDate = formatLocalizedDate(publishedAt, lang);
---
<article class="blog-card">
  <a href={postHref} class="blog-card__thumbnail" aria-label={`${t('aria.readPost')} ${localized.title}`}>
    <img
      src={thumbnail}
      alt={thumbnailAlt}
      loading="lazy"
      decoding="async"
      width="400"
      height="225"
    />
    <div class="blog-card__category-pills">
      {categories?.map((cat) => (
        <a
          href={translatePathSafe(`/blog/category/${cat.slug}/`, lang)}
          class="blog-card__category-pill"
          aria-label={`${t('aria.viewPostsIn')} ${localizeBlogCategory(lang, cat.name)}`}
        >
          {localizeBlogCategory(lang, cat.name)}
        </a>
      ))}
    </div>
  </a>

  <button class="blog-card__search-btn" data-search-open aria-label={t('nav.search')}>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="8" />
      <path d="m21 21-4.3-4.3" />
    </svg>
    <span>{t('nav.search')}</span>
  </button>

  <div class="blog-card__body">
    <div class="blog-card__meta">
      <a href={`/author/${author?.slug}/`} class="blog-card__author">
        {author?.name}
      </a>
      <time datetime={publishedAt} class="blog-card__date">
        {t('blog.on')} {formattedDate}
      </time>
    </div>

    <h2 class="blog-card__title">
      <a href={postHref}>{localized.title}</a>
    </h2>

    <div class="blog-card__excerpt">{localized.excerpt}</div>
  </div>
</article>

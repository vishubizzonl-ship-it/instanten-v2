---
import Layout from '../../../layouts/Layout.astro';
import LegalSections from '../../LegalSections.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../../i18n/utils';
import { supportCopy } from '../../../i18n/supportCopy';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const copy = supportCopy[lang] ?? supportCopy.en;
/** Meta tags: page ka apna translated title/description, warna Layout ka
 *  English default title render hota hai (locale leak). */
const pageTitle = `${t('page.privacy.title')} — onlinecompass`;
const pageDesc = copy.privacy.sections[0].paras[0].replace(/\*\*/g, '').slice(0, 155);

---
<Layout
  title={pageTitle}
  description={pageDesc}
  ogImage="/og-image.png"
  ogImageAlt={pageTitle}
  chrome="instrument"
>
  <main class="mx-auto max-w-[48rem] px-6 lg:px-8 py-16 lg:py-24">
    <a href={translatePath('/onlinecompass/')} class="inline-flex items-center gap-1 text-sm text-body hover:text-ink transition-colors mb-8">← {copy.back}</a>
    <h1 class="font-sans text-3xl sm:text-4xl font-semibold tracking-tight text-ink mb-2">{t('page.privacy.title')}</h1>
    <p class="text-xs text-mute font-mono mb-8">{copy.updated}</p>

    <LegalSections
      sections={copy.privacy.sections}
      contactHref={translatePath('/onlinecompass/contact/')}
      contactLabel={copy.contactLink}
      contactCta={copy.about.contactCta}
    />
  </main>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import BackLink from '../BackLink.astro';
import { SITE_NAME, SITE_URL } from '../../config/siteInfo';
import {
  PUBLIC_EMAIL,
  DELIVERY_EMAIL,
  CONTACT_API_PATH,
  WEB3FORMS_ENDPOINT,
  WEB3FORMS_KEY,
  CONTACT_FORM_LIVE,
} from '../../config/contact';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getPageCopy } from '../../i18n/pageContent';
import RootSiloFaq from '../RootSiloFaq.astro';
import { rootSiloFaq } from '../../i18n/pages/faqRootSilo';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const page = getPageCopy(lang);

const pageTitle = lang === 'en'
  ? `Contact Instanten — Support for Our Free Online Tools Hub`
  : `${t('contact.h1')} — ${SITE_NAME}`;
const pageDescription = lang === 'en'
  ? 'Contact Instanten about any instant tool in the hub — tool requests, bug reports and data questions. Real replies, no fake addresses, no ticket robots.'
  : page.contact.description;
const canonicalURL = lang === 'en' ? `${SITE_URL}/contact/` : `${SITE_URL}/${lang}/contact/`;
/** FAQ sirf English par — localized pages par English leak nahi. */
const faqContent = rootSiloFaq['contact'];
const faqs = lang === 'en' ? faqContent.faqs : [];

/** Form messages — ek hi jagah se, dono modes (live + mailto) ke liye. */
const messages = {
  sending: t('contact.sending'),
  sent: t('contact.success'),
  mailto: t('contact.successMailto').replace('{email}', DELIVERY_EMAIL),
  error: t('contact.error'),
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
  keywords={`contact instanten, instanten, instant tool, tools hub, instant work, online tools, online tools hub, multi tool website, multi tools website, instant, free online tools website, online tools free, web tools hub, free online tools hub, online tools list, ${lang}`}
  ogImage="/og-instanten.png"
  ogImageAlt="Contact Instanten — support for the free online tools hub"
  breadcrumbs={[
    { name: 'Home', item: translatePath('/') },
    { name: t('contact.h1'), item: translatePath('/contact/') },
  ]}
  lang={lang}
  faqs={faqs}
>
  <main class="ror-main">
    <div class="ror-container">
      <BackLink />

      <h1 class="ror-h1">{t('contact.h1')}</h1>
      <p class="ror-lead">
        {t('contact.leadBefore')} <a href={`mailto:${PUBLIC_EMAIL}`} class="ror-link">{PUBLIC_EMAIL}</a>{t('contact.leadAfter')}
      </p>

      <form
        id="contact-form"
        class="ror-form"
        novalidate
        data-email={DELIVERY_EMAIL}
        data-api={CONTACT_API_PATH}
        data-endpoint={WEB3FORMS_ENDPOINT}
        data-key={WEB3FORMS_KEY}
        data-live={CONTACT_FORM_LIVE ? 'true' : 'false'}
        data-messages={JSON.stringify(messages)}
        action={`mailto:${DELIVERY_EMAIL}`}
        method="post"
        enctype="text/plain">
        <div class="ror-field">
          <label for="cf-name" class="ror-label">{t('contact.name')}</label>
          <input id="cf-name" name="name" type="text" placeholder={t('contact.placeholderName')} autocomplete="name" required class="ror-input" />
        </div>

        <div class="ror-field">
          <label for="cf-email" class="ror-label">{t('contact.emailLabel')}</label>
          <input id="cf-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required class="ror-input" />
        </div>

        <div class="ror-field">
          <label for="cf-subject" class="ror-label">{t('contact.topic')}</label>
          <select id="cf-subject" name="subject" class="ror-select" required>
            <option value="" disabled selected>{t('contact.selectTopic')}</option>
            <option value="bug">{t('contact.bug')}</option>
            <option value="feature">{t('contact.feature')}</option>
            <option value="standards">{t('contact.standards')}</option>
            <option value="privacy">{t('contact.privacyInquiry')}</option>
            <option value="other">{t('contact.other')}</option>
          </select>
        </div>

        <div class="ror-field">
          <label for="cf-message" class="ror-label">{t('contact.messageLabel')}</label>
          <textarea id="cf-message" name="message" rows="5" placeholder={t('contact.placeholderMessage')} required class="ror-textarea"></textarea>
        </div>

        <input type="text" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

        <div>
          <button type="submit" class="ror-submit-btn" aria-busy="false">{t('contact.submit')}</button>
        </div>

        <div id="cf-success" class="ror-alert-success" role="status" aria-live="polite" hidden></div>
        <div id="cf-error" class="ror-alert-error" role="alert" hidden>{t('contact.error')}</div>
      </form>

      <section class="ror-section ror-section--contact-details" style="margin-top: 48px; padding-top: 24px; border-top: 1px solid #ebebeb;">
        <h2 class="ror-h2" style="font-size: 18px; margin-bottom: 12px;">{t('contact.channelsHeading')}</h2>
        <ul class="ror-ul" style="margin-top: 0;">
          <li><strong>{t('contact.channelWebsite')}</strong> — <a href={translatePath('/contact/')} class="ror-link">{t('contact.channelThisPage')}</a></li>
          <li><strong>{t('contact.channelEmail')}</strong> — <a href={`mailto:${PUBLIC_EMAIL}`} class="ror-link">{PUBLIC_EMAIL}</a> ({t('contact.channelVerifiedEmail')})</li>
          <li><strong>{t('contact.channelSocial')}</strong> — {t('contact.channelSocialText')}</li>
        </ul>
        <p class="ror-p" style="margin-top: 16px; font-size: 14px; color: #888;">
          {t('contact.note')}
        </p>
      </section>
      {lang === 'en' && (
        <RootSiloFaq page="contact" heading={faqContent.heading} lead={faqContent.lead} faqs={faqContent.faqs} />
      )}
    </div>
  </main>

  <script>
    import { wireContactForm } from '../../lib/contactSubmit';

    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (form) {
      const messages = JSON.parse(form.dataset.messages || '{}');
      wireContactForm({
        form,
        statusEl: document.getElementById('cf-success'),
        errorEl: document.getElementById('cf-error'),
        messages: {
          sending: messages.sending || 'Sending…',
          sent: messages.sent || 'Message sent.',
          mailto: messages.mailto || 'Your email app is opening.',
          error: messages.error || 'Please fill in all required fields before submitting.',
        },
      });
    }
  </script>
</Layout>

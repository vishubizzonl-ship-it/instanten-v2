{
  "name": "instanten-v2",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:site": "node tests/run.mjs",
    "test:site:update": "node tests/run.mjs --update-baseline",
    "test:worker": "node --test worker/*.test.mjs",
    "test:functional": "node tests/functional/run.mjs",
    "deploy": "npm run build && npx wrangler@4 pages deploy dist --project-name=instanten",
    "deploy:dry": "npm run build && node scripts/pages-check.mjs",
    "cf:whoami": "npx wrangler@4 whoami",
    "pages:create": "npx wrangler@4 pages project create instanten --production-branch=main",
    "deploy:workers": "npm run build && npx wrangler@4 deploy",
    "deploy:workers:dry": "npm run build && npx wrangler@4 deploy --dry-run",
    "favicons": "node scripts/generateToolFavicons.mjs",
    "prebuild": "node scripts/generateToolFavicons.mjs"
  },
  "dependencies": {
    "astro": "^6.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
